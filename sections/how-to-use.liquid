{%- liquid
  assign title = product.metafields.custom.how_to_use_title.value | default: product.metafields.custom.how_to_use_title
  assign heading = product.metafields.custom.how_to_use_header

  assign media_1 = product.metafields.custom.how_to_use_image_video_1.value | default: product.metafields.custom.how_to_use_image_video_1
  assign media_2 = product.metafields.custom.how_to_use_image_video_2.value | default: product.metafields.custom.how_to_use_image_video_2
  assign media_mobile_1 = product.metafields.custom.how_to_use_image_video_mobile_1.value | default: product.metafields.custom.how_to_use_image_video_mobile_1 | default: media_1

  assign step_1 = product.metafields.custom.how_to_use_step_1.value | default: product.metafields.custom.how_to_use_step_1
  assign step_2 = product.metafields.custom.how_to_use_step_2.value | default: product.metafields.custom.how_to_use_step_2
  assign step_3 = product.metafields.custom.how_to_use_step_3.value | default: product.metafields.custom.how_to_use_step_3
  assign step_4 = product.metafields.custom.how_to_use_step_4.value | default: product.metafields.custom.how_to_use_step_4
  assign step_5 = product.metafields.custom.how_to_use_step_5.value | default: product.metafields.custom.how_to_use_step_5

  assign step_1_lable = product.metafields.custom.how_to_use_step_1_label.value | default: product.metafields.custom.how_to_use_step_1_label
  assign step_2_lable = product.metafields.custom.how_to_use_step_2_label.value | default: product.metafields.custom.how_to_use_step_2_label
  assign step_3_lable = product.metafields.custom.how_to_use_step_3_label.value | default: product.metafields.custom.how_to_use_step_3_label
  assign step_4_lable = product.metafields.custom.how_to_use_step_4_label.value | default: product.metafields.custom.how_to_use_step_4_label
  assign step_5_lable = product.metafields.custom.how_to_use_step_5_label.value | default: product.metafields.custom.how_to_use_step_5_label

  assign has_media_1 = false
  if media_1 != blank
    assign has_media_1 = true
  endif

  assign has_media_2 = false
  if media_2 != blank
    assign has_media_2 = true
  endif

  assign has_steps = false
  if step_1 != blank or step_2 != blank or step_3 != blank or step_4 != blank or step_5 != blank
    assign has_steps = true
  endif

  assign has_card = false
  if has_steps or title != blank or heading != blank
    assign has_card = true
  endif

  assign visible_count = 0
  if has_media_1
    assign visible_count = visible_count | plus: 1
  endif
  if has_media_2
    assign visible_count = visible_count | plus: 1
  endif
  if has_card
    assign visible_count = visible_count | plus: 1
  endif

  assign show_controls = section.settings.show_video_controls
-%}

{%- if has_media_1 or has_media_2 or has_card -%}
<style>
  #shopify-section-{{ section.id }} {
    --how-to-use-bg: {{ section.settings.card_bg_color | default: '#d8e2e6' }};
    --how-to-use-text: {{ section.settings.text_color | default: '#1c2226' }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .how-to-use__wrapper {
    display: flex;
    flex-direction: column;
    gap: 13px;
    width: 100%;
  }

  @media screen and (min-width: 999px) {
    .how-to-use__wrapper {
      display: grid;
      grid-template-columns: auto auto 35.65%;
      gap: 13px;
      align-items: stretch;
      {% if visible_count == 1 %}
        max-width: 540px;
        margin: 0 auto;
      {% elsif visible_count == 2 %}
        max-width: 920px;
        margin: 0 auto;
      {% endif %}
    }
  }
  .container.container-full:has(.how-to-use__wrapper) {
    max-width: 100% !important;
    margin-inline: 60px !important;
}
  .how-to-use__media-col {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 480px;
    border-radius: 0;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .how-to-use__media-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .how-to-use__card-col {
    background-color: var(--how-to-use-bg);
    color: var(--how-to-use-text);
    border-radius: 0;
    padding: 30px 31px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    width: 100%;
    row-gap: 24.27px;
  }

  @media screen and (min-width: 999px) {
    .how-to-use__card-col {
      padding: 60px 72px;
      row-gap: 31px;
    }
  }

  .how-to-use__subtitle {
   color: #000;
text-align: center;
font-family: "Circular Std";
font-size: 13px;
font-style: normal;
font-weight: 450;
line-height: 20px; /* 153.846% */
letter-spacing: 1.17px;
text-transform: uppercase;
margin: 0 !important;
  }

  .how-to-use__heading {
    color: #000;
text-align: center;

/* H1 */
font-family: Canela;
font-size: 36px;
font-style: normal;
font-weight: 100;
line-height: normal;
margin: 0 !important;
  }

  @media screen and (min-width: 999px) {
    .how-to-use__heading {
      font-size: 36px;
    }
  }

  .how-to-use__mobile-media {
    width: 100%;
    max-width: 320px;
    {% comment %} height: 380px; {% endcomment %}
    border-radius: 0;
    overflow: hidden;
    margin: 0 auto;
    display: block;
  }

  @media screen and (min-width: 999px) {
    .how-to-use__mobile-media {
      display: none !important;
    }
  }

  .how-to-use__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 0;
  }

  .how-to-use__arrow {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s ease;
  }

  {% comment %} .how-to-use__arrow:hover {
    opacity: 0.6;
  } {% endcomment %}

  .how-to-use__arrow svg {
    width: 13px;
    height: 13px;
    stroke-width: 1.5;
  }

  .how-to-use__slider-container {
    width: 100%;
    max-width:  238px;
    margin: 0 auto;
    min-height: 76px;
    overflow: hidden;
  }

  .how-to-use__step-item {
    text-align: center;
    outline: none;
  }

  .how-to-use__step-label {
 color: #000;
text-align: center;

/* H6 */
font-family: "Circular Std";
font-size: 13px;
font-style: normal;
font-weight: 450;
line-height: 20px; /* 153.846% */
letter-spacing: 1.17px;
text-transform: uppercase;
margin-bottom: 9px !important;
  }

  .how-to-use__step-content {
  color: #000;
text-align: center;

font-family: CircularXX;
font-size: 14px;
font-style: normal;
font-weight: 400;
line-height: 114%; /* 15.96px */
letter-spacing: 0.14px;
min-height: 80px;
  }

  @media screen and (max-width: 998px) {
    .how-to-use__media-col.desktop-only {
      display: none !important;
    }
     .container.container-full:has(.how-to-use__wrapper){margin: 0 !important;}
     .how-to-use__subtitle{color: #000;
text-align: center;
font-family: "Circular Std";
font-size: 12px;
font-style: normal;
font-weight: 450;
line-height: 15.656px;
letter-spacing: 0.916px;
text-transform: uppercase;}
.how-to-use__heading{
color: #000;
text-align: center;
font-family: Canela;
font-size: 28.182px;
font-style: normal;
font-weight: 100;
line-height: normal;}
.how-to-use__step-label{
color: #000;
text-align: center;
font-family: "Circular Std";
font-size: 12px;
font-style: normal;
font-weight: 450;
line-height: 15.656px; /* 153.846% */
letter-spacing: 0.916px;
text-transform: uppercase;margin-bottom: 7.05px;}
.how-to-use__step-content{
color: #000;
text-align: center;
font-family: CircularXX;
font-size: 12px;
font-style: normal;
font-weight: 400;
