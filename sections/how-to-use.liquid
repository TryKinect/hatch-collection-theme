.how-to-use__slider-container{max-width: 187px;}
 #shopify-section-{{ section.id }} {padding: 0 !important;}
  }
</style>

<div class="container {% unless section.settings.container_size == 'full' %}container--{{ section.settings.container_size }}{% endunless %}{% if section.settings.container_size == 'full' %} container-full{% endif %}">
  <div class="how-to-use__wrapper">
    
    {%- comment -%} Column 1: Desktop Media 1 {%- endcomment -%}
    {%- if has_media_1 -%}
      <div class="how-to-use__media-col desktop-only">
        {%- if media_1.media_type == 'video' or media_1.sources != blank -%}
          {{- media_1 | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: show_controls, class: 'how-to-use__media-el' -}}
        {%- else -%}
          {%- assign m1_url = media_1 | image_url: width: 1000 -%}
          {%- if m1_url contains '.mp4' or m1_url contains '.webm' or m1_url contains '.mov' -%}
            <video {% if show_controls %}controls{% else %}autoplay loop muted playsinline{% endif %} class="how-to-use__media-el" src="{{ m1_url }}"></video>
          {%- else -%}
            {{- media_1 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'how-to-use__media-el' -}}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Column 2: Desktop Media 2 {%- endcomment -%}
    {%- if has_media_2 -%}
      <div class="how-to-use__media-col desktop-only">
        {%- if media_2.media_type == 'video' or media_2.sources != blank -%}
          {{- media_2 | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: show_controls, class: 'how-to-use__media-el' -}}
        {%- else -%}
          {%- assign m2_url = media_2 | image_url: width: 1000 -%}
          {%- if m2_url contains '.mp4' or m2_url contains '.webm' or m2_url contains '.mov' -%}
            <video {% if show_controls %}controls{% else %}autoplay loop muted playsinline{% endif %} class="how-to-use__media-el" src="{{ m2_url }}"></video>
          {%- else -%}
            {{- media_2 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'how-to-use__media-el' -}}
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Column 3: Steps Card Container {%- endcomment -%}
    {%- if has_card -%}
      <div class="how-to-use__card-col">
        {%- if title != blank -%}
          <div class="how-to-use__subtitle">{{ title }}</div>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="how-to-use__heading">{{ heading }}</h2>
        {%- endif -%}

        {%- comment -%} Mobile Inline Media {%- endcomment -%}
        {%- if media_mobile_1 != blank -%}
          <div class="how-to-use__mobile-media">
            {%- if media_mobile_1.media_type == 'video' or media_mobile_1.sources != blank -%}
              {{- media_mobile_1 | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: show_controls, class: 'how-to-use__media-el' -}}
            {%- else -%}
              {%- assign mm_url = media_mobile_1 | image_url: width: 1000 -%}
              {%- if mm_url contains '.mp4' or mm_url contains '.webm' or mm_url contains '.mov' -%}
                <video {% if show_controls %}controls{% else %}autoplay loop muted playsinline{% endif %} class="how-to-use__media-el" src="{{ mm_url }}"></video>
              {%- else -%}
                {{- media_mobile_1 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'how-to-use__media-el' -}}
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} Prev / Next Arrows {%- endcomment -%}
        {%- if has_steps -%}
          <div class="how-to-use__nav">
            <button type="button" class="how-to-use__arrow js-how-to-use-prev-{{ section.id }}" aria-label="Previous step">
              <svg viewBox="0 0 9 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M7.74583 14.0583L9 12.8042L3.225 7.02917L9 1.25417L7.74583 0L0.716667 7.02917L7.74583 14.0583Z" fill="currentColor"/>
              </svg>
            </button>
            <button type="button" class="how-to-use__arrow js-how-to-use-next-{{ section.id }}" aria-label="Next step">
              <svg viewBox="0 0 9 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.25417 14.0583L0 12.8042L5.775 7.02917L0 1.25417L1.25417 0L8.28333 7.02917L1.25417 14.0583Z" fill="currentColor"/>
              </svg>
            </button>
          </div>
        {%- endif -%}

        {%- comment -%} Slick Slider Container {%- endcomment -%}
        {%- if has_steps -%}
          <div class="how-to-use__slider-container">
            <div class="how-to-use__slider js-how-to-use-slider-{{ section.id }}">

              {%- if step_1 != blank -%}
                <div class="how-to-use__step-item">
                  {% if step_1_lable != blank %}
                    <div class="how-to-use__step-label">{{ step_1_lable }}</div>
                  {% endif %}
                  <div class="how-to-use__step-content">{{ step_1 }}</div>
                </div>
              {%- endif -%}

              {%- if step_2 != blank -%}
                <div class="how-to-use__step-item">
                  {% if step_2_lable != blank %}
                    <div class="how-to-use__step-label">{{ step_2_lable }}</div>
                  {% endif %}
                  <div class="how-to-use__step-content">{{ step_2 }}</div>
                </div>
              {%- endif -%}

              {%- if step_3 != blank -%}
                <div class="how-to-use__step-item">
                  {% if step_3_lable != blank %}
                    <div class="how-to-use__step-label">{{ step_3_lable }}</div>
                  {% endif %}
                  <div class="how-to-use__step-content">{{ step_3 }}</div>
                </div>
              {%- endif -%}

              {%- if step_4 != blank -%}
                <div class="how-to-use__step-item">
                  {% if step_4_lable != blank %}
                    <div class="how-to-use__step-label">{{ step_4_lable }}</div>
                  {% endif %}
                  <div class="how-to-use__step-content">{{ step_4 }}</div>
                </div>
              {%- endif -%}

              {%- if step_5 != blank -%}
                <div class="how-to-use__step-item">
                  {% if step_5_lable != blank %}
                  <div class="how-to-use__step-label">{{ step_5_lable }}</div>
                  {% endif %}
                  <div class="how-to-use__step-content">{{ step_5 }}</div>
                </div>
              {%- endif -%}

            </div>
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

  </div>
</div>

<script>
  (function() {
    function initHowToUseSlider() {
      var $slider = $('.js-how-to-use-slider-{{ section.id }}');
      if ($slider.length && typeof $.fn.slick !== 'undefined') {
        if ($slider.hasClass('slick-initialized')) {
          $slider.slick('unslick');
        }
        $slider.slick({
          slidesToShow: 1,
          slidesToScroll: 1,
          arrows: false,
          dots: false,
          infinite: true,
          fade: false,
          swipe: false,
          touchMove: false,
          draggable: false,
          speed: 400,
          adaptiveHeight: true
        });

        $('.js-how-to-use-prev-{{ section.id }}').off('click.htu').on('click.htu', function(e) {
          e.preventDefault();
          $slider.slick('slickPrev');
        });

        $('.js-how-to-use-next-{{ section.id }}').off('click.htu').on('click.htu', function(e) {
          e.preventDefault();
          $slider.slick('slickNext');
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHowToUseSlider);
    } else {
      initHowToUseSlider();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initHowToUseSlider();
      }
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "How to Use (Metafields)",
  "class": "shopify-section--how-to-use",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "container_size",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show Video Controls",
      "default": false
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card Background Color",
      "default": "#d8e2e6"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1c2226"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "How to Use (Metafields)"
    }
  ]
}
{% endschema %}
