{%- liquid
  assign has_content_below_gallery = false

  for block in section.blocks
    if block.type == 'complementary_products'
      assign has_content_below_gallery = true
      break
    endif

    unless block.settings.show_below_gallery
      continue
    endunless

    if block.type == 'accordion' and block.settings.title != blank and block.settings.content != blank or block.settings.liquid != blank or block.settings.page.content != blank
      assign has_content_below_gallery = true
      break
    elsif block.type == 'description' and product.description != blank
      assign has_content_below_gallery = true
      break
    elsif block.type == 'this_set_includes'
      assign has_content_below_gallery = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} {
    --product-grid: "product-gallery" "product-info" {% if has_content_below_gallery %}"product-content"{% endif %} / minmax(0, 1fr);
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if has_content_below_gallery -%}
        --product-grid: "product-gallery product-info" auto "product-content product-info" minmax(0, 1fr) / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- else -%}
        --product-grid: "product-gallery product-info" / minmax(0, {{ 100.0 | minus: section.settings.product_info_size | divided_by: 100.0 }}fr) minmax(0, {{ section.settings.product_info_size | divided_by: 100.0 }}fr);
      {%- endif -%}
    }
  }
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
{%- capture product_form_id -%}product-form-main-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.new-gallery %} custom-img-new{% endif %}">
  <div class="container {% unless section.settings.container_size == 'full' %}container--{{ section.settings.container_size }}{% endunless %}">
    <product-rerender id="product-info-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender>
      <div class="product">
        {% for block in section.blocks %}
        {%- case block.type -%}
          {% when 'breadcrumb' %}
              {%- capture product_breadcrumb -%}
                  <nav class="mobile-breadcrumb product_breadcrumb breadcrumb breadcrumb--floating" aria-label="Breadcrumb">
                    <ol class="breadcrumb__list unstyled-list" role="list">
                      <li class="breadcrumb__list-item">
                        <a href="{{ routes.root_url }}" class="smallcaps">{{ 'general.breadcrumb.home' | t }}</a>
                      </li>
              
                      <li class="breadcrumb__list-item specific forlastcollection">
                        <a href="" aria-current="page" class="smallcaps"></a>
                      </li>
                      {% comment %} {% assign ifcat = product.category | downcase %}
                      {% if ifcat != "uncategorized" %}
                      <li class="breadcrumb__list-item">
                        <a href="#" aria-current="page" class="smallcaps">{{ product.category }}</a>
                      </li>
                      {% else %} {% endcomment %}
                        {% comment %} <li class="breadcrumb__list-item">
                        <a href="#" aria-current="page" class="smallcaps">{{ product.title }}</a>
                        </li> {% endcomment %}
                      {% comment %} {% endif %} {% endcomment %}
                    </ol>
                  </nav>
              {%- endcapture -%}
              {{ product_breadcrumb }}
              <script>
          (function () {
            var STORAGE_KEY = 'pdp_last_collection';

            var currentProductCollections = {{ product.collections | map: 'handle' | json }};
            var currentProductCollectionTitles = {{ product.collections | map: 'title' | json }};

            var breadcrumbItems = document.querySelectorAll(".breadcrumb__list-item.specific.forlastcollection");
            if (!breadcrumbItems.length) return;

            function applyToAll(handle, title) {
              breadcrumbItems.forEach(function (item) {
                var link = item.querySelector("a");
                if (!link) return;
                link.href = "/collections/" + handle;
                link.textContent = title;
                item.classList.add("show");
              });
            }

            function removeAll() {
              breadcrumbItems.forEach(function (item) { item.remove(); });
            }

            // Step 0: Agar referrer collection page hai aur current product uska member hai — storage set karo
            try {
              var ref = document.referrer || "";
              var match = ref.match(/\/collections\/([a-zA-Z0-9\-_]+)/);
              if (match && match[1]) {
                var refHandle = match[1];
                var idx = currentProductCollections.indexOf(refHandle);
                if (idx !== -1) {
                  sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                    handle: refHandle,
                    title: currentProductCollectionTitles[idx]
                  }));
                }
              }
            } catch (e) {}

            // Step 1: Storage se saved collection padho
            var savedHandle = null, savedTitle = null;
            try {
              var saved = JSON.parse(sessionStorage.getItem(STORAGE_KEY) || "null");
              if (saved && saved.handle && saved.title) {
                savedHandle = saved.handle;
                savedTitle = saved.title;
              }
            } catch (e) {}

            // Agar user kabhi collection se aaya hi nahi (saved khali) -> hide, fallback bhi nahi
            if (!savedHandle) {
              console.log("No collection context in this session — hiding breadcrumb item(s)");
              removeAll();
              return;
            }

            // User collection se aaya hai (session me saved hai) -> ab check karo current product match karta hai?
            if (currentProductCollections.indexOf(savedHandle) !== -1) {
              console.log("Using saved collection ->", savedHandle);
              applyToAll(savedHandle, savedTitle);
              return;
            }

            // Saved collection se match nahi hua -> product ki apni pehli collection (fallback), DISPLAY ONLY
            if (currentProductCollections.length > 0) {
              console.log("Saved collection mismatch — fallback to product's first collection:", currentProductCollections[0]);
              applyToAll(currentProductCollections[0], currentProductCollectionTitles[0]);
              return;
            }

            // Product kisi bhi collection me nahi hai
            console.log("Product has no collections — hiding breadcrumb item(s)");
            removeAll();
          })();
        </script>
        {% endcase %}
        {% endfor %}
        {%- if product.media.size > 0 -%}
          {%- render 'product-gallery',
              product: product,
              product_form_id: product_form_id,
              desktop_layout: section.settings.desktop_media_layout,
              mobile_controls: section.settings.mobile_controls,
              enable_media_autoplay: section.settings.enable_media_autoplay,
              enable_video_looping: section.settings.enable_video_looping,
              enable_image_zoom: section.settings.enable_image_zoom,
              newgallery :section.settings.new-gallery
              max_image_zoom_level: section.settings.max_image_zoom_level -%}
        {%- endif -%}

        {%- render 'product-info', 
          product: product, 
          product_form_id: product_form_id,
          center_basic_info: section.settings.center_basic_info, 
          has_content_below_gallery: has_content_below_gallery, 
          showmsg: section.settings.show-oos,
          hurrygoal: section.settings.goal
          context: 'main_product' 
        -%}

        {%- comment -%}On Prestige, some content may be on the left part below the product gallery{%- endcomment -%}
        {%- if has_content_below_gallery -%}
          <div id="product-extra-information" class="product-content-below-gallery empty:hidden scroll-margin-offset">
            {%- for block in section.blocks -%}
              {%- unless block.settings.show_below_gallery -%}
                {%- continue -%}
              {%- endunless -%}

              {%- case block.type -%}
                {%- when 'description' -%}
                  {%- if product.description != blank -%}
                    {%- if block.settings.collapse_content -%}
                      {% if block.settings.desc-text %}
                      {%- assign accordion_title = block.settings.desc-text -%}
                      {% else %}
                      {%- assign accordion_title = 'product.general.description' | t -%}
                      {% endif %}
                      {%- render 'accordion', title: accordion_title, content: product.description, prose_content: true, size: 'lg', block: block -%}
                    {%- else -%}
                      <div class="product-content-below-gallery__description prose">
                        {{- product.description -}}
                      </div>
                    {%- endif -%}
                  {%- endif -%}

                {%- when 'accordion' -%}
                  {%- liquid
                    assign accordion_title = block.settings.page.title | default: block.settings.title 
                    assign accordion_content = block.settings.page.content | default: block.settings.liquid | default: block.settings.content

                    if accordion_title != blank and accordion_content != blank
                      render 'accordion', title: accordion_title, content: accordion_content, size: 'lg', prose_content: true, icon: block.settings.icon, custom_icon: block.settings.custom_icon, open: block.settings.open_by_default, block: block
                    endif
                  -%}

                {%- when 'complementary_products' -%}
                  {%- render 'complementary-products', product: product, block: block -%}
                {%- when 'this_set_includes' -%}
                  {%- render 'this-set-includes', product: product, block: block -%}
                     {% comment %} {%- render 'this-set-includes-mobile', product: product, block: block -%} {% endcomment %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </product-rerender>
  </div>
  {%- if product.media.size > 0 and section.settings.new-gallery and section.settings.desktop_media_layout != 'carousel_dots' -%}
  <div class="additional-img">
    {%- render 'product-gallery',
              product: product,
              product_form_id: product_form_id,
              desktop_layout: section.settings.desktop_media_layout,
              mobile_controls: section.settings.mobile_controls,
              enable_media_autoplay: section.settings.enable_media_autoplay,
              enable_video_looping: section.settings.enable_video_looping,
              enable_image_zoom: section.settings.enable_image_zoom,
              belowImage:true,
              newgallery :section.settings.new-gallery
              max_image_zoom_level: section.settings.max_image_zoom_level -%}
  </div>
  {%- endif -%}
</div>

{%- if section.settings.show_sticky_add_to_cart -%}
  {%- assign selected_variant = product.selected_or_first_available_variant -%}
  {%- liquid
    assign is_not_sold_individually = false
    for tag in product.tags
      assign downcase_tag = tag | downcase | strip
      if downcase_tag == 'not sold individually'
        assign is_not_sold_individually = true
        break
      endif
    endfor
  -%}
  <product-rerender id="{{ product_form_id }}-sticky-bar" observe-form="{{ product_form_id }}">
    {%- if selected_variant != nil and selected_variant.available -%}
      <product-sticky-bar form="{{ product_form_id }}" class="product-sticky-bar custom-sticky-atc">
        {%- assign sticky_image = selected_variant.featured_media | default: product.featured_media -%}

        <!-- Desktop Sticky Add to Cart -->
        <div class="custom-sticky-atc__desktop">
          <div class="custom-sticky-atc__desktop-info">
            {%- if sticky_image != blank -%}
              <div class="custom-sticky-atc__media">
                {{ sticky_image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '64px', widths: '64,128,200', alt: product.title }}
              </div>
            {%- endif -%}

            <div class="custom-sticky-atc__details">
              <span class="custom-sticky-atc__title">{{ product.title }}</span>
              {%- unless product.has_only_default_variant -%}
                <span class="custom-sticky-atc__variant">{{ selected_variant.title }}</span>
              {%- endunless -%}
              <span class="custom-sticky-atc__price">{{ selected_variant.price | money }}</span>
            </div>
          </div>

          <div class="custom-sticky-atc__action">
            <buy-buttons class="buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ product_form_id }}">
              {%- if is_not_sold_individually -%}
                <button type="button" class="custom-sticky-atc__button is-not-sold-individually" style="pointer-events: none; opacity: 0.6;">
                  Not sold individually
                </button>
              {%- else -%}
                <button type="submit" form="{{ product_form_id }}" class="custom-sticky-atc__button">
                  {{ 'product.general.add_to_cart_button' | t }}
                </button>
              {%- endif -%}
            </buy-buttons>
          </div>
        </div>

        <!-- Mobile Sticky Add to Cart -->
        <div class="custom-sticky-atc__mobile">
          <div class="custom-sticky-atc__mobile-media">
            {%- if sticky_image != blank -%}
              {{ sticky_image | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '76px', widths: '76,152,200', alt: product.title }}
            {%- endif -%}
          </div>

          <div class="custom-sticky-atc__mobile-content">
            <div class="custom-sticky-atc__mobile-header">
              <span class="custom-sticky-atc__mobile-title">{{ product.title }}</span>
              {%- unless product.has_only_default_variant -%}
                <span class="custom-sticky-atc__mobile-variant">{{ selected_variant.title }}</span>
              {%- endunless -%}
            </div>

            <buy-buttons class="buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ product_form_id }}">
              {%- if is_not_sold_individually -%}
                <button type="button" class="custom-sticky-atc__mobile-button is-not-sold-individually" style="pointer-events: none; opacity: 0.6;">
                  Not sold individually
                </button>
              {%- else -%}
                {%- capture mobile_atc_label -%}
                  {{ 'product.general.add_to_cart_button' | t }} - {{ selected_variant.price | money }}
                {%- endcapture -%}
                <button type="submit" form="{{ product_form_id }}" class="custom-sticky-atc__mobile-button">
                  {{ mobile_atc_label | strip }}
                </button>
              {%- endif -%}
            </buy-buttons>
          </div>
        </div>
      </product-sticky-bar>
    {%- endif -%}
  </product-rerender>
{%- endif -%}

{%- comment -%}
IMPLEMENTATION NOTE: Shopify does not currently allows to render a given section within the context of a given product. However,
when rendering the quick buy drawers/popovers, we want to be able to re-use the merchant's choices (such as the selector type). This
is however only possible by rendering the whole product page, and extracting the relevant part. Here, we therefore render the
quick buy information in a template, that will be extracted in JS, which ensures it is not visible in the main product page
{%- endcomment -%}
{%- render 'product-quick-buy', product: product -%}

<script>
  // We save the product ID in local storage to be eventually used for recently viewed section
  try {
    let recentlyViewedProducts = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');

    recentlyViewedProducts = recentlyViewedProducts.filter(item => item !== {{ product.id }}); // Delete product to remove to the start
    recentlyViewedProducts.unshift({{ product.id }}); // Add at the start

    localStorage.setItem('theme:recently-viewed-products', JSON.stringify(recentlyViewedProducts));
  } catch (e) {
    // Safari in private mode does not allow setting item, we silently fail
  }
</script>

<script>
const observer = new MutationObserver(() => {
  const productOptions = document.querySelector("king-linked-options-product");

  if (productOptions) {
    const option = productOptions.querySelector("[data-option-name]");
    const optionName = option?.getAttribute("data-option-name")?.toLowerCase();

    if (optionName?.includes("size")) {
      document.querySelector("variant-picker .opt-Size, variant-picker .opt-size")?.style.setProperty("display", "none");
    }

    observer.disconnect();
  }
});

observer.observe(document.body, {
  childList: true,
  subtree: true
});
</script>

