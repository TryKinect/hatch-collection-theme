{% assign hours =  section.settings.hours | split: ',' %}
{% assign months = "January, February, March, April, May, June, July, August, September, October, November, December" | split: ", " %}
{% assign years =  section.settings.years | split: ',' %}

<div class="modal fade appointment-form" id="appointmentForm" tabindex="-1" role="dialog" aria-labelledby="appointmentFormTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog--l" role="document">
    <div class="modal-content">
      <div class="modal-body">
        {% comment %} BODY {% endcomment %}
          <button type="button" class="close cModal-close" data-dismiss="modal" aria-label="Close">
            <div class="cSvg cSvg--sm cSvg--pink">{% include 'svg' with 'icon-x-close' %}</div>
          </button>

          <div class="form-row">
            <div class="col-12 p-2 cLego-bg--white">

              <div class="aaa_formbuilder_container loaded_aaa_formbuilder">
                <form method="post" action="" enctype="multipart/form-data" class="aaaformbuilder_form">
                  <input type="hidden" name="url" class="get_current_page_url" value="">
                  <input type="hidden" name="container_id" value="">
                  <input type="hidden" name="form_id" value="4293">
                  <input type="hidden" name="form_domain" value="hatchcollection.myshopify.com">
                  <input type="hidden" name="" value="Thanks for booking, we'll be in touch!" class="success_msg">
                  <input type="hidden" name="" value="" class="aaa_thankyoupageurl">
                  <input type="hidden" name="uploadeLimit" class="formUploadLimit" value="20">
                  <input type="hidden" name="allowefiletype" class="allowedfiletype" value="">
                  <input type="hidden" name="conditionallogic" class="conditionallogic" value="">
                  
                <div class="text-center">
                  <h1 class="tC--pink title">{{ 'pages.locations.headline' | t }}</h1>
                </div>

                <div class="cForm-fieldset">
                  <div class="form-row">
                    <div class="col-12">
                      <p>Location:</p>
                    </div>
                  </div>
                  
                  <div class="form-row btn-group btn-group-toggle" data-toggle="buttons">
                    <div class="col-sm-6">
                      <div class="cForm-group">
                        <label class="btn btn-secondary">
                          <input type="radio" class="radio-group" required name="location" value="New York" autocomplete="off"> NY
                        </label>
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="cForm-group">
                        <label class="btn btn-secondary">
                          <input type="radio" class="radio-group" required name="location" value="Los Angeles" autocomplete="off"> LA
                        </label>
                      </div>
                    </div>
                  </div>
                  

                  <div class="form-row">
                    <div class="col-sm-6">
                      <div class="cForm-group">
                        <input class="cForm-input cForm-input--wide form-control" type="text" id="first-name"
                          name="first-name"
                          placeholder="Your First Name *"
                          autocapitalize="words" required
                          value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="cForm-group">
                        <input class="cForm-input cForm-input--wide form-control" type="text" id="last-name"
                          name="last-name"
                          placeholder="Your Last Name *"
                          autocapitalize="words" required
                          value="{% if form[name_attr] %}{{ form[name_attr] }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
                      </div>
                    </div>
                    <div class="col-sm-12">
                      <div class="cForm-group">
                        <input class="cForm-input cForm-input--wide form-control" type="email" id="replyemail"
                          name="replyemail"
                          placeholder="Your Email *" autocorrect="off"
                          autocapitalize="off" required
                          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="cForm-fieldset">
                  <div class="form-row">
                    <div class="col-12">
                      <p>When do you want to come in?</p>
                    </div>
                  </div>
                  
                  <div class="form-row">
                    <div class="col-sm-6">
                      <div class="fb-date form-group field-appointment-date">
                        <input type="text" name="appointment-date" placeholder="Appointment Date" class="aaa_form_builder_date_picker cForm-input form-control" id="appointment-date" value="" required="required">
                      </div>
                    </div>
                    <div class="col-sm-6">
                      <div class="cForm-group">
                        <div class="cSelect">
                          <select required name="appointment-time">
                            <option value=""> TIME * </option>
                            {% for hour in hours %}
                              <option value="{{hour}}">{{ hour }}</option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              
              	<div class="cForm-fieldset">
                  <div class="form-row">
                    <div class="col-12">
                      <p>Are you preg? If so, what's your due date?</p>
                    </div>
                  </div>
                  <div class="form-row">
                    <div class="col-sm-12">
                      <div class="fb-date form-group field-due-date">
                        <input type="text" name="due-date" placeholder="Due Date" class="aaa_form_builder_date_picker cForm-input form-control" id="due-date" value="">
                      </div>
                    </div>
                </div>
				</div>
                

                <div class="pt-2 cForm-submit-wrapper">
                  <button type="submit" class="cForm-submit cCta--arrow">Submit</button>
                 
                </div>

                </form>
              </div>

            </div>
          </div>

        {% comment %} END BODY {% endcomment %}

      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Book appointment",
  "class": "sAppForm-section",
  "settings": [
    {
      "type": "header",
      "content": "Appointment Hours"
    },
    {
      "id": "hours",
      "type": "text",
      "label": "Hours",
      "default": "11:00pm,12:00pm,1:00 pm,2:00 pm,3:00 pm,4:00 pm,5:00 pm,6:00 pm,7:00 pm,"
    },
    {
      "id": "years",
      "type": "text",
      "label": "Years",
      "default": "2018,2019,2020,"
    }
  ]
}
{% endschema %}

