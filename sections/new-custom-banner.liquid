{%- comment -%}
  Custom Image Banner Section
  Fully customizable through Shopify Theme Editor with independent Desktop and Mobile settings.
{%- endcomment -%}

{%- assign desktop_image = section.settings.desktop_image | default: section.settings.image -%}
{%- assign mobile_image = section.settings.mobile_image -%}

{%- capture desktop_title_font -%}
  {%- case section.settings.desktop_title_font_family -%}
    {%- when 'canela' -%}'Canela', Georgia, 'Times New Roman', serif
    {%- when 'circular-std' -%}'Circular Std'
     {%- when 'circular-xxx' -%} 'CircularXX'
    {%- when 'sans-serif' -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif
    {%- when 'serif' -%}Georgia, 'Times New Roman', Garamond, serif
    {%- when 'monospace' -%}ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', 'Courier New', monospace
     {%- when 'inter' -%}Inter
    {%- else -%}inherit
  {%- endcase -%}
{%- endcapture -%}

{%- capture desktop_subtitle_font -%}
  {%- case section.settings.desktop_subtitle_font_family -%}
    {%- when 'canela' -%}'Canela', Georgia, 'Times New Roman', serif
       {%- when 'circular-std' -%}'Circular Std'
     {%- when 'circular-xxx' -%} 'CircularXX'
    {%- when 'sans-serif' -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif
    {%- when 'serif' -%}Georgia, 'Times New Roman', Garamond, serif
    {%- when 'monospace' -%}ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', 'Courier New', monospace
      {%- when 'inter' -%}Inter
    {%- else -%}inherit
  {%- endcase -%}
{%- endcapture -%}

{%- capture mobile_title_font -%}
  {%- case section.settings.mobile_title_font_family -%}
    {%- when 'canela' -%}'Canela', Georgia, 'Times New Roman', serif
      {%- when 'circular-std' -%}'Circular Std'
     {%- when 'circular-xxx' -%} 'CircularXX'
    {%- when 'sans-serif' -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif
    {%- when 'serif' -%}Georgia, 'Times New Roman', Garamond, serif
    {%- when 'monospace' -%}ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', 'Courier New', monospace
      {%- when 'inter' -%}Inter
    {%- else -%}inherit
  {%- endcase -%}
{%- endcapture -%}

{%- capture mobile_subtitle_font -%}
  {%- case section.settings.mobile_subtitle_font_family -%}
    {%- when 'canela' -%}'Canela', Georgia, 'Times New Roman', serif
      {%- when 'circular-std' -%}'Circular Std'
     {%- when 'circular-xxx' -%} 'CircularXX'
    {%- when 'sans-serif' -%}-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif
    {%- when 'serif' -%}Georgia, 'Times New Roman', Garamond, serif
    {%- when 'monospace' -%}ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', 'Courier New', monospace
      {%- when 'inter' -%}Inter
    {%- else -%}inherit
  {%- endcase -%}
{%- endcapture -%}

<style>
  #shopify-section-{{ section.id }} {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .custom-image-banner {
    position: relative;
    width: 100%;
    {% comment %} min-height: 480px; {% endcomment %}
    display: flex;
    overflow: hidden;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .custom-image-banner__media {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
    display: block;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .custom-image-banner__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-image-banner__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-color: #242424;
    fill: #707070;
    display: block;
  }

  #shopify-section-{{ section.id }} .custom-image-banner__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
    {% comment %} background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.45) 0%,
      rgba(0, 0, 0, 0.18) 45%,
      rgba(0, 0, 0, 0.05) 100%
    ); {% endcomment %}
  }

  #shopify-section-{{ section.id }} .custom-image-banner__container {
    position: relative;
    z-index: 3;
    width: 100%;
    min-height: inherit;
    display: flex;
    flex-direction: column;
      position: absolute;
      height: 100%;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .custom-image-banner__content {
    display: flex;
    flex-direction: column;
    max-width: 670px;
    box-sizing: border-box;
    color: #ffffff;
    {% comment %} text-shadow: 0 1px 6px rgba(0, 0, 0, 0.35); {% endcomment %}
  }

  #shopify-section-{{ section.id }} .custom-image-banner__subtitle {
    margin: 0 0 12px 0;
    padding: 0;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 400;
    line-height: 1.3;
    word-break: break-word;
    letter-spacing: 0;
        color: #FFF;
    line-height: normal;

  }

  #shopify-section-{{ section.id }} .custom-image-banner__title {
    margin: 0;
    padding: 0;
    color: #ffffff;
    font-weight: 300;
    line-height: 98%;
    letter-spacing: -0.015em;
    word-break: break-word;
    font-weight: 200;
  }

  /* Desktop Viewport Styles (min-width: 768px) */
  @media screen and (min-width: 768px) {
    {% comment %} #shopify-section-{{ section.id }} .custom-image-banner {
      min-height: 560px;
    } {% endcomment %}

    #shopify-section-{{ section.id }} .custom-image-banner__container {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      padding-left: 48px;
      padding-right: 48px;
      justify-content: {{ section.settings.desktop_content_vertical_position }};
      align-items: {{ section.settings.desktop_content_horizontal_position }};
      position: absolute;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .custom-image-banner__content {
      align-items: {{ section.settings.desktop_content_horizontal_position }};
      text-align: {%- if section.settings.desktop_content_horizontal_position == 'center' -%}center{%- elsif section.settings.desktop_content_horizontal_position == 'flex-end' -%}right{%- else -%}left{%- endif -%};
    }

    #shopify-section-{{ section.id }} .custom-image-banner__title {
      font-size: {{ section.settings.desktop_title_font_size }}px;
      font-family: {{ desktop_title_font | strip }};
    }

    #shopify-section-{{ section.id }} .custom-image-banner__subtitle {
      font-size: {{ section.settings.desktop_subtitle_font_size }}px;
      font-family: {{ desktop_subtitle_font | strip }};
      margin-bottom: 12px;
    }
  }

  /* Mobile Viewport Styles (max-width: 767px) */
  @media screen and (max-width: 767px) {
    {% comment %} #shopify-section-{{ section.id }} .custom-image-banner {
      min-height: 420px;
    } {% endcomment %}

    #shopify-section-{{ section.id }} .custom-image-banner__container {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      padding-left: 20px;
      padding-right: 20px;
      justify-content: {{ section.settings.mobile_content_vertical_position }};
      align-items: {{ section.settings.mobile_content_horizontal_position }};
    }

    #shopify-section-{{ section.id }} .custom-image-banner__content {
      align-items: {{ section.settings.mobile_content_horizontal_position }};
      text-align: {%- if section.settings.mobile_content_horizontal_position == 'center' -%}center{%- elsif section.settings.mobile_content_horizontal_position == 'flex-end' -%}right{%- else -%}left{%- endif -%};
    }

    #shopify-section-{{ section.id }} .custom-image-banner__title {
      font-size: {{ section.settings.mobile_title_font_size }}px;
      font-family: {{ mobile_title_font | strip }};
      letter-spacing: 1px;
    }

    #shopify-section-{{ section.id }} .custom-image-banner__subtitle {
      font-size: {{ section.settings.mobile_subtitle_font_size }}px;
      font-family: {{ mobile_subtitle_font | strip }};
      margin-bottom: 8px;
    }
  }
</style>

<div class="custom-image-banner" id="custom-image-banner-{{ section.id }}">
  {%- if desktop_image != blank or mobile_image != blank -%}
    <picture class="custom-image-banner__media">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 767px)"
          srcset="{{ mobile_image | image_url: width: 375 }} 375w,
                  {{ mobile_image | image_url: width: 550 }} 550w,
                  {{ mobile_image | image_url: width: 750 }} 750w,
                  {{ mobile_image | image_url: width: 1100 }} 1100w"
          width="{{ mobile_image.width }}"
          height="{{ mobile_image.height }}"
        >
      {%- endif -%}

      {%- assign base_image = desktop_image | default: mobile_image -%}
      {{ base_image | image_url: width: 3840 | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '375, 550, 750, 1100, 1500, 1780, 2000, 2800, 3840',
        sizes: '100vw',
        class: 'custom-image-banner__image',
        alt: base_image.alt | default: section.settings.title | escape
      }}
    </picture>
  {%- else -%}
    <div class="custom-image-banner__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'custom-image-banner__placeholder' }}
    </div>
  {%- endif -%}

  <div class="custom-image-banner__overlay" aria-hidden="true"></div>

  {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
    <div class="custom-image-banner__container">
      <div class="custom-image-banner__content">
        {%- if section.settings.subtitle != blank -%}
          <p class="custom-image-banner__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}

        {%- if section.settings.title != blank -%}
          <h1 class="custom-image-banner__title">{{ section.settings.title | escape }}</h1>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Custom Image Banner",
  "tag": "section",
  "class": "shopify-section--custom-image-banner",
  "settings": [
    {
      "type": "header",
      "content": "General Settings"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional. If not set, the desktop image will be automatically used."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Outerwear"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "New Season"
    },
    {
      "type": "header",
      "content": "Desktop Settings"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 64
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 64
    },
    {
      "type": "select",
      "id": "desktop_content_vertical_position",
      "label": "Desktop Content Vertical Position",
      "default": "flex-end",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "desktop_content_horizontal_position",
      "label": "Desktop Content Horizontal Position",
      "default": "flex-start",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ]
