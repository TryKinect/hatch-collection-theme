{% if section.settings.text_enable and section.settings.description %}
  <div class="container py-2 community-text">
    <div class="row align-items-center">
        <div class="col-lg-6 center" style="color: {{ section.settings.color }}; text-align: {{ section.settings.textPosition }}; font-size: {{ section.settings.fontSize }}px;" >
          {{ section.settings.description }}
        </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Text Section",
  "class": "text_section",
  "settings": [
    {
      "type": "checkbox",
      "id": "text_enable",
      "label": "Enable/Disable Description",
	  "default": true
    },
    {
      "id": "description",
      "type": "richtext",
      "label": "Description"
    },
    {
      "id": "textPosition",
      "type": "select",
      "label": "Text Position",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        },
        {
          "label": "Justify",
          "value": "justify"
        }
      ]
    },
	{
      "id": "color",
      "type": "color",
      "label": "Color",
	  "default": "#ffffff"
    },
    {
        "type":      "range",
        "id":        "fontSize",
        "min":       12,
        "max":        100,
        "step":       2,
        "unit":       "px",
        "label":     "Font size",
        "default":   24
    }
  ]
}
{% endschema %}
