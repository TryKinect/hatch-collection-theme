{%- comment -%}
  Our Standards Section
  Fully customizable grid/scroll list of brand standards with custom icon images and titles.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#e5e6e8' }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  .std-container--sm{max-width: 600px;width: 100%;padding: 0 37.5px;margin: 0 auto;}
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .our-standards__heading {
  color: #000;
text-align: center;
font-family: Canela;
font-size: 36px;
font-style: normal;
font-weight: 100;
line-height: normal;
  }

  @media screen and (min-width: 750px) {
    .our-standards__heading {
    font-size: 36px;
      margin-bottom: 42px;
    }
  }

  .our-standards__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
    gap: {{ section.settings.mobile_gap }}px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .our-standards__grid {
      display: grid;
      grid-template-columns: repeat({{ section.settings.desktop_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.desktop_gap }}px;
    }
  }

  {%- if section.settings.mobile_layout == 'scroll' -%}
    @media screen and (max-width: 749px) {
      .our-standards__grid {
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        padding-bottom: 8px;
        justify-content: flex-start;
      }
      .our-standards__grid::-webkit-scrollbar {
        display: none;
      }
      .our-standards__item {
        flex: 0 0 calc(50% - ({{ section.settings.mobile_gap }}px / 2));
        scroll-snap-align: start;
      }
    }
  {%- else -%}
    @media screen and (max-width: 749px) {
      .our-standards__grid {
        display: grid;
        grid-template-columns: repeat({{ section.settings.mobile_columns }}, minmax(0, 1fr));
        gap: {{ section.settings.mobile_gap }}px;
      }
    }
  {%- endif -%}

  .our-standards__item {
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.item_alignment }};
    text-align: {{ section.settings.item_alignment }};
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  a.our-standards__item:hover {
    opacity: 0.8;
  }

  .our-standards__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ section.settings.mobile_icon_width }}px;
    height: {{ section.settings.mobile_icon_height }}px;
    margin-bottom: 12px;
    color: {{ section.settings.icon_color | default: '#1c2226' }};
    flex-shrink: 0;
  }

  @media screen and (min-width: 750px) {
    .our-standards__icon-wrap {
      width: {{ section.settings.desktop_icon_width }}px;
      height: {{ section.settings.desktop_icon_height }}px;
      margin-bottom: 16px;
    }
  }

  .our-standards__icon-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .our-standards__icon-wrap svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .our-standards__title {
color: #231F20;
font-family: SemplicitaPro;
font-size: 12.585px;
font-style: normal;
font-weight: 500;
line-height: normal;
letter-spacing: 0.14px;  
}

  @media screen and (min-width: 750px) {
    .our-standards__title {
      font-size: {{ section.settings.title_font_size_desktop }}px;
    }
  }

  .our-standards__subtext {
    color: {{ section.settings.title_color | default: '#1c2226' }};
    opacity: 0.85;
    font-size: 13px;
    margin-top: 4px;
    line-height: 1.4;
  }

  @media(max-width: 767px){
    .std-container--sm{padding: 0 20px;}
      .our-standards__title{
    color: #000;
text-align: center;
font-family: CircularXX;
font-size: 8px;
font-style: normal;
font-weight: 400;
line-height: 114%; /* 8.296px */
letter-spacing: 0.073px;
}
.our-standards__heading{margin-bottom: 30px;}
  #shopify-section-{{ section.id }}{
   background: {{ section.settings.mob_bg_color | default: '#e5e6e8' }};
   padding-top: 115px;
   padding-bottom: 115px;
  }
}
{%- endstyle -%}

<div class="our-standards__wrapper">
  <div class="container {% unless section.settings.container_size == 'full' %}std-container--{{ section.settings.container_size }}{% endunless %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="our-standards__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="our-standards__grid">
        {%- for block in section.blocks -%}
          {%- capture item_content -%}
            {%- if block.settings.custom_svg != blank or block.settings.icon_image != blank -%}
              <div class="our-standards__icon-wrap">
                {%- if block.settings.custom_svg != blank -%}
                  {{ block.settings.custom_svg }}
                {%- elsif block.settings.icon_image != blank -%}
                  {{- block.settings.icon_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.title -}}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="our-standards__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.subtext != blank -%}
              <p class="our-standards__subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="our-standards__item" {{ block.shopify_attributes }}>
              {{ item_content }}
            </a>
          {%- else -%}
            <div class="our-standards__item" {{ block.shopify_attributes }}>
              {{ item_content }}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Our Standards",
  "class": "shopify-section--our-standards",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Standards"
    },
   
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    
    {
      "type": "header",
      "content": "Background & Container"
    },
    {
      "type": "text",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#e5e6e8"
    },
      {
      "type": "text",
      "id": "mob_bg_color",
      "label": "Mobile Background Color",
      "default": "#e5e6e8"
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "Container Width",
      "options": [
        { "value": "sm", "label": "Small" },
        { "value": "md", "label": "Medium" },
        { "value": "lg", "label": "Large" },
        { "value": "xl", "label": "Extra Large" },
        { "value": "full", "label": "Full Width" }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Desktop Columns",
      "default": 5
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Desktop Gap",
      "default": 30
    },
  
    {
      "type": "header",
      "content": "Mobile Layout"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile Display Mode",
      "options": [
        { "value": "grid", "label": "Grid Layout" },
        { "value": "scroll", "label": "Horizontal Scroll" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Mobile Columns (Grid Mode)",
      "default": 2
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile Gap",
      "default": 16
    },
  
    {
      "type": "header",
      "content": "Item Styling"
    },
    {
      "type": "select",
      "id": "item_alignment",
      "label": "Item Text & Icon Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
   
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Padding Bottom",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Top",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Padding Bottom",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "standard_item",
      "name": "Standard Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon Image",
          "info": "Use the image with a 1:1 aspect ratio"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Custom SVG Code (Optional alternative to image)"
        },
        {
          "type": "textarea",
          "id": "title",
          "label": "Title",
          "default": "LEAPING BUNNY CERTIFIED"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext (Optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Standards",
      "blocks": [
        {
          "type": "standard_item",
          "settings": {
            "title": "LEAPING BUNNY CERTIFIED"
          }
        },
        {
          "type": "standard_item",
          "settings": {
            "title": "FORMULATED WITHOUT PARABENS"
          }
        },
        {
          "type": "standard_item",
          "settings": {
            "title": "NUTRIENT RICH"
          }
        },
        {
          "type": "standard_item",
          "settings": {
            "title": "ALLERGEN TESTED"
          }
        },
        {
          "type": "standard_item",
          "settings": {
            "title": "PLANT FORWARD"
          }
        }
      ]
    }
  ]
}
{% endschema %}
