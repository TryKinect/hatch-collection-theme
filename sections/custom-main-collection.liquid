                                        {% endif %}
                                      </div>
                                    </div>
                                  </section>
                                {% endif %}
                              </div>
                            {%- endif -%}
                          {% when 'feature-image' %}
                            {%- if absolute_index == block.settings.position -%}
                              {% if block.settings.small_image != blank %}
                                <div
                                  class="desktop-feature block-{{ block.id }}"
