                                      <div class="promo-text">
                                        {% if block.settings.promo_title != blank %}
                                          <h3>{{ block.settings.promo_title }}</h3>
                                        {% endif %}
                                        {% if block.settings.promo_text != blank %}
                                          <p>{{ block.settings.promo_text }}</p>
                                        {% endif %}
                                        {% if block.settings.promo_button_url != blank %}
                                          <a href="{{ block.settings.promo_button_url }}" class="shop-btn">
                                            {{- block.settings.promo_button_text -}}
                                          </a>
                                        {% endif %}
                                      </div>
                                    </div>
                                  </section>
                                {% endif %}
                              </div>
                            {%- endif -%}
                            {%- if absolute_index == block.settings.mob_position
                              and block.settings.promo_image != blank
                              or absolute_index == block.settings.mob_position
                              and block.settings.promo_video != blank
                            -%}
                              <style>
                                .mobile-promo.block-{{ block.id }} .promo-text h3 {
                                font-size: {{ block.settings.mobile_title_font_size }}px;
                                color: {{ block.settings.mobile_title_color }};
                                }

                                .mobile-promo.block-{{ block.id }} .promo-text p {
