                    {%- for product in collection.products -%}
                      {%- assign fm_local_index = forloop.index0 -%}
                      {%- assign fm_global_index = paginate.current_offset | plus: fm_local_index -%}
                      {%- for fm_block in section.blocks -%}
                        {%- if fm_block.type == 'fm_4up' or fm_block.type == 'fm_6up' or fm_block.type == 'fm_2up' -%}
                          {%- if fm_block.settings.enabled -%}
                            {%- assign fm_row_zero = fm_block.settings.row_position | minus: 1 -%}
                            {%- assign fm_target = fm_row_zero | times: fm_cols -%}
                            {%- assign fm_insert = false -%}
                            {%- if fm_block.settings.page_scope == 'each' and fm_local_index == fm_target -%}
                              {%- assign fm_insert = true -%}
                            {%- elsif fm_block.settings.page_scope == 'first'
                              and paginate.current_page == 1
                              and fm_local_index == fm_target
                            -%}
                              {%- assign fm_insert = true -%}
                            {%- elsif fm_block.settings.page_scope == 'global' and fm_global_index == fm_target -%}
                              {%- assign fm_insert = true -%}
                            {%- endif -%}
                            {%- if fm_insert -%}
                              {%- render 'plp-merch-block', block: fm_block -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- assign absolute_index = forloop.index0 | plus: 1 | plus: paginate.current_offset -%}
                      {% for block in section.blocks %}
                        {% case block.type %}
                          {% when 'inline-banner' %}
                            {%- if absolute_index == block.settings.position
                              and block.settings.desktop_image != blank
                            -%}
                              <div
                                class="desktop-inline-banner inline-banner block-{{block.id}}"
                                {% if paginate.current_page == paginate.pages and forloop.last %}
                                  {%- if block.settings.position > collection.products_count -%}
                                    style="order:10;"
                                  {% endif %}
                                {% endif %}
                              >
                                {% if block.settings.desktop_image != blank %}
                                  <style>
                                    .desktop-inline-banner.block-{{block.id}} .ad-text h2 {
                                        font-size: {{ block.settings.desktop_title_font_size }}px;
                                        color: {{ block.settings.desktop_title_color }};
                                    }

                                    .desktop-inline-banner.block-{{block.id}} .ad-text .shop-link {
                                        font-size: {{ block.settings.desktop_button_font_size }}px;
                                        color: {{ block.settings.desktop_button_color }};
                                    }
                                  </style>
                                  <div
                                    class=""
                                    style="--opacity:{{block.settings.overlay_opacity}};--background_color:{{block.settings.background_color}};"
                                  >
                                    <div class="ad-container">
                                      {% if button_url != blank %}
                                        <a href="button_url">
                                      {% endif %}
                                      <img
                                        src="{{ block.settings.desktop_image | image_url: master }}"
                                        alt=""
                                        class="ad-image"
                                      >
                                      {% if button_url != blank %}
                                        </a>
                                      {% endif %}

                                      <div class="ad-text">
                                        {% if block.settings.title != blank %}
                                          <h2>{{ block.settings.title }}</h2>
                                        {% endif %}
                                        {% if block.settings.button_url != blank %}
                                          <a href="{{ block.settings.button_url }}" class="shop-link">
                                            {{- block.settings.button_text -}}
                                          </a>
                                        {% endif %}
                                      </div>
                                    </div>
                                  </div>
                                {% endif %}
                              </div>
                            {%- endif -%}
                            {%- if absolute_index == block.settings.mob_position
                              and block.settings.mobile_image != blank
                            -%}
