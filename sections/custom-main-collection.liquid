                              </style>
                              <div
                                class="mobile-promo block-{{ block.id }}"
                                {% if paginate.current_page == paginate.pages and forloop.last %}
                                  {%- if block.settings.mob_position > collection.products_count -%}
                                    style="order:10;"
                                  {% endif %}
                                {% endif %}
                              >
                                {% if block.settings.promo_image != blank or block.settings.promo_video != blank %}
                                  <section class="promo-section{% if block.settings.promo_reverse %} reverse{% endif %}">
                                    <div class="promo-content">
                                      <div class="promo-image">
                                        {% if block.settings.promo_video == blank %}
                                          <img
                                            src="{{ block.settings.promo_image | image_url: master }}"
                                            alt="{{ block.settings.promo_alt }}"
                                          >
                                        {% endif %}

                                        {% if block.settings.promo_video != blank %}
                                          <video
                                            autoplay
                                            muted
                                            playsinline
                                            loop
                                            preload="metadata"
                                            poster="{{ block.settings.promo_image | image_url: master }}"
                                          >
                                            {% for source in block.settings.promo_video.sources %}
