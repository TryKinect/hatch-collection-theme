                    {% endif %}
                  </div>
                {% endif %}
                <div class="collection__main swatch-{{ section.settings.swatch_type }}">
                  {%- render 'active-facets', results: collection -%}
                  {%- liquid
                    assign fm_cols = 4
                    if section.settings.filter_layout == 'sidebar' and show_filters
                      if products_desktop_grid_mode == 'large'
                        assign fm_cols = 2
                      elsif products_desktop_grid_mode == 'medium'
                        assign fm_cols = 3
                      else
                        assign fm_cols = 4
                      endif
                    else
                      if products_desktop_grid_mode == 'large'
                        assign fm_cols = 3
                      elsif products_desktop_grid_mode == 'medium'
                        assign fm_cols = 4
                      else
                        assign fm_cols = 6
                      endif
                    endif
                  -%}
                  <product-list
                    id="product-list-{{ section.id }}"
                    class="product-list  medium"
                    collection-mobile-layout="{{ products_mobile_grid_mode }}"
                    collection-desktop-layout="{{ products_desktop_grid_mode }}"
