                                  /* Mobile schema styling */
                                  .mobile-inline-banner.block-{{block.id}} .ad-text h2 {
                                      font-size: {{ block.settings.mobile_title_font_size }}px;
                                      color: {{ block.settings.mobile_title_color }};
                                  }

                                  .mobile-inline-banner.block-{{block.id}} .ad-text .shop-link {
                                      font-size: {{ block.settings.mobile_button_font_size }}px;
                                      color: {{ block.settings.mobile_button_color }};
                                  }
                                </style>

