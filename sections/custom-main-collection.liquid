                        aria-hidden="true"
                        focusable="false"
                        fill="none"
                        width="10"
                        class="icon icon-chevron-down"
                        viewBox="0 0 10 10"
                      >
                        <path d="m1 3 4 4 4-4" stroke="currentColor" stroke-linecap="square"></path>
                      </svg>
                    </button>
                  </div>
                {%- endif -%}

                {%- if section.settings.show_sort_by -%}
                  {%- assign selected_sort_by_value = collection.sort_by | default: collection.default_sort_by -%}

                  <div class="collection-toolbar__button-container">
                    <button
                      type="button"
                      aria-controls="sort-by-popover"
                      class="collection-toolbar__button heading text-xxs w-full"
                      onclick="
                        (function(){
                          if (window.innerWidth <= 767) {
                            const button = document.querySelector('.collection-toolbar__button[aria-controls=\'sort-by-popover\']');
                            const observer = new MutationObserver(() => {
                              const popover = document.querySelector('facets-sort-popover#sort-by-popover');
                              if (popover && button.nextElementSibling !== popover) {
                                button.parentNode.insertBefore(popover, button.nextSibling);
                                observer.disconnect();
                              }
                            });
                            observer.observe(document.body, { childList: true, subtree: true });
                          }
                        })();
                      "
                    >
                      <span class="text-with-icon justify-center">
                        {{- 'collection.faceting.sort_by' | t -}}
                        {%- render 'icon' with 'chevron-down' -%}
                      </span>
                    </button>

                    <facets-sort-popover
                      id="sort-by-popover"
                      section-id="{{ section.id }}"
                      class="popover popover--bottom-end color-scheme color-scheme--dialog"
                      close-on-listbox-select
                    >
                      <p class="h4 sort-popup" slot="header">
                        {{ 'collection.faceting.sort_by' | t }}
                        <svg
                          aria-hidden="true"
                          focusable="false"
                          fill="none"
                          width="10"
                          class="icon icon-chevron-down"
                          viewBox="0 0 10 10"
                        >
                          <path d="m1 3 4 4 4-4" stroke="currentColor" stroke-linecap="square"></path>
                        </svg>
                      </p>

                      <x-listbox class="popover__value-list">
                        {%- for sort_option in collection.sort_options -%}
                          {%- if sort_option.name != blank -%}
                            <button
                              type="button"
                              class="popover__value-option group"
                              role="option"
                              value="{{ sort_option.value }}"
                              {% if sort_option.value == selected_sort_by_value %}
                                aria-selected="true"
                              {% endif %}
                            >
                              <span class="reversed-link">{{ sort_option.name }}</span>
                            </button>
                          {%- endif -%}
                        {%- endfor -%}
                      </x-listbox>
                    </facets-sort-popover>
                  </div>
                {%- endif -%}
              </div>

              {%- if section.settings.show_results_count -%}
                <p class="collection-toolbar__products-count h6 md-max:hidden">
                  {{ 'collection.products_count' | t: count: collection.products_count }}
                </p>
              {%- endif -%}

              {%- if section.settings.show_grid_mode_selector -%}
