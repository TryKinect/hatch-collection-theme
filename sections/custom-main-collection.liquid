                                  <div class="ad-container">
                                    {% if block.settings.button_url != blank %}
                                      <a href="{{ block.settings.button_url }}">
                                    {% endif %}
                                    <img
                                      src="{{ block.settings.mobile_image | image_url: master }}"
                                      alt=""
                                      class="ad-image"
                                    >
                                    {% if block.settings.button_url != blank %}
                                      </a>
                                    {% endif %}
                                    <div class="ad-text">
                                      {% if block.settings.title != blank %}
                                        <h2>{{ block.settings.title }}</h2>
                                      {% endif %}
                                      {% if block.settings.button_url != blank %}
                                        <a href="{{ block.settings.button_url }}" class="shop-link">
                                          {{- block.settings.button_text -}}
                                        </a>
                                      {% endif %}
                                    </div>
                                  </div>
                                </div>
                              {% endif %}
                            {%- endif -%}
                          {% when 'promo-section' %}
                            <style>
                              .desktop-promo.block-{{ block.id }} .promo-text h3{ font-size: {{ block.settings.desktop_title_font_size }}px;color: {{ block.settings.desktop_title_color }};}
                              .desktop-promo.block-{{ block.id }} .promo-text p{font-size: {{ block.settings.desktop_desc_font_size }}px;color: {{ block.settings.desktop_desc_color }};}
                              .desktop-promo.block-{{ block.id }} .promo-text .shop-btn {font-size: {{ block.settings.desktop_button_font_size }}px;color: {{ block.settings.desktop_button_color }};}
                              .desktop-promo.block-{{ block.id }} .promo-section{paddin-top:{{block.settings.padding_top }}px;paddin-bottom:{{block.settings.padding_bottom }}px;}
                            </style>
