                                    {% endif %}
                                  {% endif %}
                                >
                                  <style>
                                    .desktop-feature.block-{{ block.id }} .feature-inner h3 {
                                        font-size: {{ block.settings.desktop_title_font_size }}px;
                                        color: {{ block.settings.desktop_title_color }};
                                    }

