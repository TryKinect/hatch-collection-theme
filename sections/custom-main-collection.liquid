                                        <div class="feature-inner">
                                          {% if block.settings.title != blank %}
                                            <h3>{{ block.settings.title }}</h3>
                                          {% endif %}

                                          {% if block.settings.small_image != blank %}
                                            <div class="feature-subimage">
                                              {% if block.settings.button_url != blank %}
                                                <a href="{{ block.settings.button_url }}">
                                              {% endif %}
                                              <img
                                                src="{{ block.settings.small_image | image_url: master }}"
                                                alt="{{ block.settings.alt }}"
                                              >
                                              {% if block.settings.button_url != blank %}
                                                </a>
                                              {% endif %}
                                            </div>
                                          {% endif %}

                                          {% if block.settings.button_url != blank %}
                                            <a href="{{ block.settings.button_url }}" class="image-shop-btn">
                                              {{- block.settings.button_text -}}
                                            </a>
                                          {% endif %}
                                        </div>
                                      </div>

                                      <!-- Right Column -->
                                      <div class="feature-right">
                                        {% if block.settings.large_image != blank %}
                                          {% if block.settings.button_url != blank %}
                                            <a href="{{ block.settings.button_url }}">
                                          {% endif %}
                                          <img
                                            src="{{ block.settings.large_image | image_url: master }}"
                                            alt="{{ block.settings.alt }}"
                                          >
                                          {% if block.settings.button_url != blank %}
                                            </a>
                                          {% endif %}
                                        {% endif %}
                                      </div>
                                    </div>
                                  </div>
                                </div>
                              {% endif %}
                            {%- endif -%}
                        {% endcase %}
                      {% endfor %}

                      {%- render 'product-card',
                        product: product,
                        reveal: settings.stagger_products_apparition,
                        position: forloop.index,
                        hide_product_information: section.settings.hide_product_information,
                        stacked: true
                      -%}
                      {%- if forloop.last -%}
                        {%- for fm_block in section.blocks -%}
                          {%- if fm_block.type == 'fm_4up' or fm_block.type == 'fm_6up' or fm_block.type == 'fm_2up' -%}
                            {%- assign fm_target = fm_block.settings.row_position | minus: 1 | times: fm_cols -%}
                            {%- assign fm_global_end = paginate.current_offset | plus: forloop.length -%}
                            {%- if fm_block.settings.enabled
                              and fm_target == forloop.length
                              and fm_block.settings.page_scope == 'each'
                            -%}
                              {%- render 'plp-merch-block', block: fm_block -%}
                            {%- elsif fm_block.settings.enabled
                              and fm_target == forloop.length
                              and fm_block.settings.page_scope == 'first'
                              and paginate.current_page == 1
                            -%}
                              {%- render 'plp-merch-block', block: fm_block -%}
                            {%- elsif fm_block.settings.enabled
                              and fm_target == fm_global_end
                              and fm_block.settings.page_scope == 'global'
                            -%}
                              {%- render 'plp-merch-block', block: fm_block -%}
                            {%- endif -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- if paginate.current_page == paginate.pages -%}
                        {% if forloop.last %}
                          {%- if collection.metafields.custom.promo_section_index_1 > collection.products_count -%}
                            {% render 'promo-section',
                              promo_image: collection.metafields.custom.promo_section_image_1,
                              promo_video: collection.metafields.custom.promo_section_video_1,
                              promo_alt: collection.metafields.custom.promo_section_title_1,
                              promo_title: collection.metafields.custom.promo_section_title_1,
                              promo_text: collection.metafields.custom.promo_section_text_1,
                              promo_button_url: collection.metafields.custom.promo_section_button_url_1,
                              promo_button_text: collection.metafields.custom.promo_section_button_text_1,
                              promo_reverse: collection.metafields.custom.promo_section_content_first_1
                            %}
                          {%- endif -%}
                        {% endif %}
                      {%- endif -%}
                    {%- endfor -%}
                  </product-list>
                  {%- render 'pagination', paginate: paginate, facet: true -%}
                </div>
              {%- endif -%}
            {%- endpaginate -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endunless %}

