                      show_filters: section.settings.show_filters,
                      open_filters_by_default: true,
                      update_on_change: true,
                      quick_links_menu: section.settings.quick_links_menu,
                      context: 'sidebar'
                    -%}
                  </safe-sticky>
                  <div class="filter-overlay-custom" onclick="closefn()"></div>
                {%- endif -%}
