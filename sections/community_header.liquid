<div class="grid-item banner_wrapper">
  <div class="cm_hero">
    {% if section.settings.video_image == 'image' and section.settings.image %}
      <img src="{{ section.settings.image | img_url: '1000x1000' }}" class="{%- if section.settings.image_mobile -%}hidden-xs{%- endif -%}" importance="low">

      {%- if section.settings.image_mobile -%}
        <img src="{{ section.settings.image_mobile | img_url: '1000x1000' }}" class="visible-xs-block" importance="low">
      {%- endif -%}
    {% elsif section.settings.video  %}
      <div class="video-wrapper">
            {% if section.settings.video.type == 'youtube' %}
              {% assign videoCode = section.settings.video.url | split: '=' %}
        <iframe width="100%" height="1500" src="//www.youtube.com/embed/{{ videoCode[1] }}?controls=0&showinfo=0&rel=0&autoplay=1&loop=1&playlist={{ videoCode[1] }}&mute=1" frameborder="0"></iframe>
          {% else %}
              {% assign videoCode = section.settings.video.url | split: '.com/' %}
             <iframe src="https://player.vimeo.com/video/{{ videoCode[1] }}?autoplay=1&loop=1&autopause=0&muted=1" width="100%" height="1500" frameborder="0"></iframe>
            {% endif %}
      </div>
    {% endif %}
    {% if section.settings.text_enable and section.settings.headline %}
      <div class="banner_info {{ section.settings.textPosition }}">

        <h1 class="banner_title title text-center" style="color: {{ section.settings.color }};">{{ section.settings.headline }}</h1>


      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Banner Section",
  "class": "banner_section",
  "settings": [
    {
      "type": "header",
      "content": "Banner Header"
    },
    {
       "type": "radio",
       "id": "video_image",
       "options": [
          { "value": "image", "label": "Image"},
          { "value": "video", "label": "Video"}
       ],
       "default": "image",
       "label": "Select video or image for banner"
    },
    {
      "id": "image",
      "type": "image_picker",
      "label": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile Image"
    },
    {
       "id": "video",
       "type": "video_url",
       "label": "Banner Video URL",
       "accept": ["youtube", "vimeo"]
    },
  {
      "type": "checkbox",
      "id": "text_enable",
      "label": "Enable/Disable Headline",
    "default": true
  },
    {
      "id": "headline",
      "type": "richtext",
      "label": "Headline"
    },
    {
      "id": "textPosition",
      "type": "select",
      "label": "Headline Text Position",
      "default": "left",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ]
    },
  {
      "id": "color",
      "type": "color",
      "label": "Headline color",
    "default": "#ffffff"
    }
  ]
}
{% endschema %}
