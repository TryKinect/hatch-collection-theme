                                  </svg>
                                </a>
                              </li>
                            {% endif %}
                            
                            {% if block.settings.pinterest != blank %}
                              <li class="icon">
                                <a href="{{ block.settings.pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
                                  <svg class="icon icon-pinterest" viewBox="0 0 24 24">
                                    <path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/>
                                  </svg>
                                </a>
                              </li>
                            {% endif %}
                            
                            {% if block.settings.twitter != blank %}
                              <li class="icon">
                                <a href="{{ block.settings.twitter }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                                  <svg class="icon icon-twitter" viewBox="0 0 24 24">
                                    <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                                  </svg>
                                </a>
                              </li>
                            {% endif %}
                            
                            {% if block.settings.linkdin != blank %}
                              <li class="icon">
                                <a href="{{ block.settings.linkdin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                                  <svg class="icon icon-linkedin" viewBox="0 0 24 24">
                                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                                  </svg>
                                </a>
                              </li>
                            {% endif %}
                            {% if block.settings.tiktok != blank %}
                              <li class="icon icon-tiktok">
                                <a href="{{ block.settings.tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                                  <svg class="icon icon-tiktok" id="fi_3046120" enable-background="new 0 0 512 512" height="512" viewBox="0 0 512 512" width="512" xmlns="http://www.w3.org/2000/svg"><g><path d="m480.32 128.39c-29.22 0-56.18-9.68-77.83-26.01-24.83-18.72-42.67-46.18-48.97-77.83-1.56-7.82-2.4-15.89-2.48-24.16h-83.47v228.08l-.1 124.93c0 33.4-21.75 61.72-51.9 71.68-8.75 2.89-18.2 4.26-28.04 3.72-12.56-.69-24.33-4.48-34.56-10.6-21.77-13.02-36.53-36.64-36.93-63.66-.63-42.23 33.51-76.66 75.71-76.66 8.33 0 16.33 1.36 23.82 3.83v-62.34-22.41c-7.9-1.17-15.94-1.78-24.07-1.78-46.19 0-89.39 19.2-120.27 53.79-23.34 26.14-37.34 59.49-39.5 94.46-2.83 45.94 13.98 89.61 46.58 121.83 4.79 4.73 9.82 9.12 15.08 13.17 27.95 21.51 62.12 33.17 98.11 33.17 8.13 0 16.17-.6 24.07-1.77 33.62-4.98 64.64-20.37 89.12-44.57 30.08-29.73 46.7-69.2 46.88-111.21l-.43-186.56c14.35 11.07 30.04 20.23 46.88 27.34 26.19 11.05 53.96 16.65 82.54 16.64v-60.61-22.49c.02.02-.22.02-.24.02z"></path></g></svg>
                                </a>
                              </li>
                            {% endif %}
                          </ul>
                          {% endif %}
                      {%- endif -%}
                    </div>
                {%- when 'text' -%}
                  {%- if block.settings.title != blank or block.settings.content != blank or shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                    <div class="v-stack gap-4 sm:gap-5 accordion-block">
                    {% if block.settings.image_title != blank %}
                      <div class="image-heading">
                        {% if block.settings.image_title != blank %}
                          <img class="mobile-hide" src="{{ block.settings.image_title | img_url:"master"}}" alt="collection Title">
                        {% endif %}
                        {% if block.settings.mob_image_title != blank %}
                          <img class="desktop-hide" src="{{ block.settings.mob_image_title | img_url:"master" }}" alt="collection Title">
                        {% endif %}
                      </div>
                      {% endif %}
                      {%- if block.settings.title != blank -%}
                        <p class="h4 footer-heading">{{ block.settings.title }}</p>
                      {%- endif -%}

                       {% if localization.country.iso_code == 'GB' %}
                        {%- if block.settings.content_uk != blank -%}
                            <div class="prose ">
                              {{- block.settings.content_uk -}}
                            </div>
                        {%- endif -%}
                       {% else %}
                        {%- if block.settings.content != blank -%}
                          <div class="prose ">
                            {{- block.settings.content -}}
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                      {% if localization.country.iso_code == 'GB' %}
                        {% assign desktop_popup_id = settings.uk_desktop_popup_id %}
                        {% assign mobile_popup_id  = settings.uk_mobile_popup_id %}
                        {% if block.settings.button_text_uk %}
                          <button  class="button btn btn2 btn-outline-success mt-1 mt-md-0 desktop-poup" onclick="window._klOnsite = window._klOnsite || [];window._klOnsite.push(['openForm', '{{ desktop_popup_id }}']);"> {{ block.settings.button_text_uk }}</button>
                          <button  class="button btn btn2 btn-outline-success mt-1 mt-md-0 mobile-poup" onclick="window._klOnsite = window._klOnsite || [];window._klOnsite.push(['openForm', '{{ mobile_popup_id }}']);"> {{ block.settings.button_text_uk }}</button>
                        {% endif %}
                      {% else %}
                        {% assign desktop_popup_id = settings.us_desktop_popup_id %}
                        {% assign mobile_popup_id  = settings.us_mobile_popup_id %}
                        {% if block.settings.button_text %}
                          <button  class="button btn btn2 btn-outline-success mt-1 mt-md-0 desktop-poup" onclick="window._klOnsite = window._klOnsite || [];window._klOnsite.push(['openForm', '{{ desktop_popup_id }}']);">{{block.settings.button_text}}</button>
                          <button  class="button btn btn2 btn-outline-success mt-1 mt-md-0 mobile-poup" onclick="window._klOnsite = window._klOnsite || [];window._klOnsite.push(['openForm', '{{ mobile_popup_id }}']);">{{block.settings.button_text}}</button>
                        {% endif %}
                      {% endif %}

                      {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                        <div class="follow-on-shop">
                          {{- shop | login_button: action: 'follow' -}}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                {%- when 'links' -%}
                  {%- assign menu = block.settings.menu -%}

                  {%- if menu != blank and menu.links.size > 0 -%}
                    <div class="v-stack gap-4 sm:gap-5 accordion-block">
                      {%- if block.settings.show_menu_title != blank -%}
                        <p class="h4 footer-heading">{{ block.settings.menu_title | default: menu.title }}</p>
                      {%- endif -%}

                      <ul class="v-stack gap-2.5 unstyled-list" role="list">
                        {%- for link in menu.links -%}
                          <li>
                          {%- if link.url == 'https://babebyhatch.com' %}
                            <a href="https://babebyhatch.com" aria-label="Babe by hatch">
