<style>
  #shopify-section-{{ section.id }} {
    --footer-content-justify-items: {% if section.settings.blocks.size <= 2 %}start{% else %}space-between{% endif %};
  }
.social-media-links {  display: flex; gap: 18px; margin: 0; list-style: none; padding: 0; margin-top: 12px;}
.social-media-links .icon { height: 20px; padding: 0;fill:rgb(var(--text-color));width:auto; }
.footer .container { width: 100%; margin: 0 auto; padding: 0 15px;max-width:1360px; }
.footer__block .image-heading { max-width: 220px; margin-bottom: 12px; }
.footer__block--text button {  padding: 20px; text-align: center; letter-spacing: 0.05em; text-transform: uppercase;  width: 100%;  font-weight: normal; margin-top: 16px;border:1px solid rgb(var(--button-background));color:rgb(var(--button-text-color));background-color:rgb(var(--button-background)); line-height:normal;}
.footer__block--text p {  line-height: 22px; margin: 0 0 26px; letter-spacing: 0.004em;  }
.footer__block .footer-heading {  font-weight: 400; line-height: 16px; margin-top: 0 !important; margin-bottom: 0 !important; padding-bottom: 10px; letter-spacing: 0.05em; text-transform: uppercase;  }
.footer__block--text { padding-right: 15px; padding-left: 15px; }
.footer__block--links li a { display: block;  line-height: 24px; margin-top: 12px !important;font-weight: normal; }
.footer__block--links ul { gap: 0; }
.footer__block > div { gap: 0; }
.footer__inner { row-gap: 55px; }
.footer__aside { padding-top: 18px; border-top: 2px solid #2d2d2d; }
.footer__aside .heading { font-size: 12px;  letter-spacing: 0; }
.footer-bottom { display: flex; list-style: none; }
.footer-bottom li { padding-right: 10px; padding-left: 10px; border-right: 1px solid #2d2d2d; }
.footer-bottom li:last-child { border: none; padding-right: 0; }
.footer-bottom li a { display: block; font-size: 12px;  line-height: 1; }
  .footer {
    padding-top: 97px;
    padding-bottom: 32px;
}

   @media(min-width: 700px) {  .footer__block-list { gap: 1px ; }
.footer__block-list .footer__block { width: calc(58.33333%/4); max-width: calc(58.33333%/4); flex: none; padding: 0 10px; }
.footer__block-list .footer__block.footer__block--text { width: 33.33%; max-width: 33.33%; flex-basis: auto; margin-left: auto; }}

  @media(max-width:990px) and (min-width:767px){
    .footer__block-list .footer__block {
    width: 25%;
    max-width: calc(25% - 4px);
}

.footer__block-list {
    flex-flow: row wrap;
    row-gap: 10px;
}

.footer__block-list .footer__block.footer__block--text {
    margin-left: 0;
    width: 50%;
    max-width: 50%;
}
  }
  @media(max-width:700px){
    .footer__block.footer__block--links .accordion-block ul {
    max-height: 0;
    overflow: hidden;
    transition:0.3s max-height;
}

.footer__block.footer__block--links .accordion-block {
    text-align: center;
}
      .footer__block.footer__block--social-media {
    display: none;
}
.footer__block.footer__block--links .accordion-block.active ul {
    max-height: 300px;
}
.footer__block .footer-heading{position:relative;display: inline-block;max-width: fit-content;margin: 0 auto;}
    .footer__block.footer__block--text .footer-heading {
    width: 100%;
    text-align: center;
    max-width: 100%;
}
    .footer__block.footer__block--text .footer-heading:before,.footer__block.footer__block--text .footer-heading:after{
      content:normal;
    }
.footer-heading:before {
            position: absolute;
            content: ' ';
            height: 10px;
            width: 2px;
            background-color: rgb(var(--text-color));
            display: inline;
            right: -14px;
            transform: rotate(90deg);
            top: 3px;
}

.footer-heading:after {
    position: absolute;
    content: ' ';
    height: 10px;
    width: 2px;
    background-color: rgb(var(--text-color));
    display: inline;
    right: -14px;
    top: 3px;
    transition: 0.5s transform;
}
.footer__block.footer__block--links .accordion-block.active .footer-heading:after {
    transform: rotate(-90deg);
}

    .footer__block--text {
    max-width: 350px;
    margin: 0 auto 50px;
    order: -1;
}

.footer__block.footer__block--links {margin-bottom: 25px;}

.footer__block-list {justify-content: center;gap: 0;}

.footer__block.footer__block--social-media {
    display: block;
}

.footer__block.footer__block--social-media .footer-heading {
    display: none;
}

.social-media-links {
    justify-content: center;
}
    .footer__block.footer__block--text {
    text-align: center;
}

.footer__block.footer__block--text .image-heading {
    margin: 0 auto 12px;
}
.footer__block--links li a svg {
    display: block;
    max-width: fit-content;
    margin: 0 auto;
}
  }

{% comment %} Klaviyo functionality start {% endcomment %}
 .mobile-poup {
  display: none;
}

@media (max-width: 768px) {
  .desktop-poup {
    display: none !important;
  }

  .mobile-poup {
    display: block !important;
  }
}
{% comment %} Klaviyo functionality end {% endcomment %}
</style>

{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

<div class="footer color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
  <div class="container">
    <div class="footer__inner">
      {%- comment -%}
      ------------------------------------------------------------------------------------------------------------------
      FOOTER BLOCKS (MAIN CONTENT)
      ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if section.blocks.size > 0 -%}
        <div class="footer__block-list">
          {%- for block in section.blocks -%}
            {%- capture block_content -%}
              {%- case block.type -%}
                {%- when '@app' -%}
                  {%- render block -%}

                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    {%- capture sizes -%}{{ block.settings.image_width }}px{%- endcapture -%}
                    {%- capture widths -%}{{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 | at_most: block.settings.image.width }}{%- endcapture -%}
                    {%- capture style -%}--image-max-width: {{ block.settings.image_width }}px{%- endcapture -%}

                    {%- if block.settings.link != blank -%}
                      <a href="{{ block.settings.link }}">
                        {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}
                      </a>
                    {%- else -%}
                      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- when 'social-media' -%}
                    <div class="v-stack gap-4 sm:gap-5 accordion-block">
                      {%- if block.settings.title != blank -%}
                        <p class="h4 footer-heading">{{ block.settings.title | default: menu.title }}</p>
                        {% if block.settings.facebook != blank or block.settings.insta != blank or block.settings.pinterest != blank or block.settings.twitter != blank or block.settings.linkdin != blank %}
                          <ul class="social-media-links">
                            {% if block.settings.facebook != blank %}
                              <li class="icon">
                                <a href="{{ block.settings.facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                                  <svg class="icon icon-facebook" viewBox="0 0 24 24">
                                    <path d="M22.675 0H1.325C.593 0 0 .593 0 1.325v21.351C0 23.407.593 24 1.325 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116c.73 0 1.323-.593 1.323-1.325V1.325C24 .593 23.407 0 22.675 0z"/>
                                  </svg>
                                </a>
                              </li>
                            {% endif %}
                            
                            {% if block.settings.insta != blank %}
                              <li class="icon">
                                <a href="{{ block.settings.insta }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                                  <svg class="icon icon-instagram" viewBox="0 0 24 24">
