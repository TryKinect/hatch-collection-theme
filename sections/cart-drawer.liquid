<cart-drawer id="cart-drawer" class="cart-drawer drawer {% if cart.empty? %}drawer--center-body{% endif %} color-scheme color-scheme--{{ section.settings.color_scheme.id }}" initial-focus="false" handle-editor-events>
  <p class="h4" slot="header">{{ 'cart.general.title' | t }}</p>

  {%- if cart.empty? -%}
    <p class="h5 text-center">{{ 'cart.general.empty' | t }}</p>
  {%- else -%}
    {%- if settings.cart_show_free_shipping_bar -%}
      {%- render 'free-shipping-bar' -%}
    {%- endif -%}

    <div class="cart-drawer__items">
      {%- for line_item in cart.items -%}
        {%- render 'line-item', line_item: line_item, show_quantity_selector: true -%}
      {%- endfor -%}
        {% assign showGift = false %}

        {% if localization.country.iso_code == 'GB' %}
          {% if section.settings.show_cart_note_uk %}
            {% assign showGift = true %}
          {% endif %}
        {% else %}
          {% if section.settings.show_cart_note %}
            {% assign showGift = true %}
          {% endif %}
        {% endif %}

        {% if showGift %}
          <!-- cart note content -->
            {%- assign cart_note_dialog_id = 'cart-note-' | append: section.id -%}
            <button class="link-faded-reverse cart-note" aria-controls="{{ cart_note_dialog_id }}">
        <span>Is this a gift?</span><span class="cart-page-form-checkbox__arrow">
                      <img src="https://cdn.shopify.com/s/files/1/1991/8975/files/arrow-right.svg?v=1644235960" alt="Is this a gift?">
                    </span>
        </button>

           <cart-note-dialog id="{{ cart_note_dialog_id }}" class="cart-drawer__order-note">
             <div class="gift-note-add__body-head">
                  <button class="gift-note-add__close js-close">close</button><!-- /.gift-note-add__close -->

                  <h2 class="gift-note-add__body-title">Add a Gift Note</h2><!-- /.gift-note-add__body-title -->
                </div>
                <div class="form">
                  {% comment %} <cart-note class="form-control">
                    {%- assign order_note = 'cart.general.order_note' | t -%}
                    {%- assign placeholder = 'cart.general.note_placeholder' | t -%}
                    <!-- {%- render 'input', name: 'note', multiline: 3, label: order_note, value: cart.note, placeholder: placeholder, show_label_as_block: true -%} -->
                  </cart-note> -->
                  {% endcomment %}
                  <!-- Gift Wrap Fields Start -->
                  <div class="gift-wrap__fields">
                    <div class="gift-wrap__controls">
                      {%- assign gift_to_label = "Gift To" -%}
                      {%- render 'input',
                        name: 'attributes[gift-note-to]',
                        value: cart.attributes['gift-note-to'],
                        show_label_as_block: true,
                        placeholder:'To'
                      -%}
                    </div>
              
                    <div class="gift-wrap__controls">
                      {%- assign gift_from_label = "Gift From" -%}
                      {%- render 'input',
                        name: 'attributes[gift-note-from]',
                        value: cart.attributes['gift-note-from'],
                        show_label_as_block: true,
                        placeholder:'From'
                      -%}
                    </div>
              
                    <p class="txtArea">
                      {%- assign gift_message_label = "Gift Message" -%}
                      {%- render 'input',
                        name: 'attributes[gift-note]',
                        multiline: 3,
                        value: cart.attributes['gift-note'],
                        show_label_as_block: true,
                        placeholder:'Your 150 character message goes here. FYI: a gift receipt is automatically included.'
                      -%}                    
                    </p>
              
                    <div class="cart-page-form-checkbox cart-page-form-checkbox--gift">
                      <input type="checkbox" id="gift-for-mama-add" name="attributes[gift-for-mama-add]">
                      <label for="gift-for-mama-add">
                        Add a gift box for <span class="cart-page-form-checkbox__price">$8</span>
                      </label>
                      <span class="error-alt hidden js-error-checkbox-add">To add this product to the cart, you have to check the checkbox.</span>
                    </div>
              
                    <img class="gift-box-img" src="//www.hatchcollection.com/cdn/shop/products/gift-box_300x.jpg?v=1599773733" alt="" loading="lazy">
                  </div>
                  <!-- Gift Wrap Fields End -->
              
                  <dialog-close-button class="contents">
                    <button type="button" class="button">Add</button>
                  </dialog-close-button>
                </div>
              </cart-note-dialog>
        <script>
        document.querySelector('cart-note-dialog .gift-note-add__body-head button.gift-note-add__close').addEventListener("click", () => {
          document.querySelector('cart-note-dialog').style.transform = 'translateY(100%)';
          document.querySelector('cart-note-dialog').removeAttribute('open');
          document.querySelector(".cart-drawer__items .link-faded-reverse").setAttribute('aria-expanded', 'false')
        })
        </script>
         <script>
           (function () {
            const giftVariantId = {{settings.gift_wrap_pro.selected_or_first_available_variant.id}};
          
            const saveNoteBtn = document.querySelector('dialog-close-button .button');
            const giftCheckbox = document.getElementById('gift-for-mama-add');
          
            // Gift inputs
            const inputTo = document.querySelector('[name="attributes[gift-note-to]"]');
            const inputFrom = document.querySelector('[name="attributes[gift-note-from]"]');
            const inputMessage = document.querySelector('[name="attributes[gift-note]"]');

          
            if (!saveNoteBtn || !giftCheckbox) return;
             fetch('/cart.js')
              .then(res => res.json())
              .then(cart => {
                const giftItem = cart.items.find(item => item.variant_id === giftVariantId);
                if (giftItem) {
                  giftCheckbox.checked = true;
                }
              });
          
            saveNoteBtn.addEventListener('click', function () {
              if (!giftCheckbox.checked){
                fetch('/cart.js')
                .then(res => res.json())
                .then(cart => {
                  const giftItem = cart.items.find(item => item.variant_id === giftVariantId);
          
                  if (giftItem) {
                    // STEP 1: Remove existing gift item
                    return fetch('/cart/change.js', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        id: giftItem.key,
                        quantity: 0
                      })
                    });
                  }
          
                  return Promise.resolve(); // if no gift item, skip removal
                })
                .then(() => {
                  // STEP 3: Refresh and open drawer
                  const cartDrawer = document.querySelector('cart-drawer');
          
                  if (cartDrawer) {
                    const openDrawerAfterRefresh = () => {
                      cartDrawer.removeEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
                      cartDrawer.show();
                    };
          
                    cartDrawer.addEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
                    document.dispatchEvent(new CustomEvent("cart:refresh"));
                  }
                })
                return;
              }
          
              // Build line item properties
              const properties = {
                "gift-note-to": inputTo?.value || '',
                "gift-note-from": inputFrom?.value || '',
                "gift-note": inputMessage?.value.substring(0, 150) || ''
              };
          
              fetch('/cart.js')
                .then(res => res.json())
                .then(cart => {
                  const giftItem = cart.items.find(item => item.variant_id === giftVariantId);
          
                  if (giftItem) {
                    // STEP 1: Remove existing gift item
                    return fetch('/cart/change.js', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        id: giftItem.key,
                        quantity: 0
                      })
                    });
                  }
          
                  return Promise.resolve(); // if no gift item, skip removal
                })
                .then(() => {
                  // STEP 2: Re-add gift item with updated properties
                  return fetch('/cart/add.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      id: giftVariantId,
                      quantity: 1
                    })
                  });
                })
                .then(() => {
                  // STEP 2.5: Update cart attributes
                  return fetch('/cart/update.js', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      attributes: properties
                    })
                  })
                })
                .then(() => {
                  // STEP 3: Refresh and open drawer
                  const cartDrawer = document.querySelector('cart-drawer');
          
                  if (cartDrawer) {
                    const openDrawerAfterRefresh = () => {
                      cartDrawer.removeEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
                      cartDrawer.show();
                    };
          
                    cartDrawer.addEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
                    document.dispatchEvent(new CustomEvent("cart:refresh"));
                  }
                })
                .then(() => {
                  fetch('/cart.js')
                  .then(res => res.json())
                  .then(cart => {
                    const giftItem = cart.items.find(item => item.variant_id === giftVariantId);
                    if (!giftItem) return;
            
                    const giftTo = cart.attributes?.['gift-note-to'] || '';
                    const giftFrom = cart.attributes?.['gift-note-from'] || '';
                    const giftMsg = cart.attributes?.['gift-note'] || '';
            
                    const lineItems = document.querySelectorAll('[data-product-id], line-item');
            
                    lineItems.forEach(item => {
                      const isMatch =
                        item.dataset.productId === String(giftVariantId) ||
                        item.innerHTML.includes(giftVariantId);
            
                      if (!isMatch) return;
            
                      // Prevent duplicate insertion
                      if (item.querySelector('.gift-message')) return;
            
                      const cartURL = {{ routes.cart_url | json }};
                      const wrapper = document.createElement('div');
                      wrapper.className = 'gift-message text-subdued';
                      wrapper.style.marginTop = '10px';
                      wrapper.innerHTML = `
                        <div class="gift-message-field">
                          <label for="gift-from-cart-drawer">From:</label>
                          <input name="attributes[gift-note-from]" oninput="customAttribute('gift-note-from', this);" id="gift-from-cart-drawer" class="js-message-input" value="${giftFrom}" placeholder="From">
                        </div>
                        <div class="gift-message-field">
                          <label for="gift-to-cart-drawer">To:</label>
                          <input name="attributes[gift-note-to]" oninput="customAttribute('gift-note-to', this);" id="gift-to-cart-drawer" class="js-message-input" value="${giftTo}" placeholder="To">
                        </div>
                        <div class="gift-message-field">
                          <label for="gift-message-cart-drawer">Message:</label>
                          <textarea name="attributes[gift-note]" oninput="customAttribute('gift-note', this);" id="gift-message-cart-drawer" class="js-message-input" maxlength="150" placeholder="Message">${giftMsg}</textarea>
                        </div>
                      `;
            
                      // Append to correct position in the gift item
                      const appendTarget =
                        item.querySelector('.line-item-info line-item-quantity') ||
                        item.querySelector('ul.details') ||
                        item;
                      appendTarget.parentNode.insertBefore(wrapper, appendTarget);
                    });
                  });
                })
                .catch(error => {
                  console.error('Error updating gift item:', error);
                });
            });
          })();
         </script>
        <script>
          {% comment %} const giftVariantIdOnLoad = 44036751950006; {% endcomment %}
          document.addEventListener('cart-drawer:refreshed', () => {
            fetch('/cart.js')
            .then(res => res.json())
            .then(cart => {
              console.log(cart.items);
              var giftFrom = '';
              var giftTo = '';
              var giftMsg = '';
              var attrs = cart.attributes;

              if(cart.item_count <= 0){
                document.querySelector('[name="attributes[gift-note-to]"]').value = '';
                document.querySelector('[name="attributes[gift-note-from]"]').value = '';
                document.querySelector('[name="attributes[gift-note]"]').value = '';
              }

              if (attrs && Object.keys(attrs).length > 0) {
          
                // Optional: Check for specific attributes
                var giftTo = attrs['gift-note-to'] || '';
                var giftFrom = attrs['gift-note-from'] || '';
                var giftMsg = attrs['gift-note'] || '';
              }
              
              const giftItem1 = cart.items.find(item => item.variant_id === giftVariantIdOnLoad);
              if(giftItem1 == null){
                document.querySelector('[name="attributes[gift-note-to]"]').value = '';
                document.querySelector('[name="attributes[gift-note-from]"]').value = '';
                document.querySelector('[name="attributes[gift-note]"]').value = '';
              }
              const lineItemsOnLoad = document.querySelectorAll('[data-product-id], line-item');
            
              lineItemsOnLoad.forEach(item => {
                const isMatchonLoad =
                  item.dataset.productId === String(giftVariantIdOnLoad) ||
                  item.innerHTML.includes(giftVariantIdOnLoad);
      
                if (!isMatchonLoad) return;
      
                // Prevent duplicate insertion
                if (item.querySelector('.gift-message')) return;
      
                const cartURLonLoad = {{ routes.cart_url | json }};
                const wrapperOnLoad = document.createElement('div');
                wrapperOnLoad.className = 'gift-message text-subdued';
                wrapperOnLoad.style.marginTop = '10px';
                wrapperOnLoad.innerHTML = `
                  <div class="gift-message-field">
                    <label for="gift-from-cart-drawer">From:</label>
                    <input name="attributes[gift-note-from]" oninput="customAttribute('gift-note-from', this);" id="gift-from-cart-drawer" class="js-message-input" value="${giftFrom}" placeholder="From">
                  </div>
                  <div class="gift-message-field">
                    <label for="gift-to-cart-drawer">To:</label>
                    <input name="attributes[gift-note-to]" oninput="customAttribute('gift-note-to', this);" id="gift-to-cart-drawer" class="js-message-input" value="${giftTo}" placeholder="To">
                  </div>
                  <div class="gift-message-field">
                    <label for="gift-message-cart-drawer">Message:</label>
                    <textarea name="attributes[gift-note]" oninput="customAttribute('gift-note', this);" id="gift-message-cart-drawer" class="js-message-input" maxlength="150" placeholder="Message">${giftMsg}</textarea>
                  </div>
                `;
      
                // Append to correct position in the gift item
                const appendTargetOnLoad =
                  item.querySelector('.line-item-info line-item-quantity') ||
                  item.querySelector('ul.details') ||
                  item;
                appendTargetOnLoad.parentNode.insertBefore(wrapperOnLoad, appendTargetOnLoad);
              });
            });
          })
        </script>
          <script>
             (function() {
           const saveNoteBtn = document.querySelector('dialog-close-button .button');

           const inputTo = document.querySelector('[name="attributes[gift-note-to]"]');
           const inputFrom = document.querySelector('[name="attributes[gift-note-from]"]');
           const inputMessage = document.querySelector('[name="attributes[gift-note]"]');

           if (!saveNoteBtn) return;

           saveNoteBtn.addEventListener('click', function() {
             const updates = {
               attributes: {
                 'gift-note-to': inputTo?.value || '',
                 'gift-note-from': inputFrom?.value || '',
                 'gift-note': inputMessage?.value || ''
               }
             };

             fetch('/cart/update.js', {
                 method: 'POST',
                 headers: {
                   'Content-Type': 'application/json'
                 },
                 body: JSON.stringify(updates)
               })
               .then(res => res.json())
               .then(cart => {
                 console.log('Cart attributes updated:', cart.attributes);
               })
               .catch(error => {
                 console.error('Error updating cart attributes:', error);
               });
           });
         })();
            
          </script>
          <script>
(function () {
  const giftVariantId = {{settings.gift_wrap_pro.selected_or_first_available_variant.id}};

  document.addEventListener('DOMContentLoaded', function () {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        const giftItem = cart.items.find(item => item.variant_id === giftVariantId);
        if (!giftItem) return;

        const giftTo = cart.attributes?.['gift-note-to'] || '';
        const giftFrom = cart.attributes?.['gift-note-from'] || '';
        const giftMsg = cart.attributes?.['gift-note'] || '';

        const lineItems = document.querySelectorAll('[data-product-id], line-item');

        lineItems.forEach(item => {
          const isMatch =
            item.dataset.productId === String(giftVariantId) ||
            item.innerHTML.includes(giftVariantId);

          if (!isMatch) return;

          // Prevent duplicate insertion
          if (item.querySelector('.gift-message')) return;

          const cartURL = {{ routes.cart_url | json }};
          const wrapper = document.createElement('div');
          wrapper.className = 'gift-message text-subdued';
          wrapper.style.marginTop = '10px';
          wrapper.innerHTML = `
            <div class="gift-message-field">
              <label for="gift-from-cart-drawer">From:</label>
              <input name="attributes[gift-note-from]" oninput="customAttribute('gift-note-from', this);" id="gift-from-cart-drawer" class="js-message-input" value="${giftFrom}" placeholder="From">
            </div>
            <div class="gift-message-field">
              <label for="gift-to-cart-drawer">To:</label>
              <input name="attributes[gift-note-to]" oninput="customAttribute('gift-note-to', this);" id="gift-to-cart-drawer" class="js-message-input" value="${giftTo}" placeholder="To">
            </div>
            <div class="gift-message-field">
              <label for="gift-message-cart-drawer">Message:</label>
              <textarea name="attributes[gift-note]" oninput="customAttribute('gift-note', this);" id="gift-message-cart-drawer" class="js-message-input" maxlength="150" placeholder="Message">${giftMsg}</textarea>
            </div>
          `;

          // Append to correct position in the gift item
          const appendTarget =
            item.querySelector('.line-item-info line-item-quantity') ||
            item.querySelector('ul.details') ||
            item;
          appendTarget.parentNode.insertBefore(wrapper, appendTarget);
        });
      });
  });
})();
function customAttribute(attributeName, element){
  var properties = {
    [attributeName]: element.value
  }
  console.log(properties);
  fetch('/cart/update.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      attributes: properties
    })
  }).then((data) => {
    const cartDrawerUpdate = document.querySelector('cart-drawer');
          
    if (cartDrawer) {
      const openDrawerAfterRefresh = () => {
        cartDrawerUpdate.removeEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
        cartDrawerUpdate.show();
      };

      cartDrawerUpdate.addEventListener('cart-drawer:refreshed', openDrawerAfterRefresh);
      document.dispatchEvent(new CustomEvent("cart:refresh"));
    }
  })
}
</script>



          {%- endif -%}
          <div class="nosto_element mini-cart-js"></div>
    </div>

    {%- liquid
      assign cross_sell_products_count = 0

      for product in section.settings.cross_sell_products
        assign items_for_product = cart | line_items_for: product

        if items_for_product.size == 0 and product.available
          assign cross_sell_products_count = cross_sell_products_count | plus: 1
        endif
      endfor
    -%}

    {%- if cross_sell_products_count > 0 -%}
      <div class="cart-drawer__complementary-products complementary-products">
        {%- assign carousel_id = 'complementary-products-carousel-' | append: section.id -%}

        {%- if section.settings.cross_sell_title != blank or section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
          <div class="complementary-products__header complementary-products__header--align-start">
            <p class="h6">{{ section.settings.cross_sell_title }}</p>

            {%- if section.settings.cross_sell_stack_products == false and cross_sell_products_count > 1 -%}
              <carousel-navigation aria-controls="{{ carousel_id }}" class="page-dots page-dots--narrow">
                {%- for i in (1..cross_sell_products_count) -%}
                  <button class="relative" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                    <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
                  </button>
                {%- endfor -%}
              </carousel-navigation>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          capture complementary_products
            for product in section.settings.cross_sell_products
              assign products_in_cart = cart.items | where: 'product_id', product.id

              if products_in_cart.size == 0 and product.available
                render 'product-card-horizontal', product: product, show_quick_buy: true
              endif
            endfor
          endcapture
        -%}

        {%- if section.settings.cross_sell_stack_products -%}
          <div class="complementary-products__product-list">
            {{- complementary_products -}}
          </div>
        {%- else -%}
          <scroll-carousel id="{{ carousel_id }}" class="complementary-products__product-list complementary-products__product-list--carousel scroll-area bleed snap-x">
            {{- complementary_products -}}
          </scroll-carousel>
        {%- endif -%}
      </div>
    {%- endif -%}

    <form action="{{ routes.cart_url }}" method="POST" class="cart-drawer__footer" slot="footer">
      <input type="hidden" name="attributes[products_mobile_grid_mode]" value="">
      <input type="hidden" name="attributes[products_desktop_grid_mode]" value="">

      {%- if section.settings.show_cart_note or section.settings.show_shipping_text -%}
        <div class="v-stack gap-0.5 justify-items-start">
          

          {%- if section.settings.show_shipping_text -%}
            <p class="text-subdued">{{ 'cart.general.taxes_and_shipping_at_checkout' | t }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {% for discount_application in cart.cart_level_discount_applications %}
        <div class="h-stack justify-start gap-4">
          <span class="discount-badge text-xs">{%- render 'icon' with 'discount', width: 12 -%} {{- discount_application.title -}}</span>
          <span class="text-subdued">-{{ discount_application.total_allocated_amount | money }}</span>
        </div>
      {% endfor %}

      <div class="button-group">
        {%- if section.settings.show_view_cart_button or section.settings.show_checkout_button == false -%}
          {%- assign view_cart = 'cart.general.view_cart' | t -%}
          {%- render 'button', href: routes.cart_url, content: view_cart, stretch: true -%}
        {%- endif -%}

        {%- if section.settings.show_checkout_button -%}
          {%- capture checkout_button -%}
            {{- 'cart.general.checkout' | t -}}

            {%- if section.settings.show_price_in_checkout_button -%}
              <span class="cart-drawer__button-price">{{- cart.total_price | money -}}</span>
            {%- endif -%}
          {%- endcapture -%}

          {%- render 'button', type: 'submit', content: checkout_button, name: 'checkout', stretch: true -%}
        {%- endif -%}
      </div>
    </form>
  {%- endif -%}
</cart-drawer>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "class": "shopify-section--cart-drawer",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.page_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.cart_drawer.free_shipping_bar_info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_cart_note",
      "label": "Show Gift Note",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart_note_uk",
      "label": "Show Gift Note In Uk",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shipping_text",
      "label": "t:sections.cart_drawer.show_shipping_text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_cart_button",
      "label": "t:sections.cart_drawer.show_view_cart_button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_checkout_button",
      "label": "t:sections.cart_drawer.show_checkout_button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_in_checkout_button",
      "label": "t:sections.cart_drawer.show_price_in_checkout_button",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.cart_drawer.cross_sell_category"
    },
    {
      "type": "product_list",
      "id": "cross_sell_products",
      "label": "t:sections.cart_drawer.cross_sell_products",
      "info": "t:sections.cart_drawer.cross_sell_products_info",
      "limit": 5
    },
    {
      "type": "inline_richtext",
      "id": "cross_sell_title",
      "label": "t:sections.cart_drawer.cross_sell_heading",
      "default": "Complete with"
    },
    {
