                  <button type="button" aria-controls="facets-drawer" class="text-with-icon  collection-toolbar__button heading text-xxs w-full">
                    {{- 'collection.faceting.filter_button' | t }} {% if active_values_count > 0 %}({{ active_values_count }}){% endif -%}
                    <svg aria-hidden="true" focusable="false" fill="none" width="10" class="icon icon-chevron-down" viewBox="0 0 10 10">
      <path d="m1 3 4 4 4-4" stroke="currentColor" stroke-linecap="square"></path>
    </svg>
                  </button>
