                    {{- 'collection.faceting.filter_button' | t }} 
                      <svg width="24" height="25" viewBox="0 0 24 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <g id="expand_more_FILL0_wght500_GRAD0_opsz48 1">
                      <path id="Vector" d="M11.9999 16.0125L5.85645 9.86903L7.07492 8.65055L11.9999 13.6006L16.9249 8.67555L18.1434 9.89403L11.9999 16.0125Z" fill="black"/>
                      </g>
