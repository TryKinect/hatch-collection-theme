<script>
  (function() {
    function initHatchCommunity() {
      var sectionEl = document.getElementById('shopify-section-{{ section.id }}');
      if (!sectionEl) return;

      var cards = sectionEl.querySelectorAll('.js-hatch-video-card');
      cards.forEach(function(card) {
        var playBtn = card.querySelector('.js-hatch-play-btn');

        function getActiveVideo() {
          var isMobile = window.innerWidth < 999;
          if (isMobile) {
            var mobileVid = card.querySelector('video.hatch-community__media--mobile');
            if (mobileVid) return mobileVid;
          }
          var desktopVid = card.querySelector('video.hatch-community__media--desktop');
          if (desktopVid) return desktopVid;
          return card.querySelector('video');
        }

        function togglePlay(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          var videoEl = getActiveVideo();
          if (!videoEl) return;

          if (videoEl.paused) {
            sectionEl.querySelectorAll('video').forEach(function(v) {
              if (v !== videoEl) {
                v.pause();
                var pCard = v.closest('.js-hatch-video-card');
                if (pCard) pCard.classList.remove('is-playing');
              }
            });

            var p = videoEl.play();
            if (p && typeof p.then === 'function') {
              p.then(function() {
                card.classList.add('is-playing');
              }).catch(function(err) {
                console.log('Play failed:', err);
              });
            } else {
              card.classList.add('is-playing');
            }
          } else {
            videoEl.pause();
            card.classList.remove('is-playing');
          }
        }

        if (playBtn) {
          playBtn.addEventListener('click', togglePlay);
        }

        var videos = card.querySelectorAll('video');
        videos.forEach(function(vid) {
          vid.addEventListener('click', togglePlay);

          vid.addEventListener('play', function() {
            if (vid === getActiveVideo()) {
              card.classList.add('is-playing');
            }
          });

          vid.addEventListener('pause', function() {
            if (vid === getActiveVideo()) {
              card.classList.remove('is-playing');
            }
          });

          vid.addEventListener('ended', function() {
            card.classList.remove('is-playing');
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHatchCommunity);
    } else {
      initHatchCommunity();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initHatchCommunity();
      }
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Hatch Community",
  "class": "shopify-section--hatch-community",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hear from the Hatch Community"
    },
     {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Straight from her bathroom counter"
    },
    {
      "type": "checkbox",
      "id": "show_video_controls",
      "label": "Show Video Controls",
      "default": false
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Hatch Community"
    }
  ]
}
{% endschema %}
