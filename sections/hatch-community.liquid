           <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="hatch-community__icon--play">
<circle cx="23.8962" cy="23.8962" r="23.8962" fill="black"/>
<path d="M35.2153 23.8959L18.2365 33.6986L18.2365 14.0931L35.2153 23.8959Z" fill="#D5D7E4"/>
