<script>
  document.documentElement.style.setProperty(
    '--header-height',
    `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`
  );

   (function () {
    function initPromoDragScroll() {
      var promos = document.querySelectorAll('.mega-menu .mega-menu__promo, .header-sidebar__promo');

      promos.forEach(function (promo) {
        if (promo.dataset.dragInitialized === 'true') {
          return;
        }
        promo.dataset.dragInitialized = 'true';

        var isDown = false;
        var startX = 0;
        var startScrollLeft = 0;
        var hasDragged = false;
        var lastX = 0;
        var lastTime = 0;
        var velocity = 0;

        function updateScrollableState() {
          if (promo.scrollWidth > promo.clientWidth + 1) {
            promo.classList.add('is-scrollable');
          } else {
            promo.classList.remove('is-scrollable');
          }
        }

        promo.addEventListener('mouseenter', updateScrollableState);
        if (window.ResizeObserver) {
          new ResizeObserver(updateScrollableState).observe(promo);
        }
        updateScrollableState();

        promo.addEventListener('dragstart', function (e) {
          e.preventDefault();
        });

        promo.addEventListener('mousedown', function (e) {
          if (e.button !== 0) return;
          if (promo.scrollWidth <= promo.clientWidth + 1) return;

          isDown = true;
          hasDragged = false;
          startX = e.clientX;
          startScrollLeft = promo.scrollLeft;
          lastX = e.clientX;
          lastTime = Date.now();
          velocity = 0;

          promo.classList.add('is-dragging');
        });

        window.addEventListener('mousemove', function (e) {
          if (!isDown) return;

          var deltaX = e.clientX - startX;

          if (Math.abs(deltaX) > 4) {
            hasDragged = true;
          }

          if (hasDragged) {
            e.preventDefault();
            promo.scrollLeft = startScrollLeft - deltaX;

            var now = Date.now();
            var dt = now - lastTime;
            if (dt > 0) {
              velocity = (e.clientX - lastX) / dt;
            }
            lastX = e.clientX;
            lastTime = now;
          }
        });

        function endDrag() {
          if (!isDown) return;
          isDown = false;
          promo.classList.remove('is-dragging');

          var timeSinceLastMove = Date.now() - lastTime;
          if (timeSinceLastMove < 100 && hasDragged && Math.abs(velocity) > 0.25) {
            var momentum = velocity * 130;
            promo.scrollBy({ left: -momentum, behavior: 'smooth' });
          }

          if (hasDragged) {
            setTimeout(function () {
              hasDragged = false;
            }, 80);
          }
        }

        window.addEventListener('mouseup', endDrag);
        window.addEventListener('blur', endDrag);

        promo.addEventListener(
          'click',
          function (e) {
            if (hasDragged) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
            }
          },
          true
        );
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPromoDragScroll);
    } else {
      initPromoDragScroll();
    }

    document.addEventListener('shopify:section:load', initPromoDragScroll);
    document.addEventListener('mouseover', function (e) {
      if (e.target && e.target.closest && e.target.closest('.header__menu-disclosure, mega-menu-disclosure')) {
        initPromoDragScroll();
      }
    });

    // Ensure header-sidebar loads and stays in header, not appended to body
    function setSidebarNoAppend() {
      var customEl = window.customElements && window.customElements.get('header-sidebar');
      if (customEl && !customEl.prototype._noAppendPatched) {
        customEl.prototype._noAppendPatched = true;
        Object.defineProperty(customEl.prototype, 'shouldAppendToBody', {
          get: function() { return false; },
          configurable: true
        });
      }
    }
    setSidebarNoAppend();
    if (window.customElements && window.customElements.whenDefined) {
      window.customElements.whenDefined('header-sidebar').then(setSidebarNoAppend);
    }

    // Close menu drawer when clicking search or cart trigger, allowing search/cart to open
    document.addEventListener('click', function (e) {
      var trigger = e.target.closest('[aria-controls="cart-drawer"], [aria-controls^="header-search"], .header__search-link a, .header__cart-link a');
      if (trigger) {
        var sidebar = document.getElementById('sidebar-menu') || document.querySelector('header-sidebar');
        if (sidebar && sidebar.hasAttribute('open')) {
          sidebar.hide();
        }
      }
    }, true);

    // If search or cart drawer begins opening, ensure menu drawer is closed
    document.addEventListener('dialog:before-show', function (e) {
      var target = e.target;
      if (target && target.id !== 'sidebar-menu') {
        if (target.matches && (target.matches('cart-drawer, header-search, [id^="header-search"], #cart-drawer') || target.id === 'cart-drawer' || (target.id && target.id.indexOf('header-search') !== -1))) {
          var sidebar = document.getElementById('sidebar-menu') || document.querySelector('header-sidebar');
          if (sidebar && sidebar.hasAttribute('open')) {
            sidebar.hide();
          }
        }
      }
    });
    {%- unless section.settings.enable_sticky -%}
    // Close mega menu immediately on scroll only when header is NOT sticky (so it does not stay visible when header scrolls out of screen)
    window.addEventListener('scroll', function () {
      var headerIsSticky = window.getComputedStyle(document.documentElement).getPropertyValue('--header-is-sticky').trim() === '1';
      if (headerIsSticky) {
        return;
      }
      document.querySelectorAll('mega-menu-disclosure details[open], dropdown-menu-disclosure details[open]').forEach(function (details) {
        var disclosure = details.closest('mega-menu-disclosure, dropdown-menu-disclosure');
        if (disclosure && typeof disclosure.closeInstantly === 'function') {
          disclosure.closeInstantly();
        } else if (disclosure && typeof disclosure.toggle === 'function') {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
          disclosure.toggle(false, false);
        } else {
          details.removeAttribute('open');
          details.setAttribute('aria-expanded', 'false');
        }
      });
    }, { passive: true });
    {%- endunless -%}
    // Ensure only one menu disclosure is open at a time; close others immediately on hover of another nav item
    document.addEventListener('mouseover', function (e) {
      var navItem = e.target.closest('.header__primary-nav-item');
      if (navItem) {
        document.querySelectorAll('mega-menu-disclosure details[open], dropdown-menu-disclosure details[open]').forEach(function (details) {
          if (!navItem.contains(details)) {
            var disclosure = details.closest('mega-menu-disclosure, dropdown-menu-disclosure');
            if (disclosure && typeof disclosure.closeInstantly === 'function') {
              disclosure.closeInstantly();
            } else {
              details.removeAttribute('open');
              details.setAttribute('aria-expanded', 'false');
              if (disclosure && typeof disclosure.close === 'function') {
                disclosure.close();
              }
            }
          }
        });
      }
    }, true);
  })();
</script>

