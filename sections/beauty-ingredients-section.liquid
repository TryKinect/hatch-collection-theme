 {%- assign section_ingredient_title = product.metafields.custom.section_ingredient_title -%}
  {%- assign section_ingredient_btn = product.metafields.custom.section_ingredient_button_toggle -%}
  {%- assign section_ingredient_list = product.metafields.custom.ingredient_list -%}
  {%- assign ingredient = product.metafields.custom.ingredient_title -%}
  {%- assign ingredient_titles = product.metafields.custom.ingredient_title.value | replace: '["', '' | replace: '"]', '' | replace: '","', '|' | split: '|' -%}
  {%- assign ingredient_images = product.metafields.custom.ingredient_image.value | replace: '["', '' | replace: '"]', '' | replace: '","', '|' | split: '|' -%}
  {%- assign ingredient_texts = product.metafields.custom.ingredient_text.value | replace: '["', '' | replace: '"]', '' | replace: '","', '|' | split: '|' -%}
  <section class="section-ingredients" id="section-ingredients">
    <div class="shell-secondary container container--lg">
      <div class="section__body">
        <div class="section__content">
          {%- if section_ingredient_title != blank -%}
            <div class="section__content-head" >
              <h2 class="title-primary section__content-title">{{ section_ingredient_title }}</h2>
            </div><!-- /.section__content-head -->
          {%- endif -%}

          {%- if ingredient_titles != blank -%}
            <div class="section__content-body">
              <ul class="list-ingredients">
                {%- for ingredient_title in ingredient_titles -%}
                  {%- assign i = forloop.index0 -%}
                  {%- assign ingredient_image = ingredient_images[i] -%}
                  {%- assign ingredient_text = ingredient_texts[i] -%}

                  <li>
                    <figure>
                      {%- if ingredient_image != blank -%}
                        <img src="{{ ingredient_image }}" alt="{{ ingredient_title }}">
                      {%- endif -%}
                    </figure>

                    <div>
                      {%- if ingredient_title != blank -%}
                        <h3>{{ ingredient_title }}</h3>

                      {%- endif -%}

                      {%- if ingredient_text != blank -%}
                        <p>{{ ingredient_text | newline_to_br }}</p>
                      {%- endif -%}
                    </div>
                  </li>
                {%- endfor -%}
              </ul><!-- /.list-ingredients -->
            </div><!-- /.section__content-body -->
          {%- endif -%}

          {%- if section_ingredient_btn != blank -%}
            <div class="section__content-actions">
              <a href="#" class="js-btn-toggle btn-toggle" data-class="expanded" data-target="#section-ingredients" data-slide-target="#ingredient-text">{{ section_ingredient_btn }}</a>
            </div><!-- /.section__content-actions -->
          {%- endif -%}

          {%- if section_ingredient_list != blank -%}
            <div class="section__content-foot" id="ingredient-text" >
              <p>{{ section_ingredient_list | newline_to_br }}</p>
            </div><!-- /.section__content-foot -->
          {%- endif -%}
        </div><!-- /.section__content -->

        {%- if product.metafields.custom.why_we_love_it != blank or product.metafields.custom.how_to_use_it != blank -%}
          <aside class="section__aside">
            <div class="product-accordion-primary">
              {% include 'product_description.accordion' %}
            </div><!-- /.product-accordion-primary -->
          </aside><!-- /.section__aside -->
        {%- endif -%}
      </div><!-- /.section__body -->
    </div><!-- /.shell-secondary -->
  </section><!-- /.section-ingredients -->

  <div class="beauty_lifestyle_pdp" data-stop-sticky>
    {% include 'beauty_lifestyle_pdp' %}
  </div>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.querySelector(".js-btn-toggle");
    const box = document.querySelector("#ingredient-text");

    let open = false;

    btn.addEventListener("click", (e) => {
      e.preventDefault();

      box.style.overflow = "hidden";
      box.style.transition = "height 0.4s ease";

      if (!open) {
        box.style.display = "block";
        box.style.height = "0px";
        requestAnimationFrame(() => {
          box.style.height = box.scrollHeight + "px";
        });
        setTimeout(() => {
          box.style.height = "";
          box.style.overflow = "";
          box.style.transition = "";
        }, 400);
      } else {
        box.style.height = box.scrollHeight + "px";
        requestAnimationFrame(() => {
          box.style.height = "0px";
        });
        setTimeout(() => {
          box.style.display = "none";
          box.style.height = "";
          box.style.overflow = "";
          box.style.transition = "";
        }, 400);
      }

      open = !open;
    });
  });
document.querySelectorAll(".product_description_accordion .acc_toggle").forEach(toggle => {
  toggle.addEventListener("click", (e) => {
    e.preventDefault();

    const item = toggle.closest("li");
    const box = item.querySelector(".inner");

    const isActive = toggle.classList.contains("active");

    if (isActive) {
      // Animate closing
      box.style.height = box.scrollHeight + "px";
      box.offsetHeight; // Force reflow
      box.style.transition = "height 0.4s ease";
      box.style.height = "0px";

      box.addEventListener("transitionend", function handler() {
        box.style.display = "none";
        box.style.height = "";
        box.style.transition = "";
        toggle.classList.remove("active");
        box.removeEventListener("transitionend", handler);
      });
    } else {
      // Prepare for opening
      box.style.display = "block";
      box.style.height = "0px";
      box.offsetHeight; // Force reflow
      box.style.transition = "height 0.4s ease";
      box.style.height = box.scrollHeight + "px";

      box.addEventListener("transitionend", function handler() {
        box.style.height = "";
        box.style.transition = "";
        toggle.classList.add("active");
        box.removeEventListener("transitionend", handler);
      });
    }
  });
});

</script>

