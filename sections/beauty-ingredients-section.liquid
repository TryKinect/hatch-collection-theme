

<style>
  .product-accordion-primary {
  /*  PDP Accordion  */
}
.product-accordion-primary .product_description_accordion {
  padding-top: 17px;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  border-bottom: none;
  margin: 27px 0;
  list-style:none;
}
.product-accordion-primary .product_description_accordion li {
  position: relative;
  padding-top: 0;
  border-top: none;
  margin: 0 0 7px;
}
.product-accordion-primary .product_description_accordion li:last-child {
  margin-bottom: 0;
}
.product-accordion-primary .product_description_accordion a.acc_toggle, .product-accordion-primary .product_description_accordion a.toggle {
  display: block;
  padding: 8px 0;
  font-family: circular std;
  font-size: 16px;
  letter-spacing: 1px;
  text-transform: none;
}
.product-accordion-primary .product_description_accordion a.acc_toggle.active:after, .product-accordion-primary .product_description_accordion a.toggle.active:after {
  opacity: 1;
}
.product-accordion-primary .product_description_accordion a.acc_toggle:after, .product-accordion-primary .product_description_accordion a.toggle:after {
  padding-left: 6px;
  -webkit-transition: opacity 0.4s;
  -o-transition: opacity 0.4s;
  transition: opacity 0.4s;
  content: "+";
}
.product-accordion-primary .product_description_accordion a.acc_toggle.active:after, .product-accordion-primary .product_description_accordion a.toggle.active:after {
  content: "-";
}
.product-accordion-primary .product_description_accordion a.acc_toggle:before, .product-accordion-primary .product_description_accordion a.toggle:before {
  display: none;
}
.product-accordion-primary .product_description_accordion .inner {
  position: relative;
  padding-bottom: 7px;
  padding-left: 0;
  margin-top: 0;
  font-family: inherit;
  font-size: 13px;
  line-height: 1.95;
}
.product-accordion-primary .product_description_accordion .inner p {
