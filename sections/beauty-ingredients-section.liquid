}
.product-accordion-primary .product_description_accordion .inner p:last-child {
  margin-bottom: 0;
}
.product-accordion-primary .product_description_accordion .inner .link-primary {
  float: left;
  width: 100%;
  opacity: 0.5;
  -webkit-transition: opacity 0.4s;
  -o-transition: opacity 0.4s;
  transition: opacity 0.4s;
}
.product-accordion-primary .product_description_accordion .inner .link-primary:hover {
  opacity: 1;
}
.product-accordion-primary .product_description_accordion .inner-default--full {
  max-height: none !important;
}
.product-accordion-primary .product_description_accordion .inner-default--full + .inner-actions {
  display: none !important;
}
.product-accordion-primary .product_description_accordion .inner-default-cloned {
  position: absolute;
  left: 0;
  width: 100%;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}
.product-accordion-primary .product_description_accordion .inner-default {
  overflow: hidden;
}
.product-accordion-primary .product_description_accordion .inner-actions {
  display: none;
}
.product-accordion-primary .product_description_accordion .inner-actions .link-primary span:nth-child(2) {
  display: none;
}
.product-accordion-primary .product_description_accordion .alt .inner-default {
  max-height: 75px;
}
.product-accordion-primary .product_description_accordion .alt .inner-actions {
  display: block;
}
.product-accordion-primary .product_description_accordion .expanded .inner-default {
  max-height: none;
}
.product-accordion-primary .product_description_accordion .expanded .inner-actions .link-primary span:first-child {
  display: none;
}
.product-accordion-primary .product_description_accordion .expanded .inner-actions .link-primary span:nth-child(2) {
  display: inline;
}
.product-accordion-primary ol {
  padding-left: 0;
  list-style: none outside none;
  counter-reset: accordion-counter;
}
.product-accordion-primary ol li:before {
  padding-right: 3px;
  font-family: circular std;
  counter-increment: accordion-counter;
  content: counter(accordion-counter) ".";
}
@media (max-width: 991px) {
  .product-accordion-primary .product_description_accordion {
    padding-top: 19px;
    margin-bottom: 0;
  }
  .product-accordion-primary .product_description_accordion li {
    margin-bottom: 5px;
  }
  .product-accordion-primary .product_description_accordion .inner {
    padding-top: 3px;
  }
}











  
