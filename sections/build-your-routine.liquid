-%}

{%- if has_1 or has_2 or has_3 or has_4 or has_5 -%}
<style>
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color | default: 'transparent' }};
  }

  .build-routine__heading {
  color: #000;
font-family: Canela;
font-size: 36px;
font-style: normal;
font-weight: 100;
line-height: normal;
margin-bottom: 25px;
  }

  @media screen and (min-width: 999px) {
    .build-routine__heading {
      font-size: 36px;
      margin-bottom: 25px;
    }
  }

  .build-routine__timeline-wrap {
    position: relative;
    width: 100%;
    margin-bottom: 0;
  }

  /* Desktop timeline bar */
   .build-routine__timeline-line{display: none !important;}
  .build-routine__timeline-line,
  .build-routine__grid > div:before {
    position: absolute;
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
    background-color: #000000;
    z-index: 1;
    content: '';
    width: calc(100% + 15.6px);

  }.build-routine__grid {
    display: flex !important;
    flex-flow: row wrap;
    justify-content: center;
  }
    .build-routine__grid > div:last-child:before{content: none !important;}
.build-routine__grid>div {
    width: calc(20% - 12.5px);
}

  .build-routine__grid {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: 16px;
    padding-bottom: 12px;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    position: relative;
    z-index: 2;
  }

  .build-routine__grid::-webkit-scrollbar {
    display: none;
  }

  .build-routine__step-card {
    position: relative;
    flex: 0 0 61.5vw;
    max-width: 230px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .build-full{max-width: 100%;margin-inline: 112px !important; }
  @media screen and (min-width: 999px) {
    .build-routine__grid {
      display: grid;
      grid-template-columns: repeat({{ total_steps | default: 5 }}, minmax(0, 1fr));
      gap: 15.6px;
      overflow: visible;
      padding-bottom: 0;
    }

    .build-routine__step-card {
      flex: unset;
      max-width: 100%;
    }
  }

  .build-routine__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: #000000;
    margin-bottom: 21px;
    position: relative;
    z-index: 3;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .build-routine__step-card.is-inactive .build-routine__dot {
    background-color: #cccccc;
  }

  .build-routine__step-title {
  color:#000;
font-family: Canela;
font-size: 31.229px;
font-style: normal;
font-weight: 300;
line-height: 43.721px; /* 140% */
letter-spacing: 0.312px;
margin-bottom: 3px;
  }

  .build-routine__step-desc {
color: #000;
font-family: CircularXX;
font-size: 21.86px;
font-style: normal;
font-weight: 400;
line-height: 114%; /* 24.921px */
letter-spacing: 0.219px;
margin-bottom: 19px;
  }

  .build-routine__step-desc a {
    text-underline-offset: 3px;text-decoration: underline;
  }

  .build-routine__img-wrap {
    width: 100%;
    {% comment %} aspect-ratio: 4 / 5; {% endcomment %}
    overflow: hidden;
    background-color: #f4f4f4;
    border-radius: 0;
    margin-top: auto;
  }

  .build-routine__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media(max-width: 1000px){
    #shopify-section-{{ section.id }} {
     padding-top: 78px  !important;
     padding-bottom: 78px !important;
    }
    .build-full{max-width: 100%;margin-inline: 0 !important;padding: 0 20px;}
    .build-routine__grid{flex-wrap: nowrap !important;justify-content: flex-start !important;}
  }
</style>

<div class="container {% unless section.settings.container_size == 'full' %}container--{{ section.settings.container_size }}{% endunless %}{% if section.settings.container_size == 'full' %} build-full{% endif %}">
