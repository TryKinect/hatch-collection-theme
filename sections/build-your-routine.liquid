    <h2 class="build-routine__heading">{{ heading }}</h2>
  {%- endif -%}

  <div class="build-routine__timeline-wrap">
    <div class="build-routine__timeline-line"></div>

    <div class="build-routine__grid js-build-routine-grid-{{ section.id }}">
