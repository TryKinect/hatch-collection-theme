<script>
  (function() {
    function initBuildRoutine() {
      var gridEl = document.querySelector('.js-build-routine-grid-{{ section.id }}');
      if (!gridEl) return;

      var cards = gridEl.querySelectorAll('.js-routine-card');

      function updateActiveDotOnScroll() {
        if (window.innerWidth >= 999) {
          cards.forEach(function(card) {
            card.classList.remove('is-inactive');
          });
          return;
        }

        var scrollLeft = gridEl.scrollLeft;
        var gridWidth = gridEl.offsetWidth;

        cards.forEach(function(card) {
          var cardLeft = card.offsetLeft - gridEl.offsetLeft;
          if (cardLeft <= scrollLeft + gridWidth * 0.4) {
            card.classList.remove('is-inactive');
          } else {
            card.classList.add('is-inactive');
          }
        });
      }

      gridEl.addEventListener('scroll', updateActiveDotOnScroll, { passive: true });
      window.addEventListener('resize', updateActiveDotOnScroll, { passive: true });
      updateActiveDotOnScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBuildRoutine);
    } else {
      initBuildRoutine();
    }

    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initBuildRoutine();
      }
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Build Your Routine",
  "class": "shopify-section--build-your-routine",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your pregnancy routine"
    },
    {
      "type": "select",
      "id": "container_size",
      "label": "t:global.sizes.section_width",
      "options": [
        {
          "value": "lg",
          "label": "t:global.sizes.large"
        },
        {
          "value": "xl",
          "label": "t:global.sizes.x_large"
        },
        {
          "value": "full",
          "label": "t:global.sizes.full_width"
        }
      ],
      "default": "lg"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Build Your Routine"
    }
  ]
}
{% endschema %}
