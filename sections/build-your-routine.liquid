      {%- comment -%} Step 1 {%- endcomment -%}
      {%- if has_1 -%}
        {%- assign step_count = step_count | plus: 1 -%}
        <div class="build-routine__step-card js-routine-card" data-step="{{ step_count }}">
          <div class="build-routine__dot"></div>
          <h3 class="build-routine__step-title">Step {{ step_count }}</h3>
          {%- if txt_1 != blank -%}
            <div class="build-routine__step-desc">
              {{ txt_1 }}
            </div>
          {%- endif -%}
          {%- if img_1 != blank -%}
            <div class="build-routine__img-wrap">
              {%- if img_1.cloudinary_src != blank -%}
                <img src="{{ img_1.cloudinary_src }}" alt="{{ heading | default: 'Step image' | escape }}" class="build-routine__img" loading="lazy" width="1000">
              {%- elsif img_1.src != blank -%}
                <img src="{{ img_1.src | image_url: width: 1000 }}" alt="{{ heading | default: 'Step image' | escape }}" class="build-routine__img" loading="lazy" width="1000">
              {%- else -%}
                {{- img_1 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'build-routine__img' -}}
              {%- endif -%}
            </div>
          {%- endif -%}
