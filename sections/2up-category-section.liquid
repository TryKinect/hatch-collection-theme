{% liquid
  assign feature_is_left = false
  if section.settings.feature_side == 'left'
    assign feature_is_left = true
  endif
%}
<section
  id="fm-2up-{{ section.id }}"
  class="fm-2up"
  style="--fm-gap:{{ section.settings.grid_gap }}px;--fm-bg:{{ section.settings.background }};--fm-color:{{ section.settings.text_color }};--fm-pt:{{ section.settings.padding_top }}px;--fm-pb:{{ section.settings.padding_bottom }}px;--fm-media-bg:{{ section.settings.media_background }};--fm-ratio:{{ section.settings.card_ratio }};--fm-feature-ratio:{{ section.settings.feature_ratio }};--fm-heading-size:{{ section.settings.heading_size }}px;--fm-copy-size:{{ section.settings.copy_size }}px;--fm-card-title-size:{{ section.settings.card_title_size }}px;--fm-card-price-size:{{ section.settings.card_price_size }}px;"
>
  <div class="fm-2up__container">
    {% if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
      or section.settings.cta_label != blank
    %}
      <div class="fm-2up__header">
        <div class="fm-2up__head-left">
          {% if section.settings.eyebrow != blank %}
            <p class="fm-2up__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="fm-2up__heading">{{ section.settings.heading | escape }}</h2>
          {% endif %}
        </div>
        <div class="fm-2up__head-right">
          {% if section.settings.description != blank %}
            <div class="fm-2up__description">{{ section.settings.description }}</div>
          {% endif %}
          {% if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
            <a href="{{ section.settings.cta_url }}" class="fm-2up__cta">{{ section.settings.cta_label | escape }}</a>
          {%- endif %}
        </div>
      </div>
    {% endif %}
    <div class="fm-2up__layout{% if feature_is_left %} fm-2up__layout--reverse{% endif %}">
      <div class="fm-2up__merch">
        <div class="fm-2up__products">
          {% for block in section.blocks %}
            {% if block.type == 'product' %}
              {% assign product = block.settings.product %}
              <div class="fm-2up__product" {{ block.shopify_attributes }}>
                {% capture product_media %}
                  <div class="fm-2up__product-media">
                    {% if block.settings.media_type == 'video' and block.settings.video != blank %}
                      {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, controls: false, playsinline: true, class: 'fm-2up__media-element' }}
                    {% elsif block.settings.image != blank %}
                      {{ block.settings.image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '220, 360, 540, 750, 1100', sizes: '(min-width: 990px) 20vw, 45vw', class: 'fm-2up__media-element', alt: block.settings.image.alt }}
                      {% if block.settings.hover_image != blank %}
                        {{ block.settings.hover_image | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '220, 360, 540, 750, 1100', sizes: '(min-width: 990px) 20vw, 45vw', class: 'fm-2up__media-element fm-2up__hover-image', alt: block.settings.hover_image.alt }}
                      {% endif %}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'fm-2up__placeholder' }}
                    {% endif %}
                  </div>
                {% endcapture %}
                {% if product != blank %}
                  <a href="{{ product.url }}" class="fm-2up__product-link" aria-label="{{ product.title | escape }}">
                    {{- product_media -}}
                  </a>
                {% else %}
                  {{ product_media }}
                {% endif %}
                {% if product != blank %}
                  <div class="fm-2up__product-details">
                    {% if block.settings.show_title -%}
                      <a href="{{ product.url }}" class="fm-2up__product-title">{{ product.title | escape }}</a>
                    {%- endif %}
                    {% if block.settings.show_price %}
                      {% assign chosen_variant = product.selected_or_first_available_variant %}
                      <div class="fm-2up__prices">
                        {% if chosen_variant.compare_at_price > chosen_variant.price %}
                          <s class="fm-2up__compare-price">{{ chosen_variant.compare_at_price | money }}</s>
                        {% endif %}
                        <span class="fm-2up__price">{{ chosen_variant.price | money }}</span>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="fm-2up__bottom">
          {% if section.settings.bottom_type == 'image' %}
            {% capture bottom_content %}
              {% if section.settings.bottom_image != blank %}
                {{ section.settings.bottom_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400, 700, 1000, 1400', sizes: '(min-width: 990px) 40vw, 100vw', class: 'fm-2up__bottom-image', alt: section.settings.bottom_image.alt }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'fm-2up__placeholder' }}
              {% endif %}
            {% endcapture %}
            {% if section.settings.bottom_link != blank -%}
              <a class="fm-2up__bottom-image-wrap" href="{{ section.settings.bottom_link }}">{{ bottom_content }}</a>
            {%- else %}
              <div class="fm-2up__bottom-image-wrap">{{ bottom_content }}</div>
            {% endif %}
          {% else %}
            <div
              class="fm-2up__bottom-text"
              style="--fm-bottom-align:{{ section.settings.bottom_text_align }};--fm-bottom-font:{{ section.settings.bottom_font_size }}px;--fm-bottom-pad:{{ section.settings.bottom_text_padding }}px;--fm-bottom-bg:{{ section.settings.bottom_text_bg }};--fm-bottom-color:{{ section.settings.bottom_text_color }};"
            >
              {% if section.settings.bottom_text != blank %}
                <div class="fm-2up__bottom-richtext">{{ section.settings.bottom_text }}</div>
              {% endif %}
              {% if section.settings.bottom_attribution != blank %}
                <p class="fm-2up__attribution">{{ section.settings.bottom_attribution | escape }}</p>
              {% endif %}
              {% if section.settings.bottom_link != blank and section.settings.bottom_link_label != blank -%}
                <a href="{{ section.settings.bottom_link }}">{{ section.settings.bottom_link_label | escape }}</a>
              {%- endif %}
            </div>
          {% endif %}
        </div>
      </div>
      <div class="fm-2up__feature">
        {% capture feature_media %}
           <div class="desktop-media">
          {% if section.settings.feature_type == 'video' and section.settings.feature_video != blank %}
            {{ section.settings.feature_video | video_tag: autoplay: section.settings.video_autoplay, muted: section.settings.video_autoplay, loop: section.settings.video_loop, controls: section.settings.video_controls, playsinline: true, class: 'fm-2up__feature-element' }}
          {% elsif section.settings.feature_image != blank %}
            {{ section.settings.feature_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', class: 'fm-2up__feature-element', alt: section.settings.feature_image.alt }}
          {% else %}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'fm-2up__placeholder' }}
          {% endif %}
        </div>
        <div class="mobile-media">
          {% if section.settings.feature_type == 'video' and section.settings.mob_feature_video != blank %}
            {{ section.settings.mob_feature_video | video_tag: autoplay: section.settings.video_autoplay, muted: section.settings.video_autoplay, loop: section.settings.video_loop, controls: section.settings.video_controls, playsinline: true, class: 'fm-2up__feature-element' }}
          {% elsif section.settings.feature_image != blank %}
            {{ section.settings.mob_feature_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', class: 'fm-2up__feature-element', alt: section.settings.feature_image.alt }}
          {% else %}
                  {{ section.settings.feature_image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '500, 800, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', class: 'fm-2up__feature-element', alt: section.settings.feature_image.alt }}
          {% endif %}
        </div>
        {% endcapture %}
        {% if section.settings.feature_link != blank -%}
          <a href="{{ section.settings.feature_link }}" class="fm-2up__feature-wrap">{{ feature_media }}</a>
        {%- else %}
          <div class="fm-2up__feature-wrap">{{ feature_media }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</section>
<style>
    #fm-2up-{{ section.id }} {background:var(--fm-bg);color:var(--fm-color);padding:{{section.settings.padding_top}}px 48px {{ section.settings.padding_bottom }}px}
    #fm-2up-{{ section.id }} *{box-sizing:border-box}
    #fm-2up-{{ section.id }} .fm-2up__container{max-width:100%;margin:auto;padding:0 }
    #fm-2up-{{ section.id }} .fm-2up__header{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:{{ section.settings.heading_bottom_gap }}px}
    #fm-2up-{{ section.id }} .fm-2up__eyebrow{font-size:{{ section.settings.eyebrow_font_size }}px;font-weight: 400;line-height: normal;text-transform: uppercase;margin:0 0 9px;text-transform:uppercase;font-family: inter;}
    #fm-2up-{{ section.id }} .fm-2up__heading{font-size:{{  section.settings.heading_font_size}}px;font-family: Canela;
  font-weight: 100;
  line-height: 108%;}
    #fm-2up-{{ section.id }} .fm-2up__head-right{text-align:right;max-width:590px;font-size: {{ section.settings.intro_font_size }}px;font-family: "Circular Std";font-weight: 450;line-height: normal;letter-spacing: 0;}
    #fm-2up-{{ section.id }} .fm-2up__head-right p{margin:0 }
    #fm-2up-{{ section.id }} .fm-2up__cta{color:inherit;text-decoration:underline;color:inherit;text-decoration:underline;display:block;margin-top:12px;font-family: Inter;
  font-weight: 400;
  line-height: normal;text-underline-offset: 2px;font-size: {{  section.settings.cta_font_size }}px;}
    #fm-2up-{{ section.id }} .fm-2up__layout{display:grid;grid-template-columns:1fr 61.05%;gap:var(--fm-gap);align-items:stretch}
    #fm-2up-{{ section.id }} .fm-2up__layout--reverse{direction:rtl}
    #fm-2up-{{ section.id }} .fm-2up__layout--reverse>*{direction:ltr}
    #fm-2up-{{ section.id }} .fm-2up__merch{display:grid;grid-template-rows:1fr 1fr;gap:var(--fm-gap);min-width:0}
    #fm-2up-{{ section.id }} .fm-2up__products{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--fm-gap);min-height:0}
    #fm-2up-{{ section.id }} .fm-2up__products > .fm-2up__product:nth-child(3){grid-column:1 / -1}
    #fm-2up-{{ section.id }} .fm-2up__product{min-width:0;position:relative}
    #fm-2up-{{ section.id }} .fm-2up__product-link{display:block;color:inherit;text-decoration:none;}
      {% comment %} #fm-2up-{{ section.id }} .fm-2up__product-link .fm-2up__product-media{height: 100%;min-height: 100%;} {% endcomment %}
    #fm-2up-{{ section.id }} .fm-2up__product-media{position:relative;background:var(--fm-media-bg);overflow:hidden}
    #fm-2up-{{ section.id }} .fm-2up__media-element,#fm-2up-{{ section.id }} .fm-2up__feature-element,#fm-2up-{{ section.id }} .fm-2up__bottom-image{display:block;width:100%;height:100%;object-fit:{{ section.settings.image_fit }}}
    #fm-2up-{{ section.id }} .fm-2up__hover-image{position:absolute;inset:0;opacity:0;transition:opacity .25s}
    #fm-2up-{{ section.id }} .fm-2up__product-link:hover .fm-2up__hover-image{opacity:1}
    #fm-2up-{{ section.id }} .fm-2up__product-details{padding:5px;}
    #fm-2up-{{ section.id }} .fm-2up__product-title{font-size:{{  section.settings.product_title_font_size}}px;margin:0 0 5px;color:#000;font-family: "Circular Std";font-weight: 450;line-height: 1.53;letter-spacing: 1.17px;}
    #fm-2up-{{ section.id }} .fm-2up__prices{display:flex;gap:8px;flex-wrap:wrap;font-size:{{ section.settings.product_price_font_size}}px;margin-top:0;color: #000;letter-spacing: 9%;}
    #fm-2up-{{ section.id }} .fm-2up__compare-price{color: #535353;}
    #fm-2up-{{ section.id }} .fm-2up__bottom{min-height:0}
    #fm-2up-{{ section.id }} .fm-2up__bottom-image-wrap{display:block;height:100%;min-height:{{ section.settings.bottom_min_height }}px;overflow:hidden;background:var(--fm-media-bg)}
    #fm-2up-{{ section.id }} .fm-2up__bottom-image{object-position:{{ section.settings.bottom_image_position }}}
    #fm-2up-{{ section.id }} .fm-2up__bottom-text{height:100%;min-height:{{ section.settings.bottom_min_height }}px;background:var(--fm-bottom-bg);color:var(--fm-bottom-color);display:flex;flex-direction:column;justify-content:center;align-items:{{ section.settings.bottom_text_flex }};text-align:var(--fm-bottom-align);padding:var(--fm-bottom-pad);font-size:{{ section.settings.bottom_text_font_size}}px;font-family: Canela;
  font-weight: 100;
  line-height: 120%;
  letter-spacing: 0%;padding: 10px 46px;}
    #fm-2up-{{ section.id }} .fm-2up__bottom-richtext p{margin:0 0 16px}
    #fm-2up-{{ section.id }} .fm-2up__attribution{font-size:{{section.settings.bottom_subheading_font_size }}px;text-transform:uppercase;font-family: Inter;
  font-weight: 400;
  line-height: 100%;
  letter-spacing: 0%;
  }
    #fm-2up-{{ section.id }} .fm-2up__bottom-text a{color:inherit}
    #fm-2up-{{ section.id }} .fm-2up__feature{min-width:0;min-height:0}
    #fm-2up-{{ section.id }} .fm-2up__feature-wrap{display:block;height:100%;min-height:{{ section.settings.feature_min_height }}px;overflow:hidden;background:var(--fm-media-bg)}
    #fm-2up-{{ section.id }} .fm-2up__feature-element{object-position:{{ section.settings.feature_position }}}
    #fm-2up-{{ section.id }} .fm-2up__placeholder{width:100%;height:100%;display:block;background:#f0f0f0}
        #fm-2up-{{ section.id }} .fm-2up__feature .mobile-media{display: none;}
   #fm-2up-{{ section.id }} .fm-2up__product-title:after{content: none !important;}
    @media(min-width: 750px){
       #fm-2up-{{ section.id }} .fm-2up__product-details{opacity: 0;padding: 5px;position: absolute;bottom: 0;width: 100%;transition: opacity 0.2s ease;background: rgba(255,255,255,0.83);}
        #fm-2up-{{ section.id }} .fm-2up__product:hover .fm-2up__product-details{opacity: 1;}
          #fm-2up-{{ section.id }}  .fm-2up__produc{position: relative;}
              #fm-2up-{{ section.id }} .fm-2up__product-media video{min-height: 100%;height: 100%;object-fit: cover;}
          #fm-2up-{{ section.id }} .fm-2up__feature .desktop-media{min-height: 100%;height: 100%;}
            #fm-2up-{{ section.id }} .fm-2up__product-link{display:block;color:inherit;text-decoration:none;height: 100%;min-height: 100%;}
      #fm-2up-{{ section.id }} .fm-2up__product-link .fm-2up__product-media{height: 100%;min-height: 100%;}
        }
    @media(max-width:749px){
      #fm-2up-{{ section.id }}{padding: {{section.settings.mob_padding_top}}px 16px {{ section.settings.mob_padding_bottom }}px;}
      #fm-2up-{{ section.id }} .fm-2up__container{padding:0 }
      #fm-2up-{{ section.id }} .fm-2up__header{align-items:start;gap:12px;flex-direction:column;margin-bottom: 24px;}
      #fm-2up-{{ section.id }} .fm-2up__heading{font-size:{{ section.settings.mobile_heading_size }}px}
      #fm-2up-{{ section.id }} .fm-2up__head-right{text-align:left;max-width:100%;font-family: inter;}
      #fm-2up-{{ section.id }} .fm-2up__head-right .fm-2up__description{line-height: 150%;font-size: 14px;}
      #fm-2up-{{ section.id }} .fm-2up__layout{grid-template-columns:1fr;gap: 24px;direction:ltr}
      #fm-2up-{{ section.id }} .fm-2up__merch{grid-template-rows:auto auto;gap:24px}
      #fm-2up-{{ section.id }} .fm-2up__products{gap:{{ section.settings.mobile_gap }}px}
      #fm-2up-{{ section.id }} .fm-2up__bottom-image-wrap,#fm-2up-{{ section.id }} .fm-2up__bottom-text{height:{{ section.settings.mobile_bottom_height }}px;min-height:0}
      #fm-2up-{{ section.id }} .fm-2up__feature-wrap{height:{{ section.settings.mobile_feature_height }}px;min-height:0}
      #fm-2up-{{ section.id }} .fm-2up__feature{order:{{ section.settings.mobile_feature_order }}}
      #fm-2up-{{ section.id }} .fm-2up__merch{order:{{ section.settings.mobile_merch_order }}}
        #fm-2up-{{ section.id }} .fm-2up__feature .mobile-media{display: block;}
    #fm-2up-{{ section.id }} .fm-2up__feature .desktop-media{display: none;}
      {% comment %} #fm-2up-{{ section.id }} .fm-2up__feature .mobile-media{min-height: 100%;height: 100%;} {% endcomment %}
      #fm-2up-{{ section.id }} .fm-2up__bottom-text{padding: 5px 12px;font-size: {{  section.settings.mob_bottom_text_font_size}}px;line-height: 1.4;}
       #fm-2up-{{ section.id }} .fm-2up__attribution{font-size: {{  section.settings.mob_bottom_subheading_font_size}}px;}
         #fm-2up-{{ section.id }} .fm-2up__bottom-richtext p{margin:0 0 20px}
         #fm-2up-{{ section.id }} .fm-2up__product-details{padding: 8px 0 0;}
           #fm-2up-{{ section.id }} .fm-2up__eyebrow{font-size: {{ section.settings.mob_eyebrow_font_size}}px;}
    #fm-2up-{{ section.id }} .fm-2up__heading{font-size:  {{ section.settings.mob_heading_font_size}}px;}
    #fm-2up-{{ section.id }} .fm-2up__head-right{font-size: {{ section.settings.mob_intro_font_size}}px;}
    #fm-2up-{{ section.id }} .fm-2up__cta{font-size: {{ section.settings.mob_cta_font_size}}px;}
      #fm-2up-{{ section.id }} .fm-2up__product-title{font-size: {{ section.settings.mob_product_title_font_size}}px;}
    #fm-2up-{{ section.id }} .fm-2up__prices{font-size: {{ section.settings.mob_product_price_font_size}}px;}

  }
</style>
{% schema %}
{
  "name": "2 Up Category",
  "tag": "section",
  "class": "fm-2up-section",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CLEAN, MODERN, AND EASY." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "2 Up With Image" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A streamlined silhouette with a modern fit and a polished finish for everyday styling.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "SHOP SLIM DENIM" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    
    {
      "type": "range",
      "id": "heading_bottom_gap",
      "label": "Gap below heading",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    { "type": "header", "content": "Bottom left content" },
    {
      "type": "select",
      "id": "bottom_type",
      "label": "Bottom content type",
      "options": [
        { "value": "image", "label": "Static image" },
        { "value": "text", "label": "Text" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "bottom_image", "label": "Bottom static image" },
    {
      "type": "select",
      "id": "bottom_image_position",
      "label": "Bottom image position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "richtext",
      "id": "bottom_text",
      "label": "Bottom text",
      "default": "<p>Never thought it would be so difficult to find good maternity clothes, thank god we have Hatch in NYC.</p>"
    },
    { "type": "text", "id": "bottom_attribution", "label": "Text attribution", "default": "ABBY, VERIFIED BUYER" },
    {
      "type": "select",
      "id": "bottom_text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "bottom_text_flex",
      "label": "Text horizontal placement",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "flex-start"
    },
   
    { "type": "color", "id": "bottom_text_bg", "label": "Bottom text background", "default": "#ffffff" },
    { "type": "color", "id": "bottom_text_color", "label": "Bottom text color", "default": "#222222" },
    { "type": "url", "id": "bottom_link", "label": "Bottom image/text optional link" },
    { "type": "text", "id": "bottom_link_label", "label": "Text link label" },
    {
      "type": "range",
      "id": "bottom_min_height",
      "label": "Bottom minimum height",
      "min": 100,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 240
    },
    { "type": "header", "content": "Right feature media" },
    {
      "type": "select",
      "id": "feature_type",
      "label": "Feature media type",
      "options": [
        { "value": "image", "label": "Static image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    { "type": "image_picker", "id": "feature_image", "label": "Feature image" },
    { "type": "video", "id": "feature_video", "label": "Feature Shopify video" },
    { "type": "image_picker", "id": "mob_feature_image", "label": "Mobile Feature image" },
    { "type": "video", "id": "mob_feature_video", "label": "Mobile Shopify-hosted video" },
    { "type": "url", "id": "feature_link", "label": "Feature optional link" },
    { "type": "checkbox", "id": "video_autoplay", "label": "Video autoplay (muted)", "default": true },
    { "type": "checkbox", "id": "video_loop", "label": "Loop video", "default": true },
    { "type": "checkbox", "id": "video_controls", "label": "Show video controls", "default": false },
    {
      "type": "select",
      "id": "feature_position",
      "label": "Feature focal position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "feature_min_height",
      "label": "Feature minimum height",
      "min": 200,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    { "type": "header", "content": "Layout and cards" },
    {
      "type": "select",
      "id": "feature_side",
