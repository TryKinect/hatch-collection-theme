{% doc %}
  @prompt
    Generate a full width image banner. 
    On desktop, the background is a full width image. There is a subheading that is right justified and centered vertically. The headline is left justified and centered vertically. There is body copy below the headline. There is an underlined CTA below the body copy. 
    
    On mobile, the subheading, headline, and body copy are center justified and at the top of the frame. The shop now button is center justified and at the bottom of the frame. 
    Font options are customizable. CTA options are customizable., On the mobile version, the subheading, heading, and body copy should all be grouped together at the top. The CTA should be at the bottom of the frame., On desktop, the CTA should be left justified underneath the body copy. Do not change the text or CTA  placement on mobile., On Mobile, move the CTA to the bottom of the frame, Allow seperate image inputs for desktop and mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.banner_height_mobile }}px;
    display: block;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.banner_height_desktop }}px;
    }
  }

  .ai-image-banner-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  min-height: {{ block.settings.banner_height_mobile }}px;
  display: block;
  overflow: hidden; /* ← add this line */
}

  .ai-image-banner-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-image-banner-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-banner-background-mobile-{{ ai_gen_id }} {
    display: block;
  }

  .ai-image-banner-background-desktop-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-background-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-banner-background-desktop-{{ ai_gen_id }} {
      display: block;
    }
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-image-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-image-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-image-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 2;
  }

  .ai-image-banner-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    padding: {{ block.settings.padding_mobile }}px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: {{ block.settings.banner_height_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-content-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_desktop }}px;
      min-height: {{ block.settings.banner_height_desktop }}px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .ai-image-banner-text-group-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-text-group-{{ ai_gen_id }} {
      max-width: {{ block.settings.content_width }}%;
      flex: 1;
      text-align: left;
    }
  }

  .ai-image-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size_mobile }}px;
    margin: 0;
    font-family: '{{ block.settings.subheading_font }}', sans-serif;
    text-transform: {{ block.settings.subheading_text_transform }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
    }
  }

  .ai-image-banner-subheading-desktop-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-subheading-mobile-{{ ai_gen_id }} {
      display: none;
    }

    .ai-image-banner-subheading-desktop-{{ ai_gen_id }} {
      display: block;
      position: absolute;
      right: {{ block.settings.padding_desktop }}px;
      top: 50%;
      transform: translateY(-50%);
      text-align: right;
      max-width: {{ block.settings.subheading_max_width }}%;
      color: {{ block.settings.subheading_color }};
      font-size: {{ block.settings.subheading_size_desktop }}px;
      margin: 0;
      font-family: '{{ block.settings.subheading_font }}', sans-serif;
      text-transform: {{ block.settings.subheading_text_transform }};
      letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
    }
  }

  .ai-image-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
    margin: 0;
    font-family: '{{ block.settings.heading_font }}', sans-serif;
    text-transform: {{ block.settings.heading_text_transform }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    line-height: 1.2;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-image-banner-body-{{ ai_gen_id }} {
    color: {{ block.settings.body_color }};
    font-size: {{ block.settings.body_size_mobile }}px;
    margin: 0;
    font-family: '{{ block.settings.body_font }}', sans-serif;
    line-height: 1.6;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_size_desktop }}px;
    }
  }

  .ai-image-banner-cta-container-mobile-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
    padding-bottom: {{ block.settings.cta_bottom_spacing_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-cta-container-mobile-{{ ai_gen_id }} {
      display: none;
    }
  }

  .ai-image-banner-cta-container-desktop-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-cta-container-desktop-{{ ai_gen_id }} {
      width: auto;
      display: flex;
      justify-content: flex-start;
    }
  }

  .ai-image-banner-cta-{{ ai_gen_id }} {
    color: {{ block.settings.cta_color }};
    font-size: {{ block.settings.cta_size_mobile }}px;
    font-family: '{{ block.settings.cta_font }}', sans-serif;
    text-transform: {{ block.settings.cta_text_transform }};
    letter-spacing: {{ block.settings.cta_letter_spacing }}px;
    text-decoration: underline;
    text-underline-offset: {{ block.settings.underline_offset }}px;
    text-decoration-thickness: {{ block.settings.underline_thickness }}px;
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease;
    padding: 0;
    display: inline-block;
  }

  @media screen and (min-width: 750px) {
    .ai-image-banner-cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_size_desktop }}px;
    }
  }

  .ai-image-banner-cta-{{ ai_gen_id }}:hover {
    opacity: {{ block.settings.cta_hover_opacity }};
  }
{% endstyle %}

<ai-image-banner-{{ ai_gen_id }} class="ai-image-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-banner-wrapper-{{ ai_gen_id }}">
    <div class="ai-image-banner-background-{{ ai_gen_id }}">
      <div class="ai-image-banner-background-mobile-{{ ai_gen_id }}">
        {% if block.settings.background_image_mobile %}
          <img
            src="{{ block.settings.background_image_mobile | image_url: width: 1000 }}"
            srcset="{{ block.settings.background_image_mobile | image_url: width: 500 }} 500w,
                    {{ block.settings.background_image_mobile | image_url: width: 750 }} 750w,
                    {{ block.settings.background_image_mobile | image_url: width: 1000 }} 1000w"
            sizes="100vw"
            alt="{{ block.settings.background_image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_mobile.width }}"
            height="{{ block.settings.background_image_mobile.height }}"
          >
        {% elsif block.settings.background_image_desktop %}
          <img
            src="{{ block.settings.background_image_desktop | image_url: width: 1000 }}"
            srcset="{{ block.settings.background_image_desktop | image_url: width: 500 }} 500w,
                    {{ block.settings.background_image_desktop | image_url: width: 750 }} 750w,
                    {{ block.settings.background_image_desktop | image_url: width: 1000 }} 1000w"
            sizes="100vw"
            alt="{{ block.settings.background_image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_desktop.width }}"
            height="{{ block.settings.background_image_desktop.height }}"
          >
        {% else %}
          <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
              Next, add mobile image
            </div>
          </div>
        {% endif %}
      </div>

      <div class="ai-image-banner-background-desktop-{{ ai_gen_id }}">
        {% if block.settings.background_image_desktop %}
          <img
            src="{{ block.settings.background_image_desktop | image_url: width: 2400 }}"
            srcset="{{ block.settings.background_image_desktop | image_url: width: 1000 }} 1000w,
                    {{ block.settings.background_image_desktop | image_url: width: 1500 }} 1500w,
                    {{ block.settings.background_image_desktop | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ block.settings.background_image_desktop.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_desktop.width }}"
            height="{{ block.settings.background_image_desktop.height }}"
          >
        {% elsif block.settings.background_image_mobile %}
          <img
            src="{{ block.settings.background_image_mobile | image_url: width: 2400 }}"
            srcset="{{ block.settings.background_image_mobile | image_url: width: 1000 }} 1000w,
                    {{ block.settings.background_image_mobile | image_url: width: 1500 }} 1500w,
                    {{ block.settings.background_image_mobile | image_url: width: 2400 }} 2400w"
            sizes="100vw"
            alt="{{ block.settings.background_image_mobile.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.background_image_mobile.width }}"
            height="{{ block.settings.background_image_mobile.height }}"
          >
        {% else %}
          <div class="ai-image-banner-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-image-banner-empty-state-{{ ai_gen_id }}">
              Next, add desktop image
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    {% if block.settings.show_overlay %}
      <div class="ai-image-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}

    <div class="ai-image-banner-content-{{ ai_gen_id }}">
      <div class="ai-image-banner-text-group-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <div class="ai-image-banner-subheading-{{ ai_gen_id }} ai-image-banner-subheading-mobile-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-image-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.body_text != blank %}
          <div class="ai-image-banner-body-{{ ai_gen_id }}">{{ block.settings.body_text }}</div>
        {% endif %}

        {% if block.settings.cta_text != blank %}
          <div class="ai-image-banner-cta-container-desktop-{{ ai_gen_id }}">
            {% if block.settings.cta_link != blank %}
              <a href="{{ block.settings.cta_link }}" class="ai-image-banner-cta-{{ ai_gen_id }}">
                {{ block.settings.cta_text }}
              </a>
            {% else %}
              <span class="ai-image-banner-cta-{{ ai_gen_id }}">{{ block.settings.cta_text }}</span>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if block.settings.subheading != blank %}
        <div class="ai-image-banner-subheading-desktop-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <div class="ai-image-banner-cta-container-mobile-{{ ai_gen_id }}">
          {% if block.settings.cta_link != blank %}
            <a href="{{ block.settings.cta_link }}" class="ai-image-banner-cta-{{ ai_gen_id }}">
              {{ block.settings.cta_text }}
            </a>
          {% else %}
            <span class="ai-image-banner-cta-{{ ai_gen_id }}">{{ block.settings.cta_text }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</ai-image-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class AIImageBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('ai-image-banner-{{ ai_gen_id }}', AIImageBanner{{ ai_gen_id }});
  })();
</script>

