{% doc %}
  @prompt
    Create a module that is 4 columns and 2 rows on desktop. 2 columbs and 4 rows on mobile. Each spot you should be able to select if it's product, image, or video, Make centered on desktop. Add customization for product title font.
    
    If the item type is product, allow the image to override the product lead image., For product, keep image size the same as the rest of the grid, push title down below image and add height to the row
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-module-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 20px;
  }

  .ai-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: {{ block.settings.grid_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-grid-item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-grid-item-content-{{ ai_gen_id }} {
    aspect-ratio: {{ block.settings.item_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-grid-item-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grid-item-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-grid-item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-grid-item-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-grid-item-product-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-grid-item-product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.product_info_padding }}px;
    background-color: {{ block.settings.product_info_bg_color }};
    margin-top: {{ block.settings.product_info_spacing }}px;
  }

  .ai-grid-item-product-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_title_font }};
    font-size: {{ block.settings.product_title_size }}px;
    color: {{ block.settings.product_title_color }};
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .ai-grid-item-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto auto auto;
    }
  }
{% endstyle %}

<div class="ai-grid-module-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign item_type_key = 'item_' | append: i | append: '_type'
        assign item_product_key = 'item_' | append: i | append: '_product'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_video_key = 'item_' | append: i | append: '_video'
        assign item_override_image_key = 'item_' | append: i | append: '_override_image'

        assign item_type = block.settings[item_type_key]
        assign item_product = block.settings[item_product_key]
        assign item_image = block.settings[item_image_key]
        assign item_video = block.settings[item_video_key]
        assign item_override_image = block.settings[item_override_image_key]
      %}

      <div class="ai-grid-item-{{ ai_gen_id }}">
        {% if item_type == 'product' %}
          {% if item_product != blank %}
            <div class="ai-grid-item-content-{{ ai_gen_id }}">
              <div class="ai-grid-item-product-image-wrapper-{{ ai_gen_id }}">
                {% if item_override_image != blank %}
                  <img
                    src="{{ item_override_image | image_url: width: 800 }}"
                    alt="{{ item_override_image.alt | escape }}"
                    class="ai-grid-item-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ item_override_image.width }}"
                    height="{{ item_override_image.height }}"
                  >
                {% elsif item_product.featured_image %}
                  <img
                    src="{{ item_product.featured_image | image_url: width: 800 }}"
                    alt="{{ item_product.featured_image.alt | escape }}"
                    class="ai-grid-item-image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="{{ item_product.featured_image.width }}"
                    height="{{ item_product.featured_image.height }}"
                  >
                {% else %}
                  <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
            {% if block.settings.show_product_info %}
              <div class="ai-grid-item-product-info-{{ ai_gen_id }}">
                <h3 class="ai-grid-item-product-title-{{ ai_gen_id }}">{{ item_product.title }}</h3>
                <div class="ai-grid-item-product-price-{{ ai_gen_id }}">{{ item_product.price | money }}</div>
              </div>
            {% endif %}
          {% else %}
            <div class="ai-grid-item-content-{{ ai_gen_id }}">
              <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}
        {% elsif item_type == 'image' %}
          <div class="ai-grid-item-content-{{ ai_gen_id }}">
            {% if item_image != blank %}
              <img
                src="{{ item_image | image_url: width: 800 }}"
                alt="{{ item_image.alt | escape }}"
                class="ai-grid-item-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ item_image.width }}"
                height="{{ item_image.height }}"
              >
            {% else %}
              <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
             {% elsif item_type == 'video' %}
   {% if video != blank %}
              <video
                src="{{ video }}"
                autoplay
                muted
                loop
                playsinline
              ></video>
            {% else %}
              <div class="ai-grid-item-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

