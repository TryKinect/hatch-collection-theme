{% comment %} {% doc %}
  @prompt
    Row spans full desktop width (100%), tall height approximately 500px. It contains two columns. Both columns blocks contain 1px black stroke outline. Columns stacked on mobile.
    
    - Column A: video block, 50% width, video link to CDN, no padding
    - Column B: 50% width, contains padding. Title block centered at top. Below title: image block, centered, medium size relative to column (about 40% of column height). Text block below. Underlined shop now button. 
    Background #FAEFEA. 
      
    
    , Increase the height of image in block two. content should always be centered horizontally in block 2 . 
{% enddoc %} {% endcomment %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-row-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    min-height: {{ block.settings.row_height }}px;
  }

  .ai-two-column-row__container-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    min-height: {{ block.settings.row_height }}px;
  }

  .ai-two-column-row__column-{{ ai_gen_id }} {
    flex: 1;
    border: 1px solid #000000;
  }

  .ai-two-column-row__column--video-{{ ai_gen_id }} {
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  .ai-two-column-row__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.row_height }}px;
  }

  .ai-two-column-row__video-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-two-column-row__video-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.row_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-two-column-row__video-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-two-column-row__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-two-column-row__column--content-{{ ai_gen_id }} {
    background-color: {{ block.settings.content_background }};
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-two-column-row__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    text-align: center;
    margin: 0;
    width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-two-column-row__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_width }}%;
    display: flex;
    justify-content: center;
  }

  .ai-two-column-row__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
  }

  .ai-two-column-row__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-two-column-row__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-two-column-row__text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    text-align: center;
    width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-two-column-row__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: underline;
    border: none;
    cursor: pointer;
    font-size: {{ block.settings.button_text_size }}px;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-row__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-two-column-row__container-{{ ai_gen_id }} .two-colume-price sale-price{
    font-size: 14px;
    width: 100%;
    color: #000000;
    font-weight: 400 !important;
    font-family: CircularXX, sans-serif;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-row__container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-two-column-row__column-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-two-column-row__video-wrapper-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-two-column-row__video-placeholder-{{ ai_gen_id }} {
      min-height: 300px;
    }
  }
{% endstyle %}

<two-column-row-{{ ai_gen_id }}
  class="ai-two-column-row-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-two-column-row__container-{{ ai_gen_id }}">
    <div class="ai-two-column-row__column-{{ ai_gen_id }} ai-two-column-row__column--video-{{ ai_gen_id }}">
      {% if block.settings.video_url != blank %}
        <div class="ai-two-column-row__video-wrapper-{{ ai_gen_id }}">
          <video
            class="ai-two-column-row__video-{{ ai_gen_id }}"
            autoplay
            muted
            loop
            playsinline
          >
            <source src="{{ block.settings.video_url }}" type="video/mp4">
          </video>
        </div>
      {% else %}
        <div class="ai-two-column-row__video-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
          <div class="ai-two-column-row__empty-state-{{ ai_gen_id }}">
            Next, add a video URL
          </div>
        </div>
      {% endif %}
    </div>

    <div class="ai-two-column-row__column-{{ ai_gen_id }} ai-two-column-row__column--content-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-two-column-row__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      <div class="ai-two-column-row__image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-two-column-row__image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-two-column-row__image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.text != blank %}
        <div class="ai-two-column-row__text-{{ ai_gen_id }}">{{ block.settings.text }}</div>
      {% endif %}

      {% if block.settings.show_price %}
      <div class="two-colume-price">
        {%- render 'price-list', product: block.settings.product, context: 'card' -%}
      </div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a
          href="{{ block.settings.button_link }}"
          class="ai-two-column-row__button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>
</two-column-row-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnRow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        const video = this.querySelector('.ai-two-column-row__video-{{ ai_gen_id }}');
        if (video) {
          video.play().catch(function() {});
        }
      }
    }

    customElements.define('two-column-row-{{ ai_gen_id }}', TwoColumnRow{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two column row",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Row height",
      "min": 300,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Video column"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL"
    },
    {
      "type": "header",
      "content": "Content column"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "Background color",
      "default": "#FAEFEA"
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Padding",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Spacing between elements",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Discover Our Collection"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Explore our latest styles and find your perfect fit.</p>"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Select the product for which you want the price to be displayed dynamically."
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": false
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
