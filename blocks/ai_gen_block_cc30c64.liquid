{% doc %}
  @prompt
    Generate a block with a heading and a five column grid below. The grid is 50% of the width of desktop and centered within the module. Each module in the grid has an image, and two body text blocks below with adjustable padding between the elements.
    
    On mobile the 5 column grid scrolls horizontally while the title stays static. 
    
    The background for the entire module is a gradient, The image containers should be circular. Add input for adjusting image size, the module should be centered on desktop, the 5 grid should be centered on desktop
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-module-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.gradient_start }};
    background: linear-gradient({{ block.settings.gradient_angle }}deg, {{ block.settings.gradient_start }}, {{ block.settings.gradient_end }});
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-grid-module__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-grid-module__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    width: 100%;
  }

  .ai-grid-module__grid-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    overflow: visible;
  }

  .ai-grid-module__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    justify-items: center;
  }

  .ai-grid-module__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-grid-module__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin-bottom: {{ block.settings.image_bottom_spacing }}px;
    position: relative;
    overflow: hidden;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ai-grid-module__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-grid-module__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .ai-grid-module__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-grid-module__text-1-{{ ai_gen_id }} {
    color: {{ block.settings.text_1_color }};
    font-size: {{ block.settings.text_1_size }}px;
    margin-bottom: {{ block.settings.text_1_bottom_spacing }}px;
    line-height: 1.4;
    text-align: center;
  }

  .ai-grid-module__text-2-{{ ai_gen_id }} {
    color: {{ block.settings.text_2_color }};
    font-size: {{ block.settings.text_2_size }}px;
    line-height: 1.4;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-grid-module__grid-wrapper-{{ ai_gen_id }} {
      width: 100%;
      overflow-x: auto;
      overflow-y: visible;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .ai-grid-module__grid-{{ ai_gen_id }} {
      width: auto;
      min-width: 100%;
      grid-template-columns: repeat(5, {{ block.settings.mobile_column_width }}px);
      padding-bottom: 10px;
    }

    .ai-grid-module__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.7);
    }

    .ai-grid-module__image-wrapper-{{ ai_gen_id }} {
      width: calc({{ block.settings.image_size }}px * 0.8);
      height: calc({{ block.settings.image_size }}px * 0.8);
    }

    .ai-grid-module__text-1-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_1_size }}px * 0.9);
    }

    .ai-grid-module__text-2-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.text_2_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-grid-module-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-module__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-grid-module__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-grid-module__grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-grid-module__grid-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'item_' | append: i | append: '_image'
            assign text_1_key = 'item_' | append: i | append: '_text_1'
            assign text_2_key = 'item_' | append: i | append: '_text_2'
            
            assign item_image = block.settings[image_key]
            assign item_text_1 = block.settings[text_1_key]
            assign item_text_2 = block.settings[text_2_key]
          %}

          <div class="ai-grid-module__item-{{ ai_gen_id }}">
            <div class="ai-grid-module__image-wrapper-{{ ai_gen_id }}">
              {% if item_image %}
                <img
                  src="{{ item_image | image_url: width: 600 }}"
                  alt="{{ item_image.alt | escape }}"
                  loading="lazy"
                  width="{{ item_image.width }}"
                  height="{{ item_image.height }}"
                  class="ai-grid-module__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-grid-module__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if item_text_1 != blank %}
              <div class="ai-grid-module__text-1-{{ ai_gen_id }}">
                {{ item_text_1 }}
              </div>
            {% endif %}

            {% if item_text_2 != blank %}
              <div class="ai-grid-module__text-2-{{ ai_gen_id }}">
                {{ item_text_2 }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
