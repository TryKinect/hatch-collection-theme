{% doc %}
  @prompt
    Generate a block with a heading and a four column grid below. The grid is 50% of the width of desktop and centered within the module. Each module in the grid has an image, and two body text blocks below with adjustable padding between the elements.
    
    On mobile the 4 column grid scrolls horizontally while the title stays static. 
    
    The background for the entire module is a gradient
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-grid-module-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.gradient_start }};
    background: linear-gradient(
      {{ block.settings.gradient_angle }}deg,
      {{ block.settings.gradient_start }} 0%,
      {{ block.settings.gradient_end }} 100%
    );
    padding: {{ block.settings.module_padding_top }}px 20px {{ block.settings.module_padding_bottom }}px;
  }

  .ai-grid-module__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-grid-module__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 0 {{ block.settings.heading_bottom_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-grid-module__grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .ai-grid-module__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 50%;
  }

  .ai-grid-module__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-grid-module__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.image_text_spacing }}px;
  }

  .ai-grid-module__image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-grid-module__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-grid-module__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-grid-module__text-1-{{ ai_gen_id }} {
    margin: 0 0 {{ block.settings.text_spacing }}px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_1_size }}px;
    line-height: 1.4;
  }

  .ai-grid-module__text-2-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_2_size }}px;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-grid-module__grid-wrapper-{{ ai_gen_id }} {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .ai-grid-module__grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-grid-module__grid-{{ ai_gen_id }} {
      width: auto;
      min-width: 100%;
      grid-template-columns: repeat(4, minmax(200px, 1fr));
      padding-right: 20px;
    }
  }
{% endstyle %}

<grid-module-{{ ai_gen_id }} class="ai-grid-module-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-grid-module__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-grid-module__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-grid-module__grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-grid-module__grid-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign image_key = 'item_' | append: i | append: '_image'
            assign text_1_key = 'item_' | append: i | append: '_text_1'
            assign text_2_key = 'item_' | append: i | append: '_text_2'
            assign image = block.settings[image_key]
            assign text_1 = block.settings[text_1_key]
            assign text_2 = block.settings[text_2_key]
          %}

          <div class="ai-grid-module__item-{{ ai_gen_id }}">
            <div class="ai-grid-module__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-grid-module__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-grid-module__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if text_1 != blank %}
              <p class="ai-grid-module__text-1-{{ ai_gen_id }}">{{ text_1 }}</p>
            {% endif %}

            {% if text_2 != blank %}
              <p class="ai-grid-module__text-2-{{ ai_gen_id }}">{{ text_2 }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</grid-module-{{ ai_gen_id }}>

<script>
  (function() {
    class GridModule{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupMobileScroll();
      }

      setupMobileScroll() {
        const wrapper = this.querySelector('.ai-grid-module__grid-wrapper-{{ ai_gen_id }}');
        if (!wrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        wrapper.addEventListener('mousedown', (e) => {
          if (window.innerWidth > 749) return;
          isDown = true;
          startX = e.pageX - wrapper.offsetLeft;
          scrollLeft = wrapper.scrollLeft;
        });

        wrapper.addEventListener('mouseleave', () => {
          isDown = false;
        });

        wrapper.addEventListener('mouseup', () => {
          isDown = false;
        });

        wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          if (window.innerWidth > 749) return;
          e.preventDefault();
          const x = e.pageX - wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          wrapper.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('grid-module-{{ ai_gen_id }}', GridModule{{ ai_gen_id }});
  })();
</script>

