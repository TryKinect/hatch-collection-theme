{% doc %}
  @prompt
    Create a module that is 4 containers across on desktop. 2 across on mobile. Each spot you should be able to select if it's product, image, or video. Make centered on desktop and mobile.  Add customization for product title font and padding. Add override image for product. All modules should be the same size and ratio.  All modules should be portrait orientation.
    , product name and price should be below the image
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-media-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-media-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-media-grid__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .ai-media-grid__media-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .ai-media-grid__item-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-grid__item-video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-grid__item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-media-grid__item-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-media-grid__product-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-media-grid__product-info-{{ ai_gen_id }} {
    padding: {{ block.settings.product_title_padding }}px;
    text-align: center;
  }

  .ai-media-grid__product-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_title_font }};
    font-size: {{ block.settings.product_title_font_size }}px;
    margin: 0 0 8px 0;
    color: #000000;
  }

  .ai-media-grid__product-price-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_title_font }};
    font-size: {{ block.settings.product_price_font_size }}px;
    margin: 0;
    color: #000000;
  }

  @media screen and (max-width: 749px) {
    .ai-media-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstyle %}

<media-grid-{{ ai_gen_id }} class="ai-media-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-media-grid__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign content_type_key = 'item_' | append: i | append: '_type'
        assign product_key = 'item_' | append: i | append: '_product'
        assign image_key = 'item_' | append: i | append: '_image'
        assign video_key = 'item_' | append: i | append: '_video'
        assign override_image_key = 'item_' | append: i | append: '_override_image'

        assign content_type = block.settings[content_type_key]
        assign product = block.settings[product_key]
        assign image = block.settings[image_key]
        assign video = block.settings[video_key]
        assign override_image = block.settings[override_image_key]
      %}

      <div class="ai-media-grid__item-{{ ai_gen_id }}">
        {% if content_type == 'product' %}
          {% if product != blank %}
            <div class="ai-media-grid__media-wrapper-{{ ai_gen_id }}">
              {% if override_image != blank %}
                <img
                  src="{{ override_image | image_url: width: 800 }}"
                  alt="{{ override_image.alt | escape }}"
                  loading="lazy"
                  width="{{ override_image.width }}"
                  height="{{ override_image.height }}"
                  class="ai-media-grid__product-image-{{ ai_gen_id }}"
                >
              {% elsif product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 800 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  class="ai-media-grid__product-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-media-grid__item-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <div class="ai-media-grid__product-info-{{ ai_gen_id }}">
              <h3 class="ai-media-grid__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
              <p class="ai-media-grid__product-price-{{ ai_gen_id }}">{{ product.price | money }}</p>
            </div>
          {% else %}
            <div class="ai-media-grid__media-wrapper-{{ ai_gen_id }}">
              <div class="ai-media-grid__item-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}
        {% elsif content_type == 'image' %}
          <div class="ai-media-grid__media-wrapper-{{ ai_gen_id }}">
            {% if image != blank %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-media-grid__item-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-media-grid__item-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% elsif content_type == 'video' %}
          <div class="ai-media-grid__media-wrapper-{{ ai_gen_id }}">
            {% if video != blank %}
              <video
                src="{{ video.sources[0].url }}"
                class="ai-media-grid__item-video-{{ ai_gen_id }}"
                autoplay
                loop
                muted
                playsinline
              ></video>
            {% else %}
              <div class="ai-media-grid__item-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</media-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class MediaGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.videos = this.querySelectorAll('.ai-media-grid__item-video-{{ ai_gen_id }}');
        this.setupVideos();
      }

      setupVideos() {
        this.videos.forEach((video) => {
          video.addEventListener('loadedmetadata', () => {
            video.play().catch(() => {});
          });
        });
      }
    }

    customElements.define('media-grid-{{ ai_gen_id }}', MediaGrid{{ ai_gen_id }});
  })();
</script>

