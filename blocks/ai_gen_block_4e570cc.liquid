{% doc %}
  @prompt
    A button that is centered on the page. Add option to change BUTTON Color, type, and link AND BACKGROUND COLOR OF ENTIRE MODULE
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-centered-button-module-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
  }

  .ai-centered-button-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ai-centered-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 40px;
    text-decoration: none;
    font-family: "{{ settings.font_family_button }}";
    font-size: 14px;
    letter-spacing: {{ settings.button_letter_spacing }}%;
    text-transform: {{ settings.button_text_transform }};
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  {% if block.settings.button_type == 'primary' %}
    .ai-centered-button-{{ ai_gen_id }} {
      background-color: {{ block.settings.button_color }};
      color: {{ block.settings.button_text_color }};
      border-radius: {{ settings.button_border_radius }}px;
    }

    .ai-centered-button-{{ ai_gen_id }}:hover {
      opacity: 0.85;
    }
  {% elsif block.settings.button_type == 'secondary' %}
    .ai-centered-button-{{ ai_gen_id }} {
      background-color: transparent;
      color: {{ block.settings.button_color }};
      border: 2px solid {{ block.settings.button_color }};
      border-radius: {{ settings.button_border_radius }}px;
    }

    .ai-centered-button-{{ ai_gen_id }}:hover {
      background-color: {{ block.settings.button_color }};
      color: {{ block.settings.button_text_color }};
    }
  {% elsif block.settings.button_type == 'text' %}
    .ai-centered-button-{{ ai_gen_id }} {
      background-color: transparent;
      color: {{ block.settings.button_color }};
      border-radius: 0;
      padding: 0;
      text-decoration: underline;
    }

    .ai-centered-button-{{ ai_gen_id }}:hover {
      opacity: 0.7;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-centered-button-module-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-centered-button-{{ ai_gen_id }} {
      padding: 12px 30px;
      font-size: 13px;
    }
  }
{% endstyle %}

<div class="ai-centered-button-module-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-centered-button-container-{{ ai_gen_id }}">
    {% if block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-centered-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% else %}
      <span class="ai-centered-button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </span>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Centered button",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Module background"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_type",
      "label": "Button type",
      "options": [
        {
          "value": "primary",
          "label": "Primary"
        },
        {
          "value": "secondary",
          "label": "Secondary"
        },
        {
          "value": "text",
          "label": "Text link"
        }
      ],
      "default": "primary"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff",
      "info": "Applies to primary button type"
    }
  ],
  "presets": [
    {
      "name": "Centered button"
    }
  ]
}
{% endschema %}