{% doc %}
  @prompt
    A section that is three columns on desktop with 20px gutter between them. Two right columns have input for video or image. the left column has text. Subtitle and title are enter left justified. Body copy and CTA are bottom left justified. 
    
    Subtitle and body copy are Circular. Size,color, and weight are adjustable.
    
    Title is Canela . Size, color, and weight are adjustable. color for desktop and mobile is adjustable
    
    CTA button is circular and can be outlined button or solid button or link 
    style. color for desktop and mobile is adjustable. 
    
    On desktop, the background color is variable.
    
    On mobile, image/video 1 is the full bleed background and the text is overlaid on top. image 2 disappears., title and subtitle should be centered vertically within the frame. Left justified. , CTA outlined and solid should be square, no rounded corners
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-feature-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;background:{{ block.settings.background_color }};padding:{{ block.settings.section_padding }}px}
.ai-feature__grid-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;min-height:{{ block.settings.desktop_height }}px}
.ai-feature__copy-{{ ai_gen_id }}{display:grid;grid-template-rows:1fr auto;min-width:0;text-align:left}
.ai-feature__intro-{{ ai_gen_id }}{align-self:center;text-align:left}
.ai-feature__subtitle-{{ ai_gen_id }},.ai-feature__body-{{ ai_gen_id }}{font-family:'Circular Std','CircularXX',sans-serif;color:{{ block.settings.body_color }};font-weight:{{ block.settings.body_weight }}}
.ai-feature__subtitle-{{ ai_gen_id }}{font-size:{{ block.settings.subtitle_size }}px;margin:0 0 12px}
.ai-feature__title-{{ ai_gen_id }}{font-family:Canela,Georgia,serif;font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};line-height:1.05;margin:0;color:{{ block.settings.title_color_desktop }}}
.ai-feature__body-{{ ai_gen_id }}{font-size:{{ block.settings.body_size }}px;line-height:1.5;margin:0 0 22px}
.ai-feature__media-{{ ai_gen_id }}{position:relative;overflow:hidden;min-height:{{ block.settings.desktop_height }}px;background:#e9e6e3}
.ai-feature__media-{{ ai_gen_id }} img,.ai-feature__media-{{ ai_gen_id }} video{display:block;width:100%;height:100%;min-height:{{ block.settings.desktop_height }}px;object-fit:cover}
.ai-feature__placeholder-{{ ai_gen_id }}{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#e9e6e3}
.ai-feature__placeholder-{{ ai_gen_id }} svg{width:100%;height:100%;object-fit:cover}
.ai-feature__empty-{{ ai_gen_id }}{position:absolute;bottom:10px;left:10px;background:white;color:#222;padding:8px}
.ai-feature__cta-{{ ai_gen_id }}{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 22px;border:1px solid {{ block.settings.cta_color_desktop }};border-radius:0;color:{{ block.settings.cta_color_desktop }};font-family:'Circular Std','CircularXX',sans-serif;text-decoration:none}
.ai-feature__cta-{{ ai_gen_id }}:focus-visible{outline:2px solid currentColor;outline-offset:3px}
.ai-feature__cta-{{ ai_gen_id }}--solid{background:{{ block.settings.cta_color_desktop }};color:{{ block.settings.cta_solid_text }}}
.ai-feature__cta-{{ ai_gen_id }}--link{border:0;border-radius:0;padding:4px 0;text-decoration:underline}
@media(max-width:749px){.ai-feature-{{ ai_gen_id }}{position:relative;width:100%;min-height:{{ block.settings.mobile_height }}px;padding:{{ block.settings.mobile_padding }}px;background:#222;overflow:hidden}.ai-feature__grid-{{ ai_gen_id }}{display:block;position:relative;min-height:{{ block.settings.mobile_height }}px}.ai-feature__media-{{ ai_gen_id }}{display:none}.ai-feature__media--1-{{ ai_gen_id }}{display:block;position:absolute;inset:-{{ block.settings.mobile_padding }}px;min-height:0;z-index:0}.ai-feature__media--1-{{ ai_gen_id }} img,.ai-feature__media--1-{{ ai_gen_id }} video{height:100%;min-height:0}.ai-feature__media--1-{{ ai_gen_id }}:after{content:'';position:absolute;inset:0;background:{{ block.settings.mobile_overlay_color }};opacity:{{ block.settings.mobile_overlay_opacity | divided_by:100.0 }}}.ai-feature__copy-{{ ai_gen_id }}{position:relative;z-index:1;min-height:{{ block.settings.mobile_height }}px;grid-template-rows:1fr auto}.ai-feature__subtitle-{{ ai_gen_id }},.ai-feature__body-{{ ai_gen_id }}{color:{{ block.settings.body_color_mobile }}}.ai-feature__title-{{ ai_gen_id }}{color:{{ block.settings.title_color_mobile }}}.ai-feature__cta-{{ ai_gen_id }}{color:{{ block.settings.cta_color_mobile }};border-color:{{ block.settings.cta_color_mobile }}}.ai-feature__cta-{{ ai_gen_id }}--solid{background:{{ block.settings.cta_color_mobile }};color:{{ block.settings.cta_solid_text }}}}
{% endstyle %}
<div class="ai-feature-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-feature__grid-{{ ai_gen_id }}"><div class="ai-feature__copy-{{ ai_gen_id }}"><div class="ai-feature__intro-{{ ai_gen_id }}">{% if block.settings.subtitle != blank %}<p class="ai-feature__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle | escape }}</p>{% endif %}{% if block.settings.title != blank %}<h2 class="ai-feature__title-{{ ai_gen_id }}">{{ block.settings.title | escape }}</h2>{% endif %}</div><div>{% if block.settings.body != blank %}<div class="ai-feature__body-{{ ai_gen_id }}">{{ block.settings.body }}</div>{% endif %}{% if block.settings.cta_label != blank and block.settings.cta_link != blank %}<a class="ai-feature__cta-{{ ai_gen_id }}{% if block.settings.cta_style == 'solid' %} ai-feature__cta-{{ ai_gen_id }}--solid{% elsif block.settings.cta_style == 'link' %} ai-feature__cta-{{ ai_gen_id }}--link{% endif %}" href="{{ block.settings.cta_link }}">{{ block.settings.cta_label | escape }}</a>{% endif %}</div></div>{% for i in (1..2) %}{% assign image_key = 'image_' | append: i %}{% assign video_key = 'video_' | append: i %}{% assign image = block.settings[image_key] %}{% assign video = block.settings[video_key] %}<div class="ai-feature__media-{{ ai_gen_id }} ai-feature__media--{{ i }}-{{ ai_gen_id }}">{% if video != blank %}{{ video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}{% elsif image != blank %}<img src="{{ image | image_url: width: 1600 }}" alt="{{ image.alt | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy">{% else %}<div class="ai-feature__placeholder-{{ ai_gen_id }}">{{ 'image' | placeholder_svg_tag }}<p class="ai-feature__empty-{{ ai_gen_id }}">Add an image or video for media {{ i }}</p></div>{% endif %}</div>{% endfor %}</div></div>
{% schema %}{"name":"Editorial media feature","settings":[{"type":"header","content":"Content"},{"type":"text","id":"subtitle","label":"Subtitle"},{"type":"text","id":"title","label":"Title"},{"type":"richtext","id":"body","label":"Body copy","default":"<p>Tell your story here.</p>"},{"type":"text","id":"cta_label","label":"CTA label"},{"type":"url","id":"cta_link","label":"CTA link"},{"type":"select","id":"cta_style","label":"CTA style","options":[{"value":"outline","label":"Outlined"},{"value":"solid","label":"Solid"},{"value":"link","label":"Link"}],"default":"outline"},{"type":"image_picker","id":"image_1","label":"Image 1"},{"type":"video","id":"video_1","label":"Video 1"},{"type":"image_picker","id":"image_2","label":"Image 2"},{"type":"video","id":"video_2","label":"Video 2"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_height","label":"Desktop height","min":250,"max":800,"step":50,"unit":"px","default":500},{"type":"range","id":"mobile_height","label":"Mobile height","min":300,"max":800,"step":50,"unit":"px","default":550},{"type":"range","id":"section_padding","label":"Desktop padding","min":0,"max":60,"step":5,"unit":"px","default":20},{"type":"range","id":"mobile_padding","label":"Mobile padding","min":10,"max":60,"step":5,"unit":"px","default":25},{"type":"color","id":"background_color","label":"Desktop background","default":"#F4EFEA"},{"type":"color","id":"mobile_overlay_color","label":"Mobile image overlay","default":"#000000"},{"type":"range","id":"mobile_overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":10,"unit":"%","default":40},{"type":"range","id":"subtitle_size","label":"Subtitle size","min":10,"max":30,"step":1,"unit":"px","default":14},{"type":"select","id":"body_weight","label":"Body and subtitle weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"400"},{"type":"range","id":"title_size","label":"Title size","min":24,"max":80,"step":2,"unit":"px","default":48},{"type":"select","id":"title_weight","label":"Title weight","options":[{"value":"400","label":"Regular"},{"value":"500","label":"Medium"},{"value":"600","label":"Semibold"},{"value":"700","label":"Bold"}],"default":"400"},{"type":"range","id":"body_size","label":"Body size","min":12,"max":30,"step":1,"unit":"px","default":16},{"type":"color","id":"body_color","label":"Body and subtitle","default":"#1C1C1C"},{"type":"color","id":"body_color_mobile","label":"Body and subtitle on mobile","default":"#FFFFFF"},{"type":"color","id":"title_color_desktop","label":"Title on desktop","default":"#1C1C1C"},{"type":"color","id":"title_color_mobile","label":"Title on mobile","default":"#FFFFFF"},{"type":"color","id":"cta_color_desktop","label":"CTA on desktop","default":"#1C1C1C"},{"type":"color","id":"cta_color_mobile","label":"CTA on mobile","default":"#FFFFFF"},{"type":"color","id":"cta_solid_text","label":"Solid CTA text","default":"#FFFFFF"}],"presets":[{"name":"Editorial media feature"}],"tag":null,"class":"editorial-media-feature-block"}{% endschema %}