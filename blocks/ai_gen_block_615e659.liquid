{% doc %}
  @prompt
    Generate a block with a heading and a five column grid below. The grid is 50% of the width of desktop and centered within the module. Each module in the grid has a circular image, and two body text blocks below with adjustable padding between the elements.
    
    On mobile the 5 column grid scrolls horizontally while the title stays static. 
    
    The background for the entire module is a gradient., Allow font options for the two text blocks, On mobile, images should be 50% Width of the frame
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-circular-grid-module-{{ ai_gen_id }} {
    display: block;
    background: {{ block.settings.gradient_start }};
    background: linear-gradient(
      {{ block.settings.gradient_angle }}deg,
      {{ block.settings.gradient_start }} 0%,
      {{ block.settings.gradient_end }} 100%
    );
    padding: {{ block.settings.padding_top }}px 20px {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-circular-grid-container-{{ ai_gen_id }} {
    max-width: 1440px;
    margin: 0 auto;
  }

  .ai-circular-grid-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-circular-grid-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-circular-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-circular-grid-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .ai-circular-grid-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: {{ block.settings.image_text_spacing }}px;
  }

  .ai-circular-grid-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-circular-grid-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-circular-grid-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-circular-grid-text-1-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_1_font }}, sans-serif;
    font-size: {{ block.settings.text_1_size }}px;
    margin-bottom: {{ block.settings.text_spacing }}px;
  }

  .ai-circular-grid-text-2-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.text_2_font }}, sans-serif;
    font-size: {{ block.settings.text_2_size }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-circular-grid-wrapper-{{ ai_gen_id }} {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .ai-circular-grid-{{ ai_gen_id }} {
      width: max-content;
      min-width: 100%;
      grid-template-columns: repeat(5, 50%);
      padding-bottom: 10px;
    }

    .ai-circular-grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 6px;
    }

    .ai-circular-grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      border-radius: 3px;
    }

    .ai-circular-grid-wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background: rgba(0, 0, 0, 0.3);
      border-radius: 3px;
    }
  }
{% endstyle %}

<div class="ai-circular-grid-module-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-circular-grid-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-circular-grid-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-circular-grid-wrapper-{{ ai_gen_id }}">
      <div class="ai-circular-grid-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'item_' | append: i | append: '_image'
            assign text_1_key = 'item_' | append: i | append: '_text_1'
            assign text_2_key = 'item_' | append: i | append: '_text_2'
            assign image = block.settings[image_key]
            assign text_1 = block.settings[text_1_key]
            assign text_2 = block.settings[text_2_key]
          %}

          <div class="ai-circular-grid-item-{{ ai_gen_id }}">
            <div class="ai-circular-grid-image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 400 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="400"
                  height="400"
                  class="ai-circular-grid-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-circular-grid-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if text_1 != blank %}
              <div class="ai-circular-grid-text-1-{{ ai_gen_id }}">{{ text_1 }}</div>
            {% endif %}

            {% if text_2 != blank %}
              <div class="ai-circular-grid-text-2-{{ ai_gen_id }}">{{ text_2 }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

