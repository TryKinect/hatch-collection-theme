{% doc %}
  @prompt
    Create a module that is 4 columns on desktop. 2 columns on mobile. Each spot you should be able to select if it's product, image, or video. Make centered on desktop. Add the ability to add more modules, up to 8. Add customization for product title font. Add override image for product. 
    , all modules should be the same size, All modules should be portrait orientation
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-flex-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-flex-grid__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-flex-grid__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ai-flex-grid__item-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-flex-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-flex-grid__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .ai-flex-grid__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-flex-grid__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-flex-grid__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-flex-grid__product-info-{{ ai_gen_id }} {
    margin-top: {{ block.settings.product_info_spacing }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-flex-grid__product-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.product_title_font }};
    font-size: {{ block.settings.product_title_size }}px;
    margin: 0 0 8px;
    color: {{ block.settings.product_title_color }};
  }

  .ai-flex-grid__product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_price_size }}px;
    color: {{ block.settings.product_price_color }};
  }

  .ai-flex-grid__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    color: #999;
    text-align: center;
    pointer-events: none;
    padding: 0 10px;
  }
{% endstyle %}

<flex-grid-{{ ai_gen_id }} class="ai-flex-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-flex-grid__container-{{ ai_gen_id }}">
    {% for i in (1..8) %}
      {% liquid
        assign item_type_key = 'item_' | append: i | append: '_type'
        assign item_product_key = 'item_' | append: i | append: '_product'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_video_key = 'item_' | append: i | append: '_video'
        assign item_override_image_key = 'item_' | append: i | append: '_override_image'

        assign item_type = block.settings[item_type_key]
        assign item_product = block.settings[item_product_key]
        assign item_image = block.settings[item_image_key]
        assign item_video = block.settings[item_video_key]
        assign item_override_image = block.settings[item_override_image_key]
      %}

      {% if item_type != 'none' %}
        <div class="ai-flex-grid__item-{{ ai_gen_id }}">
          {% if item_type == 'product' %}
            {% if item_product != blank %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                {% if item_override_image != blank %}
                  <img
                    src="{{ item_override_image | image_url: width: 800 }}"
                    alt="{{ item_override_image.alt | escape }}"
                    loading="lazy"
                    width="{{ item_override_image.width }}"
                    height="{{ item_override_image.height }}"
                    class="ai-flex-grid__image-{{ ai_gen_id }}"
                  >
                {% elsif item_product.featured_image %}
                  <img
                    src="{{ item_product.featured_image | image_url: width: 800 }}"
                    alt="{{ item_product.featured_image.alt | escape }}"
                    loading="lazy"
                    width="{{ item_product.featured_image.width }}"
                    height="{{ item_product.featured_image.height }}"
                    class="ai-flex-grid__image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-flex-grid__image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              <div class="ai-flex-grid__product-info-{{ ai_gen_id }}">
                <h3 class="ai-flex-grid__product-title-{{ ai_gen_id }}">{{ item_product.title }}</h3>
                <div class="ai-flex-grid__product-price-{{ ai_gen_id }}">{{ item_product.price | money }}</div>
              </div>
            {% else %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-flex-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                  <div class="ai-flex-grid__empty-state-{{ ai_gen_id }}">
                    Select a product
                  </div>
                </div>
              </div>
            {% endif %}

          {% elsif item_type == 'image' %}
            {% if item_image != blank %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ item_image | image_url: width: 800 }}"
                  alt="{{ item_image.alt | escape }}"
                  loading="lazy"
                  width="{{ item_image.width }}"
                  height="{{ item_image.height }}"
                  class="ai-flex-grid__image-{{ ai_gen_id }}"
                >
              </div>
            {% else %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-flex-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-flex-grid__empty-state-{{ ai_gen_id }}">
                    Select an image
                  </div>
                </div>
              </div>
            {% endif %}

          {% elsif item_type == 'video' %}
            {% if item_video != blank %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                {{
                  item_video
                  | video_tag:
                    image_size: '800x',
                    autoplay: true,
                    loop: true,
                    muted: true,
                    controls: false,
                    class: 'ai-flex-grid__video-' | append: ai_gen_id
                }}
              </div>
            {% else %}
              <div class="ai-flex-grid__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-flex-grid__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                  <div class="ai-flex-grid__empty-state-{{ ai_gen_id }}">
                    Select a video
                  </div>
                </div>
              </div>
            {% endif %}
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</flex-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class FlexGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('flex-grid-{{ ai_gen_id }}', FlexGrid{{ ai_gen_id }});
  })();
</script>

