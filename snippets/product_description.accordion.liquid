{%- assign full_desctipyion = false -%}

{%- for tag in product.tags -%}
  {%- if tag == 'full_description' -%}
    {%- assign full_desctipyion = true -%}
  {%- endif -%}
{%- endfor -%}

{% if template contains 'product.gift-card' %}
  {% assign collapsed = true %}
{% endif %}

<ul class="product_description_accordion">
  {%- if template == 'product.beauty_pdp_v3' -%}
    {%- if product.metafields.custom.why_we_love_it != blank -%}
      <li>
        <a class="acc_toggle js-acc-toggle active" href="javascript:void(0);">Why We Love It</a>

        <div class="inner show">
          {{ product.metafields.custom.why_we_love_it }}
        </div>
      </li>
    {%- endif -%}

    {%- if product.metafields.custom.how_to_use_it != blank -%}
      <li>
        <a class="acc_toggle js-acc-toggle active" href="javascript:void(0);">How To Use It</a>

        <div class="inner show">
          {{ product.metafields.custom.how_to_use_it }}
        </div>
      </li>
    {%- endif -%}
  {%- else -%}
    <li open>
      <a class="toggle {% unless collapsed %}active{% endunless %}" href="javascript:void(0);">Description</a>
      <div class="inner {% unless collapsed %}show{% endunless %} js-accordion-desc" data-height="75" {% if collapsed %}style="display: none;"{% endif %}>
        <div class="inner-default {% if full_desctipyion %}inner-default--full{% endif %}">
          {{ product.description }}
        </div><!-- /.inner-default -->

        <div class="inner-actions">
          <a href="#" class="link-primary js-accordion-desc-link">
            <span>Read More +</span>

            <span>See Less -</span>
          </a>
        </div><!-- /.inner-actions -->
      </div>
    </li>

    <li>
      {% for tag in product.tags %}
        {% if tag contains 'size_chart:' %}
            {% assign current_tag = tag | replace: 'size_chart:', '' | strip | handle %}

            <a href="#modal-size-{{- current_tag -}}" class="toggle js-modal-alt">Size Chart</a>
        {% endif %}
      {% endfor %}
    </li>

    {% if product.metafields.custom.the_specifics %}
      {% assign toggle_title = 'Details' %}

      {% if product.template_suffix == 'beauty_pdp' %}
        {% assign toggle_title = 'Benefits' %}
      {% endif %}

      <li>
        <a class="toggle" href="javascript:void(0);">{{ toggle_title }}</a>
        <div class="inner" {% if collapsed %}style="display: none;"{% endif %}>
            {{ product.metafields.custom.the_specifics  }}
        </div>
      </li>
    {% endif %}

    {% if product.metafields.custom.fit_detail %}
      {% assign toggle_title = 'Measurements' %}

      {% if product.template_suffix == 'beauty_pdp' %}
        {% assign toggle_title = 'The Facts' %}
      {% endif %}

      <li>
        <a class="toggle" href="javascript:void(0);">{{ toggle_title }}</a>

        <div class="inner">
          {{ product.metafields.custom.fit_detail }}
        </div>
      </li>
    {% endif %}

    <li>
      <a class="link-scroll link-yotpo" href="#yotpo-holder">
        Reviews

        <div class="yotpo bottomLine"
            data-appkey="tVnLeF5tdgk3PYyWhDoPltJB4djmrpGspiVp6JSy"
            data-domain="{{shop.permanent_domain | escape }}"
            data-product-id="{{ product.id }}"
            data-product-models="{{ product.id }}"
            data-name="{{ product.title | escape }}"
            data-url="{{ shop.url }}{{ product.url }}"
            data-image-url="{{ product.featured_image | product_img_url: 'large' |replace: '?', '%3F' | replace: '&','%26'}}"
            data-description="{{ product.description | escape }}"
            data-bread-crumbs="{% for tag in product.tags %}{{ tag | escape }};{% endfor %}">
        </div>
      </a>
    </li>
  {%- endif -%}
</ul>

