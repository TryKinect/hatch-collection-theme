        <span class="modal-alt__close js-modal-close"></span>
        {%- render 'page-size-guide-content', page: pages['janie-size-guide'], modal: true -%}
      </div>
      <div class="modal-alt__background js-modal-close"></div>
    </div>
  {%- endif -%}
{%- endunless -%}
{% endunless %}

