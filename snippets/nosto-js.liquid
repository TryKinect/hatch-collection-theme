{% if request.page_type == "index" %}
<script>
document.addEventListener('DOMContentLoaded',function(){
  function initSlider(){
    var s=document.querySelector('#underbestsellers .slider-home-featured-products');
    if(s.classList.contains('slick-initialized'))return;
    s.querySelectorAll('img').forEach(function(img){
      var d=img.getAttribute('data-src');
      if(d)img.setAttribute('src',d);
    });
    $(s).slick({
      slidesToShow:5,
      slidesToScroll:1,
      infinite:true,
      dots:false,
      arrows:true,
      prevArrow:'<button type="button" class="slick-prev">❮</button>',
      nextArrow:'<button type="button" class="slick-next">❯</button>',
      responsive:[
        {breakpoint:1024,settings:{slidesToShow:4}},
        {breakpoint:768,settings:{slidesToShow:2}},
        {breakpoint:480,settings:{slidesToShow:1}}
      ]
    });
  }
    function destroySlider() {
    if (!slider) return;
    if (slider.classList.contains('slick-initialized')) {
      $(slider).slick('unslick');
    }
  }

  function checkWindowSize() {
    if (window.innerWidth <= 767) {
      destroySlider();
    } else {
      initSlider();
    }
  }
  var t=document.querySelector('.home-featured-products');
  if(t)new MutationObserver(function(m,o){
    if(document.querySelectorAll('#underbestsellers .slider-home-featured-products img').length){
      var s=document.querySelector('#underbestsellers .slider-home-featured-products');
    if(s.classList.contains('slick-initialized'))return;
    s.querySelectorAll('img').forEach(function(img){
      var d=img.getAttribute('data-src');
      if(d)img.setAttribute('src',d);
    });
      checkWindowSize();
      o.disconnect();
    }
  }).observe(t,{childList:true,subtree:true});
  checkWindowSize();
});
</script>
{% endif %}
