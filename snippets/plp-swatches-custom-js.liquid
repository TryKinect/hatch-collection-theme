{% if collection or request.page_type == 'search' %}
  <!--
    ======================
         Product Images JSON
    =======================
  -->
  <style>
  /* Safari only */
/* Safari only */
@supports (-webkit-hyphens: none) {
  .product-card__media video.product-card__image {
    width: 100% !important;
    height: auto !important;        /* match <img> scaling */
    aspect-ratio: 1440 / 2000;      /* same as your image */
    object-fit: cover !important;
    display: block;
  }
}

  </style>
  <script>
    window.productImages = {
      {% paginate collection.products by 1000 %}
      {% for product in collection.products %}
        {% assign all_unavailable = true %}

        {% for variant in product.variants %}
          {% if variant.available %}
            {% assign all_unavailable = false %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% comment %} Extract PDPTAG suffixes {% endcomment %}
        {% assign pdptag1 = null %}
        {% assign pdptag2 = null %}
        {% assign pdptag4 = null %}
        {% assign plpcomingsoon = null %}
        {% assign hideuk-PDPTAG1 = null %}
        {% assign hideuk-PDPTAG2 = null %}
        {% assign hideuk-PDPTAG4 = null %}
        {% for tag in product.tags %}
          {% if tag contains 'PDPTAG1-' and pdptag1 == null %}
            {% assign pdptag1 = tag | remove: 'PDPTAG1-' %}
          {% endif %}
          {% if tag contains 'PDPTAG2-' and pdptag2 == null %}
            {% assign pdptag2 = tag | remove: 'PDPTAG2-' %}
          {% endif %}
          {% if tag contains 'PDPTAG4-' and pdptag4 == null %}
            {% assign pdptag4 = tag | remove: 'PDPTAG4-' %}
          {% endif %}
          {% if tag == 'plp-coming-soon' and plpcomingsoon == null %}
            {% assign plpcomingsoon = tag %}
          {% endif %}
          {% if tag == 'hideuk-PDPTAG1' and hideuk-PDPTAG1 == null %}
            {% assign hideuk-PDPTAG1 = tag %}
          {% endif %}
          {% if tag == 'hideuk-PDPTAG2' and hideuk-PDPTAG2 == null %}
            {% assign hideuk-PDPTAG2 = tag %}
          {% endif %}
          {% if tag == 'hideuk-PDPTAG4' and hideuk-PDPTAG4 == null %}
            {% assign hideuk-PDPTAG4 = tag %}
          {% endif %}
        {% endfor %}

        {% assign first_media = product.media.first %}
        {% assign second_media = product.media[1] %}

        "{{ product.id }}": {
          "handle": "{{ product.handle }}",
          "featured": {
            "type": "{{ first_media.media_type }}",
            {% if first_media.media_type == 'image' %}
              "src": "{{ first_media | img_url: '800x' }}",
              "poster": null,
              "video": null
            {% elsif first_media.media_type == 'video' %}
              "src": null,
              "poster": null,
              "video": {
                "poster": "{% if first_media.preview_image %}{{ first_media.preview_image | img_url: '800x' }}{% else %}null{% endif %}",
                "duration": {{ first_media.duration | default: 0 }},
                "sources": [
                  {% for s in first_media.sources %}
                    {
                      "format": "{{ s.format }}",
                      "mime_type": "{{ s.mime_type }}",
                      "width": {{ s.width }},
                      "height": {{ s.height }},
                      "url": "{{ s.url }}"
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            {% else %}
              "src": null,
              "poster": null,
              "video": null
            {% endif %}
          },
          "second": {
            {% assign second_media = product.media[1] %}
            {% if second_media %}
              "type": "{{ second_media.media_type }}",
              {% if second_media.media_type == 'image' %}
                "src": "{{ second_media | img_url: '800x' }}",
                "poster": null,
                "video": null
              {% elsif second_media.media_type == 'video' %}
                "src": null,
                "poster": null,
                "video": {
                  "poster": "{% if second_media.preview_image %}{{ second_media.preview_image | img_url: '800x' }}{% else %}null{% endif %}",
                  "duration": {{ second_media.duration | default: 0 }},
                  "sources": [
                    {% for s in second_media.sources %}
                      {
                        "format": "{{ s.format }}",
                        "mime_type": "{{ s.mime_type }}",
                        "width": {{ s.width }},
                        "height": {{ s.height }},
                        "url": "{{ s.url }}"
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                }
              {% else %}
                "src": null,
                "poster": null,
                "video": null
              {% endif %}
            {% else %}
              "type": null,
              "src": null,
              "poster": null,
              "video": null
            {% endif %}
          },
          "price": "{{ product.price | money }}",
          "compare_at_price": {% if product.compare_at_price > product.price %}"{{ product.compare_at_price | money }}"{% else %}null{% endif %},
          "tags": {
            "PDPTAG1": {% if pdptag1 %}"{{ pdptag1 }}"{% else %}null{% endif %},
            "PDPTAG2": {% if pdptag2 %}"{{ pdptag2 }}"{% else %}null{% endif %},
            "PDPTAG4": {% if pdptag4 %}"{{ pdptag4 }}"{% else %}null{% endif %},
            "plpcomingsoon": {% if plpcomingsoon %}"{{ plpcomingsoon }}"{% else %}null{% endif %},
            "hideukPDPTAG1": {% if hideuk-PDPTAG1 and localization.country.iso_code == 'GB' %}"{{ hideuk-PDPTAG1 }}"{% else %}null{% endif %},
            "hideukPDPTAG2": {% if hideuk-PDPTAG2 and localization.country.iso_code == 'GB' %}"{{ hideuk-PDPTAG2 }}"{% else %}null{% endif %},
            "hideukPDPTAG4": {% if hideuk-PDPTAG4 and localization.country.iso_code == 'GB' %}"{{ hideuk-PDPTAG4 }}"{% else %}null{% endif %}
          },
          "all_unavailable" : {{ all_unavailable }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
      {% endpaginate %}
    };
  </script>

  <!--
    ======================
         Handle Missing Products
    =======================
  -->
  <script>
    const shopCurrency = {% if localization.country.iso_code == 'GB' %}
        'GBP'
      {% else %}
        '{{ shop.currency }}'
      {% endif %};

    const formatMoney = (cents) => {
      if (cents == null) return null;

      return new Intl.NumberFormat(
        shopCurrency === 'GBP' ? 'en-GB' : 'en-US',
        {
          style: 'currency',
          currency: shopCurrency
        }
      ).format(cents / 100);
    };

    // Track processed products
    window.productProcessed = window.productProcessed || new Set();
    window.productImages = window.productImages || {};
    window.fetchingHandles = window.fetchingHandles || new Set();

    function addProductToImages(product) {
      if (!product || !product.id) return;

      // Skip if product already processed
      if (window.productProcessed.has(product.id)) return;
      window.productProcessed.add(product.id);

      // Extract tag suffix by prefix
      const getTagSuffix = (tags, prefix) => {
        if (!Array.isArray(tags)) return '';
        for (let tag of tags) {
          const t = tag.trim();
          if (t.toUpperCase().startsWith(prefix.toUpperCase())) {
            return t.slice(prefix.length);
          }
        }
        return '';
      };

      // Pick highest resolution video source
      const getMaxResolutionVideo = (video) => {
        if (!video || !Array.isArray(video.sources)) return '';
        const sorted = [...video.sources].sort((a, b) => (b.width || 0) - (a.width || 0));
        return sorted.length > 0 ? sorted[0].url : '';
      };

      // Helper to extract media item from product.media or product.images or product.featured_image
      const getMediaItem = (prod, index) => {
        if (Array.isArray(prod.media) && prod.media[index]) {
          return prod.media[index];
        }
        if (Array.isArray(prod.images) && prod.images[index]) {
          return prod.images[index];
        }
        if (index === 0 && prod.featured_image) {
          return prod.featured_image;
        }
        return null;
      };

      // Normalize media (image/video/string URL)
      const mapMedia = (media) => {
        if (!media) return null;

        if (typeof media === 'string') {
          return {
            type: 'image',
            src: media.startsWith('//') ? 'https:' + media : media,
            poster: null,
            video: null,
            video_url: null,
          };
        }

        if (media.media_type === 'image') {
          return {
            type: 'image',
            src: media.src || '',
            poster: null,
            video: null,
            video_url: null,
          };
        }

        if (media.media_type === 'video') {
          return {
            type: 'video',
            src: null,
            poster: null, // keep poster only inside video
            video: {
              poster: media.preview_image ? media.preview_image.src : null,
              duration: media.duration || 0,
              sources: media.sources || [],
            },
            video_url: getMaxResolutionVideo(media),
          };
        }

        return null;
      };

      const all_unavailable = Array.isArray(product.variants)
        ? product.variants.every(v => v && v.available === false)
        : false;

      // Save product object
      window.productImages[product.id] = {
        handle: product.handle,
        featured: mapMedia(getMediaItem(product, 0)),
        second: mapMedia(getMediaItem(product, 1)),
        price: formatMoney(product.price),
        compare_at_price: product.compare_at_price > product.price ? formatMoney(product.compare_at_price) : null,
        tags: {
          PDPTAG1: getTagSuffix(product.tags, 'PDPTAG1-'),
          PDPTAG2: getTagSuffix(product.tags, 'PDPTAG2-'),
          PDPTAG4: getTagSuffix(product.tags, 'PDPTAG4-'),
          plpcomingsoon: product.tags && product.tags.includes('plp-coming-soon') ? 'plp-coming-soon' : null,
          hideukPDPTAG1: {% if localization.country.iso_code == 'GB' %}product.tags && product.tags.includes('hideuk-PDPTAG1') ? 'hideuk-PDPTAG1' : null{% else %}null{% endif %},
          hideukPDPTAG2: {% if localization.country.iso_code == 'GB' %}product.tags && product.tags.includes('hideuk-PDPTAG2') ? 'hideuk-PDPTAG2' : null{% else %}null{% endif %},
          hideukPDPTAG4: {% if localization.country.iso_code == 'GB' %}product.tags && product.tags.includes('hideuk-PDPTAG4') ? 'hideuk-PDPTAG4' : null{% else %}null{% endif %}
        },
        all_unavailable: all_unavailable
      };

      console.log('[PLP-SWATCHES] Added product once:', product.handle, window.productImages[product.id]);
    }

    function processHandles() {
      const elements = document.querySelectorAll(
        'king-linked-options-collection [data-handle], king-linked-options-collection .lv-option-collection-wrapper [data-handle]'
      );

      const handles = Array.from(elements)
        .map((el) => el.dataset.handle)
        .filter(Boolean);

      const uniqueHandles = [...new Set(handles)];
      const existingHandles = Object.values(window.productImages || {}).map((p) => p.handle);
      const missingHandles = uniqueHandles.filter((h) => !existingHandles.includes(h));

      if (missingHandles.length) {
        console.log('[PLP-SWATCHES] Missing handles to fetch:', missingHandles);
        missingHandles.forEach((handle) => {
          if (window.fetchingHandles.has(handle)) return;
          window.fetchingHandles.add(handle);

          const element = Array.from(elements).find(el => el.dataset.handle === handle);
          console.log('[PLP-SWATCHES] Fetching product handle:', handle);

          fetch(`/products/${handle}.js`)
            .then(res => res.text())
            .then(text => {
              let data;
              try {
                data = JSON.parse(text);
              } catch (err) {
                console.warn(`[PLP-SWATCHES] Invalid JSON for product ${handle}`, err);
                window.fetchingHandles.delete(handle);
                throw err;
              }
              window.fetchingHandles.delete(handle);
              console.log('[PLP-SWATCHES] Successfully fetched product data for handle:', handle, data);
              addProductToImages(data);
              preloadAllProductImages();
            })
            .catch((err) => {
              console.error('[PLP-SWATCHES] Error fetching product', handle, err);
              window.fetchingHandles.delete(handle);
              if (element) {
                element.style.display = 'none';
              }
            });
        });
      }
    }

    // Set to track preloaded image URLs
    window.preloadedImages = window.preloadedImages || new Set();

    function preloadAllProductImages() {
      if (!window.productImages) return;

      Object.values(window.productImages).forEach(product => {
        ['featured', 'second'].forEach(key => {
          const media = product[key];
          if (media?.type === 'image' && media.src && !window.preloadedImages.has(media.src)) {
            const img = new Image();
            img.onload = () => {
              console.log(`[PLP-SWATCHES] Preloaded ${key} image for ${product.handle}`);
            };
            img.src = media.src;
            window.preloadedImages.add(media.src);
          }
        });
      });
    }

    // Call this after window.productImages is fully populated
    preloadAllProductImages();

    const observer = new MutationObserver(processHandles);
    observer.observe(document.body, { childList: true, subtree: true });
    processHandles(); // Run immediately
  </script>

