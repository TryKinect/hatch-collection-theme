    <script>
document.addEventListener('DOMContentLoaded', function() {
    window.initializeSliderScrollbars = function() {
        const scrollContainers = document.querySelectorAll('.mobile-image-custom > a');
        // Remove existing fake scrollbars first
        document.querySelectorAll('.fake-scrollbar').forEach(scrollbar => {
            scrollbar.remove();
        });
        scrollContainers.forEach(scrollContainer => {
            const parent = scrollContainer.parentElement;
            const deferredDataEl = parent.querySelector('.deferred-slider-data');
            let totalSlides = scrollContainer.querySelectorAll('.product-gallery__media').length;
            if (deferredDataEl) {
                try {
                    const deferredData = JSON.parse(deferredDataEl.textContent);
                    totalSlides = deferredData.total_slides || totalSlides;
                } catch(e) {}
            }
            const fakeScrollbar = document.createElement('div');
            fakeScrollbar.className = 'fake-scrollbar';
            const thumb = document.createElement('div');
            thumb.className = 'fake-scrollbar-thumb';

            fakeScrollbar.appendChild(thumb);
            parent.appendChild(fakeScrollbar);

            let slidesLoaded = false;

            function loadDeferredSlides() {

                if (slidesLoaded || !deferredDataEl) return;

                try {
                    const deferredData = JSON.parse(deferredDataEl.textContent);

                    if (deferredData.slides) {
                        scrollContainer.insertAdjacentHTML('beforeend', deferredData.slides);
                        slidesLoaded = true;

                        // update scrollbar after images appended
                        setTimeout(updateThumb, 100);
                    }

                } catch(e) {
                    console.log('Deferred slides parse error', e);
                }
            }
            function updateThumb() {
                // Use total slide count instead of current DOM count
                const visibleSlides = 1;
                const visibleRatio = visibleSlides / totalSlides;
                const thumbWidth = visibleRatio * scrollContainer.clientWidth;

                thumb.style.width = `${thumbWidth}px`;

                const maxScrollLeft = scrollContainer.scrollWidth - scrollContainer.clientWidth;

                const scrollRatio = maxScrollLeft > 0
                    ? scrollContainer.scrollLeft / maxScrollLeft
                    : 0;

                thumb.style.left = `${scrollRatio * (scrollContainer.clientWidth - thumbWidth)}px`;
            }
            scrollContainer.removeEventListener('scroll', updateThumb);
            window.removeEventListener('resize', updateThumb);
            scrollContainer.addEventListener('scroll', function() {
                // Load remaining slides on first swipe
                if (!slidesLoaded && scrollContainer.scrollLeft > 10) {
                    loadDeferredSlides();
                }
                updateThumb();
            });
            window.addEventListener('resize', updateThumb);
            updateThumb();
        });
    }
    // Initialize slider scrollbars on page load
    initializeSliderScrollbars();
});
document.addEventListener("facet:update", function () {
    setTimeout(() => {
        if (typeof window.initializeSliderScrollbars === "function") {
            window.initializeSliderScrollbars();
        }
    },5000);

});
</script>

    
