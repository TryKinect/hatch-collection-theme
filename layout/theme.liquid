      (function () {

  // Run only on PLP + Mobile
  function isPLP() {
    return window.location.pathname.includes('/collections/');
  }

  function isMobile() {
    return window.innerWidth <= 768;
  }

  if (!isPLP() || !isMobile()) return;

  // =========================
  // 1. QUICK VIEW TRACKING
  // =========================
  document.addEventListener('click', function (e) {

    let btn = e.target.closest('.product-card__quick-add-button');

    if (!btn) return;

    let productCard = btn.closest('[class*="product"]');

    let productLink = productCard?.querySelector('a[href*="/products/"]')?.getAttribute('href') || '';
    let productTitle = productCard?.querySelector('.product-title, .card__heading')?.innerText?.trim() || '';

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'quick_view_click',
      page_type: 'PLP',
      device: 'mobile',
      product_url: productLink,
      product_name: productTitle
    });

  });

  // =========================
  // 2. IMAGE SWIPE TRACKING
  // =========================
document.querySelectorAll('.mobile-image-custom').forEach(function (container) {

  let scrollEl = container;

  // try to detect actual scrollable element
  let inner = container.querySelector('[class*="gallery"], [class*="media"]');
  if (inner) scrollEl = inner;

  let lastScroll = 0;
  let timeout;
  let startX = 0;
  let isSwiping = false;

  // TOUCH START
  scrollEl.addEventListener('touchstart', function (e) {
    startX = e.touches[0].clientX;
    isSwiping = true;
  });

  // TOUCH MOVE (MAIN SWIPE DETECTION)
  scrollEl.addEventListener('touchmove', function (e) {

    if (!isSwiping) return;

    let moveX = e.touches[0].clientX;

    if (Math.abs(moveX - startX) > 30) {

      let productCard = container.closest('[class*="product"]');

      let productLink = productCard?.querySelector('a[href*="/products/"]')?.getAttribute('href') || '';
      let productTitle = productCard?.querySelector('.product-title, .card__heading')?.innerText?.trim() || '';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'product_image_swipe',
        page_type: 'PLP',
        device: 'mobile',
        product_url: productLink,
        product_name: productTitle
      });

      isSwiping = false; // prevent multiple firing
    }

  });

  // RESET
  scrollEl.addEventListener('touchend', function () {
    isSwiping = false;
  });

  // FALLBACK (SCROLL - KEEP YOUR LOGIC)
  scrollEl.addEventListener('scroll', function () {

    clearTimeout(timeout);

    timeout = setTimeout(function () {

      let currentScroll = scrollEl.scrollLeft;

      if (Math.abs(currentScroll - lastScroll) < 40) return;

      lastScroll = currentScroll;

      let productCard = container.closest('[class*="product"]');

      let productLink = productCard?.querySelector('a[href*="/products/"]')?.getAttribute('href') || '';
      let productTitle = productCard?.querySelector('.product-title, .card__heading')?.innerText?.trim() || '';

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'product_image_swipe',
        page_type: 'PLP',
        device: 'mobile',
        product_url: productLink,
        product_name: productTitle,
        scroll_position: currentScroll
      });

    }, 150);

  });

});

})();
