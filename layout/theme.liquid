<script>
(function () {
  function removeElementsOnMobile() {
    if (window.matchMedia('(max-width: 767px)').matches) {
      const collections = document.querySelectorAll('.collection');

      collections.forEach((collection) => {
        // Remove quick-buy-modal
        const quickBuyModals = collection.querySelectorAll('quick-buy-modal');
        quickBuyModals.forEach((el) => el.remove());

        // Remove .product-card__quick-add-button
        const quickAddButtons = collection.querySelectorAll('.product-card__quick-add-button');
        quickAddButtons.forEach((el) => el.remove());
      });
    }
  }

  document.addEventListener('DOMContentLoaded', removeElementsOnMobile);
  window.addEventListener('resize', removeElementsOnMobile);
})();
document.addEventListener('DOMContentLoaded', function () {
document.querySelectorAll('.mobile-image-custom').forEach(card => {
  let initialized = false;

  card.addEventListener('touchstart', function () {
    if (initialized) return;

    const slides = card.querySelectorAll('.product-gallery__media');

    slides.forEach((slide, index) => {
      if (slide.dataset.loaded === "false") {
        const placeholder = slide.querySelector('.lazy-placeholder');

        if (placeholder) {
          const realMediaHTML = placeholder.outerHTML
            .replace('preview_image', ''); // optional cleanup

          // Replace with actual media render (simplified)
          placeholder.insertAdjacentHTML('afterend', `
            <img src="${placeholder.src}" loading="lazy" />
          `);

          placeholder.remove();
          slide.dataset.loaded = "true";
        }
      }
    });

    initialized = true;
  });
});
});

</script>
{% endif %}


