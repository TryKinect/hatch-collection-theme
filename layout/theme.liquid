     <script defer>
(function observeAccessWidget() {
  const widgetSelector = 'access-widget-ui.notranslate';
  const buttonSelector = 'button[part="acsb-trigger"]';
  const trapSelector = '.widget-container__trap';

  function handleTriggerButton(button) {
    button.style.left = "20px";
    button.style.right = "auto";
    button.style.bottom = "37px";
  }

  function handleTrapElement(trap) {
    trap.style.setProperty("display", "flex", "important");
    trap.style.setProperty("justify-content", "flex-start", "important");
    trap.style.setProperty("align-items", "center", "important");
  }

  function observeShadow(shadowRoot) {
    const shadowObserver = new MutationObserver(() => {
      const button = shadowRoot.querySelector(buttonSelector);
      if (button) handleTriggerButton(button);

      const trap = shadowRoot.querySelector(trapSelector);
      if (trap) handleTrapElement(trap);
    });

    shadowObserver.observe(shadowRoot, { childList: true, subtree: true });

    const existingButton = shadowRoot.querySelector(buttonSelector);
    if (existingButton) handleTriggerButton(existingButton);

    const existingTrap = shadowRoot.querySelector(trapSelector);
    if (existingTrap) handleTrapElement(existingTrap);
  }

  const rootObserver = new MutationObserver(() => {
    const widget = document.querySelector(widgetSelector);
    if (widget && widget.shadowRoot) {
      observeShadow(widget.shadowRoot);
    }
  });

  rootObserver.observe(document.documentElement, { childList: true, subtree: true });

  const existingWidget = document.querySelector(widgetSelector);
  if (existingWidget && existingWidget.shadowRoot) {
    observeShadow(existingWidget.shadowRoot);
  }
})();






(function observeAndStyleWidgetTraps() {
  let domObserver;

  const applyFlexStart = (trap) => {
    const marginLeftValue = window.innerWidth <= 768 ? '0px' : '20px';
    trap.style.setProperty('justify-content', 'flex-start', 'important');
    trap.style.setProperty('margin-left', marginLeftValue, 'important');

    const shadowRoot = trap.getRootNode();
    if (shadowRoot && shadowRoot instanceof ShadowRoot) {
      let styleEl = shadowRoot.getElementById('widget-trap-flexfix');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'widget-trap-flexfix';
        styleEl.textContent = `
          .widget-container__trap {
            justify-content: flex-start !important;
            margin-left: 20px !important;
          }
          .widget-container__main .main:after {
          background-color: #000 !important;
        }

