            fill: currentcolor;
        }
          @media (max-width: 768px) {
            .widget-container__trap {
              margin-left: 0 !important;
            }
          }
        `;
        shadowRoot.appendChild(styleEl);
      }
    }
  };

  const checkAll = () => {
    const widgets = document.querySelectorAll('access-widget-ui.notranslate, .access-widget-ui.notranslate');
    widgets.forEach((widget) => {
      const root = widget.shadowRoot;
      if (!root) return;
      const trap = root.querySelector('.widget-container__trap');
      if (trap) applyFlexStart(trap);
    });
  };

  checkAll();

  domObserver = new MutationObserver(checkAll);
  domObserver.observe(document.body, { childList: true, subtree: true });

  const intervalId = setInterval(checkAll, 1000);

  window.disconnectObserver = () => {
    domObserver.disconnect();
    clearInterval(intervalId);
  };
})();




