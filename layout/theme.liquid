      var captureNavLink = function(url) {
        var currentLink;
        if (url.includes('blog')) {
          currentLink = 'blog';
        } else if (url.includes('http') || url.includes('www')) {
          currentLink = url.toString().match(/\/\/[^\/]+\/([^\.]+)/)[1];
          currentLink.split('/');
          currentLink = currentLink.join(' | ');
        } else {
          currentLink = url.split('/');
          currentLink.shift();
          currentLink = currentLink.join(' | ');
        }
        if (ga) {
          ga('send', 'event', 'Navigation', 'click', currentLink, {
            'transport': 'beacon',
            'hitCallback': function(){document.location = url;}
          });
        }
      }
    </script>

