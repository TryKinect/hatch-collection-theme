        function showColorSwatches(button) {
          const isMobile = window.matchMedia("(max-width: 767px)").matches;
        
          if (isMobile) return; // Allow default <a> behavior
        
          event.preventDefault(); // Prevent redirect on desktop
        
          const wrapper = button.closest(".color-swatches-plp");
          if (!wrapper) return;
        
          const kingBlock = wrapper.querySelector("king-linked-options-collection");
          const swatch = wrapper.querySelector(".color-swatch");
        
          if (kingBlock && kingBlock.style.display === "none") {
            const listcolor = kingBlock?.querySelectorAll(".lv-option-collection-wrapper");
            listcolor?.forEach(list => {
              const swatch = list.querySelector(".lv-option-collection-color-swatch");
              if (!swatch) return;

              const pid = swatch.getAttribute("data-pid");
              if (!pid) return;

              if (window.productImages?.[pid]?.all_unavailable === true) {
                swatch.classList.add("lv-option-item-unavailable");
              }
            });
            kingBlock.style.display = "block";
            button.style.display = "none";
          } else if (swatch && swatch.style.display === "none") {
            swatch.style.display = "block";
            button.style.display = "none";
          }
        }
