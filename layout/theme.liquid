  <script>
    document.addEventListener('click', function (e) {
    let btn = e.target.closest(
      '.custom-sticky-atc__button, .custom-sticky-atc__mobile-button'
    );
    if (!btn) return;
    let stickyBar = btn.closest('product-sticky-bar.custom-sticky-atc');
    if (!stickyBar) return;

    let productTitle = stickyBar.querySelector(
      '.custom-sticky-atc__title'
    )?.innerText?.trim() || '';
    let variantTitle = stickyBar.querySelector(
      '.custom-sticky-atc__variant'
    )?.innerText?.trim() || '';
    let productPrice = stickyBar.querySelector(
      '.custom-sticky-atc__price'
    )?.innerText?.trim() || '';
    let device = btn.matches('.custom-sticky-atc__mobile-button')
      ? 'mobile'
      : 'desktop';

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'beauty_sticky_add_to_cart_click',
      page_type: 'PDP',
      template: 'beauty_pdp',
      device: device,
      product_name: productTitle,
      variant_name: variantTitle,
      product_price: productPrice,
      product_url: window.location.pathname
    });
  });
  </script>
